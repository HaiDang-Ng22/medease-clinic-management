@model List<Doctor>
@{
    ViewData["Title"] = "Đội Ngũ Bác Sĩ";
    var specialties = ViewBag.Specialties as List<Specialty> ?? new List<Specialty>();
    int? selectedSpecialtyId = ViewBag.SelectedSpecialtyId;
    string? searchTerm = ViewBag.SearchTerm;
}

<div class="bg-primary text-white py-5">
    <div class="container text-center">
        <h1 class="fw-bold">Đội Ngũ Bác Sĩ Chuyên Khoa</h1>
        <p class="lead text-white-50 mx-auto" style="max-width: 600px;">
            Đội ngũ chuyên gia giàu y đức, nhiều năm kinh nghiệm, luôn tận tâm đồng hành cùng sức khỏe của người bệnh.
        </p>
    </div>
</div>

<div class="container py-5">
    <!-- Filter Bar -->
    <div class="card card-custom p-4 mb-5">
        <form method="get" asp-action="Doctors" class="row g-3 align-items-center">
            <div class="col-md-5">
                <label class="form-label fw-semibold text-muted small">Tìm kiếm bác sĩ hoặc chuyên môn:</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Nhập tên bác sĩ..." value="@searchTerm" />
                </div>
            </div>
            <div class="col-md-5">
                <label class="form-label fw-semibold text-muted small">Lọc theo chuyên khoa:</label>
                <select name="specialtyId" class="form-select">
                    <option value="">-- Tất cả chuyên khoa --</option>
                    @foreach (var s in specialties)
                    {
                        <option value="@s.Id" selected="@(selectedSpecialtyId == s.Id)">@s.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100 rounded-pill py-2">
                    <i class="fa-solid fa-filter me-1"></i> Lọc
                </button>
            </div>
        </form>
    </div>

    <!-- Doctors Grid -->
    <div class="row g-4">
        @if (Model.Any())
        {
            foreach (var doc in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card card-custom h-100">
                        <div class="position-relative" style="height: 250px;">
                            <img src="@(doc.User?.AvatarUrl ?? "https://images.unsplash.com/photo-1622253692010-333f2da6031d?w=400&auto=format&fit=crop&q=80")" 
                                 alt="@doc.User?.FullName" class="w-100 h-100 object-fit-cover" />
                            <div class="position-absolute top-0 end-0 m-3">
                                <span class="badge bg-warning text-dark fw-bold px-2 py-1 shadow-sm">
                                    <i class="fa-solid fa-star me-1"></i>@doc.Rating.ToString("0.0")
                                </span>
                            </div>
                        </div>
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <span class="badge bg-primary-subtle text-primary mb-2">@doc.Specialty?.Name</span>
                                <h4 class="fw-bold mb-1">@doc.User?.FullName</h4>
                                <div class="text-muted small mb-2">@doc.Title</div>
                                <p class="text-muted small mb-3 text-truncate-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    @doc.Bio
                                </p>
                            </div>

                            <div class="pt-3 border-top">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="small text-muted"><i class="fa-solid fa-door-open me-1"></i>@doc.RoomNumber</span>
                                    <span class="fw-bold text-primary">@doc.ConsultationFee.ToString("N0") đ</span>
                                </div>
                                <div class="d-flex gap-2">
                                    <a asp-action="DoctorDetail" asp-route-id="@doc.Id" class="btn btn-outline-secondary rounded-pill flex-grow-1 btn-sm py-2">
                                        Xem chi tiết
                                    </a>
                                    <a asp-controller="Appointment" asp-action="Book" asp-route-doctorId="@doc.Id" class="btn btn-primary rounded-pill flex-grow-1 btn-sm py-2">
                                        Đặt lịch
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="fa-solid fa-user-slash text-muted display-4 mb-3"></i>
                <h4 class="text-muted">Không tìm thấy bác sĩ phù hợp với tiêu chí lọc</h4>
                <a asp-action="Doctors" class="btn btn-outline-primary rounded-pill mt-3">Xem lại tất cả bác sĩ</a>
            </div>
        }
    </div>
</div>
