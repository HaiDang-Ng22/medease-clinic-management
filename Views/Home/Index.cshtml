@{
    ViewData["Title"] = "Trang Chủ - Hệ Thống Phòng Khám Tư Nhân Healthy System";
    var specialties = ViewBag.Specialties as List<Specialty> ?? new List<Specialty>();
    var doctors = ViewBag.Doctors as List<Doctor> ?? new List<Doctor>();
    var services = ViewBag.Services as List<Service> ?? new List<Service>();
    var equipments = ViewBag.Equipments as List<Equipment> ?? new List<Equipment>();
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="badge bg-light text-primary px-3 py-2 rounded-pill fw-bold mb-3">
                    <i class="fa-solid fa-heart-pulse me-1 text-danger"></i> Hệ Thống Phòng Khám Tư Nhân Tiên Tiến
                </span>
                <h1 class="display-4 fw-extrabold mb-4" style="line-height: 1.2;">
                    Chăm Sóc Sức Khỏe Toàn Diện <br>
                    <span style="color: #fef08a;">Tận Tâm Bằng Cả Trái Tim</span>
                </h1>
                <p class="lead mb-4 text-white-50" style="font-size: 1.15rem;">
                    Healthy System mang đến trải nghiệm khám chữa bệnh hiện đại: Đặt lịch trực tuyến không chờ đợi, đội ngũ bác sĩ chuyên khoa đầu ngành và hệ thống chẩn đoán kỹ thuật số chuẩn xác.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Appointment" asp-action="Book" class="btn btn-warning btn-lg rounded-pill px-4 py-3 fw-bold text-dark shadow">
                        <i class="fa-solid fa-calendar-check me-2"></i>ĐẶT LỊCH KHÁM NGAY
                    </a>
                    <a asp-controller="Home" asp-action="Doctors" class="btn btn-outline-light btn-lg rounded-pill px-4 py-3 fw-bold">
                        <i class="fa-solid fa-user-doctor me-2"></i>Xem Đội Ngũ Bác Sĩ
                    </a>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block">
                <div class="position-relative">
                    <img src="https://images.unsplash.com/photo-1622253692010-333f2da6031d?w=600&auto=format&fit=crop&q=80" 
                         alt="Bác sĩ Healthy System" class="img-fluid rounded-4 shadow-lg border border-4 border-white" />
                    <div class="position-absolute bottom-0 start-0 translate-middle-y bg-white p-3 rounded-4 shadow-lg text-dark ms-n3" style="max-width: 240px;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-success text-white p-2 rounded-circle">
                                <i class="fa-solid fa-check fs-5"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold">100% Bác sĩ</h6>
                                <small class="text-muted">Chuyên khoa & Thạc sĩ, Tiến sĩ</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Stats Bar -->
<section class="py-4 bg-white border-bottom shadow-sm">
    <div class="container">
        <div class="row text-center g-4">
            <div class="col-6 col-md-3">
                <div class="p-3">
                    <div class="display-6 fw-bold text-primary mb-1">@ViewBag.DoctorCount+</div>
                    <div class="text-muted fw-semibold">Bác sĩ chuyên khoa</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3">
                    <div class="display-6 fw-bold text-secondary mb-1">@ViewBag.SpecialtyCount</div>
                    <div class="text-muted fw-semibold">Chuyên khoa điều trị</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3">
                    <div class="display-6 fw-bold text-warning mb-1">@ViewBag.PatientCount+</div>
                    <div class="text-muted fw-semibold">Bệnh nhân tin chọn</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-3">
                    <div class="display-6 fw-bold text-success mb-1">@ViewBag.SatisfactionRate%</div>
                    <div class="text-muted fw-semibold">Tỷ lệ hài lòng</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Specialties Section -->
<section class="py-5">
    <div class="container py-4">
        <div class="text-center mb-5">
            <span class="section-badge">Dịch Vụ Khám Chữa Bệnh</span>
            <h2 class="section-title fs-1">Các Chuyên Khoa Nổi Bật</h2>
            <p class="text-muted mx-auto" style="max-width: 600px;">
                Phòng khám cung cấp đầy đủ các chuyên khoa đáp ứng nhu cầu chăm sóc sức khỏe đa dạng của bạn và gia đình.
            </p>
        </div>

        <div class="row g-4">
            @foreach (var spec in specialties)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card card-custom h-100 p-4">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="bg-primary-subtle text-primary p-3 rounded-4 fs-3">
                                <i class="fa-solid @spec.Icon"></i>
                            </div>
                            <div>
                                <h4 class="fw-bold mb-1">@spec.Name</h4>
                                <span class="badge bg-light text-secondary border">Mã: @spec.Code</span>
                            </div>
                        </div>
                        <p class="text-muted flex-grow-1">@spec.Description</p>
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-action="SpecialtyDetail" asp-route-id="@spec.Id" class="text-primary text-decoration-none fw-bold">
                                Xem chi tiết <i class="fa-solid fa-arrow-right ms-1"></i>
                            </a>
                            <a asp-controller="Appointment" asp-action="Book" asp-route-specialtyId="@spec.Id" class="btn btn-sm btn-outline-primary rounded-pill">
                                Đặt lịch
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mt-5">
            <a asp-action="Specialties" class="btn btn-outline-primary btn-lg rounded-pill px-4">
                Xem tất cả chuyên khoa <i class="fa-solid fa-chevron-right ms-2"></i>
            </a>
        </div>
    </div>
</section>

<!-- Top Doctors Section -->
<section class="py-5 bg-white border-top border-bottom">
    <div class="container py-4">
        <div class="text-center mb-5">
            <span class="section-badge">Đội Ngũ Y Bác Sĩ</span>
            <h2 class="section-title fs-1">Chuyên Gia Đầu Ngành Tận Tâm</h2>
            <p class="text-muted mx-auto" style="max-width: 600px;">
                Các bác sĩ tại Healthy System đều có trình độ sau đại học, từng công tác tại các bệnh viện tuyến trung ương.
            </p>
        </div>

        <div class="row g-4">
            @foreach (var doc in doctors)
            {
                <div class="col-md-6 col-lg-3">
                    <div class="card card-custom h-100 text-center">
                        <div class="position-relative overflow-hidden" style="height: 240px;">
                            <img src="@(doc.User?.AvatarUrl ?? "https://images.unsplash.com/photo-1622253692010-333f2da6031d?w=400&auto=format&fit=crop&q=80")" 
                                 alt="@doc.User?.FullName" class="w-100 h-100 object-fit-cover" />
                            <div class="position-absolute top-0 end-0 m-3">
                                <span class="badge bg-warning text-dark fw-bold px-2 py-1 shadow-sm">
                                    <i class="fa-solid fa-star me-1"></i>@doc.Rating.ToString("0.0")
                                </span>
                            </div>
                        </div>
                        <div class="card-body p-4 d-flex flex-direction-column flex-column justify-content-between">
                            <div>
                                <span class="badge bg-primary-subtle text-primary mb-2">@doc.Specialty?.Name</span>
                                <h5 class="fw-bold mb-1">@doc.User?.FullName</h5>
                                <div class="text-muted small mb-2">@doc.Title</div>
                                <div class="text-secondary small fw-semibold mb-3">
                                    <i class="fa-solid fa-briefcase me-1"></i>@doc.ExperienceYears năm kinh nghiệm
                                </div>
                            </div>
                            <div class="pt-3 border-top">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="text-muted small">Phí khám:</span>
                                    <span class="fw-bold text-primary">@doc.ConsultationFee.ToString("N0") đ</span>
                                </div>
                                <div class="d-grid gap-2">
                                    <a asp-action="DoctorDetail" asp-route-id="@doc.Id" class="btn btn-sm btn-outline-secondary rounded-pill">
                                        Xem thông tin
                                    </a>
                                    <a asp-controller="Appointment" asp-action="Book" asp-route-doctorId="@doc.Id" class="btn btn-sm btn-primary rounded-pill">
                                        Đặt khám ngay
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mt-5">
            <a asp-action="Doctors" class="btn btn-outline-primary btn-lg rounded-pill px-4">
                Xem toàn bộ danh sách bác sĩ <i class="fa-solid fa-chevron-right ms-2"></i>
            </a>
        </div>
    </div>
</section>

<!-- Medical Equipment Section -->
<section class="py-5">
    <div class="container py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-5">
                <span class="section-badge">Cơ Sở Vật Chất</span>
                <h2 class="section-title fs-1">Trang Thiết Bị Kỹ Thuật Số Hiện Đại</h2>
                <p class="text-muted mb-4">
                    Healthy System đầu tư đồng bộ hệ thống chẩn đoán hình ảnh và xét nghiệm tân tiến nhập khẩu trực tiếp từ Đức, Mỹ, Nhật Bản nhằm nâng cao độ chuẩn xác trong việc chẩn đoán.
                </p>
                <ul class="list-unstyled mb-4">
                    <li class="d-flex align-items-center gap-3 mb-3">
                        <i class="fa-solid fa-circle-check text-success fs-5"></i>
                        <span>Máy chụp cắt lớp vi tính CT đa lát cắt thế hệ mới</span>
                    </li>
                    <li class="d-flex align-items-center gap-3 mb-3">
                        <i class="fa-solid fa-circle-check text-success fs-5"></i>
                        <span>Hệ thống nội soi ống mềm NBI phóng đại Olympus Nhật Bản</span>
                    </li>
                    <li class="d-flex align-items-center gap-3 mb-3">
                        <i class="fa-solid fa-circle-check text-success fs-5"></i>
                        <span>Máy siêu âm màu 4D Doppler ma trận điện tử GE Hoa Kỳ</span>
                    </li>
                </ul>
                <a asp-action="Equipment" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
                    Khám phá cơ sở vật chất <i class="fa-solid fa-arrow-right ms-2"></i>
                </a>
            </div>
            <div class="col-lg-7">
                <div class="row g-3">
                    @foreach (var eq in equipments)
                    {
                        <div class="col-md-4">
                            <div class="card card-custom h-100 text-center p-3">
                                <img src="@eq.ImageUrl" alt="@eq.Name" class="img-fluid rounded-3 mb-3" style="height: 140px; object-fit: cover;" />
                                <h6 class="fw-bold mb-1 text-truncate" title="@eq.Name">@eq.Name</h6>
                                <small class="text-muted mb-2">Xuất xứ: @eq.Origin</small>
                                <span class="badge bg-success-subtle text-success py-1 mt-auto">@eq.Status</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action Banner -->
<section class="py-5 bg-primary text-white text-center">
    <div class="container py-4">
        <h2 class="display-6 fw-bold mb-3">Sẵn Sàng Chăm Sóc Sức Khỏe Cho Bạn & Gia Đình</h2>
        <p class="lead text-white-50 mb-4 mx-auto" style="max-width: 650px;">
            Đừng để những cơn đau hay triệu chứng bất thường ảnh hưởng đến cuộc sống. Đặt lịch khám ngay hôm nay để được chẩn đoán sớm và điều trị dứt điểm.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Appointment" asp-action="Book" class="btn btn-warning btn-lg rounded-pill px-5 py-3 fw-bold text-dark shadow">
                <i class="fa-solid fa-calendar-check me-2"></i>ĐẶT LỊCH NGAY
            </a>
            <a href="tel:19008888" class="btn btn-outline-light btn-lg rounded-pill px-4 py-3 fw-bold">
                <i class="fa-solid fa-phone me-2"></i>Hotline: 1900 8888
            </a>
        </div>
    </div>
</section>
