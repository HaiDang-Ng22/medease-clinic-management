@using Healthy_System.Models
@{
    ViewData["Title"] = "Phòng Khám Đa Khoa MedEase";
    var specialties = ViewBag.Specialties as List<Specialty> ?? new List<Specialty>();
    var doctors = ViewBag.Doctors as List<Doctor> ?? new List<Doctor>();
    var services = ViewBag.Services as List<Service> ?? new List<Service>();
    var equipments = ViewBag.Equipments as List<Equipment> ?? new List<Equipment>();
}

<!-- Hero Section (taste-skill: calm, authoritative healthcare atmosphere) -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <h1 class="display-5 fw-bold mb-3" style="line-height: 1.15; letter-spacing: -0.03em;">
                    Dịch vụ khám chữa bệnh chất lượng cao tại TP. Hồ Chí Minh
                </h1>
                <p class="lead mb-4" style="color: #cbd5e1; font-size: 1.05rem; line-height: 1.6; max-width: 580px;">
                    MedEase vận hành hệ thống tiếp nhận kỹ thuật số, kết nối trực tiếp bệnh nhân với đội ngũ bác sĩ chuyên khoa đầu ngành. Giảm thiểu tối đa thời gian chờ đợi tại phòng khám.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="Appointment" asp-action="Book" class="btn btn-primary px-4 py-2 fw-semibold" style="background:#0f766e; border-color:#0f766e; font-size:0.9375rem; border-radius:6px;">
                        <i class="fa-solid fa-calendar-check me-2"></i>Đặt lịch khám trực tuyến
                    </a>
                    <a asp-controller="Home" asp-action="Doctors" class="btn btn-outline-light px-4 py-2 fw-semibold" style="border-color:rgba(255,255,255,0.25); font-size:0.9375rem; border-radius:6px;">
                        Đội ngũ bác sĩ
                    </a>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block">
                <div class="position-relative">
                    <img src="https://images.unsplash.com/photo-1622253692010-333f2da6031d?w=600&auto=format&fit=crop&q=80" 
                         alt="Đội ngũ Bác sĩ MedEase" class="img-fluid rounded-2 border" style="border-color: rgba(255, 255, 255, 0.15) !important;" />
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Stats Bar (taste-skill app-screens §2.2: KPIs as type, honest clinical figures) -->
<section class="py-4 bg-white" style="border-bottom: 1px solid #e2e8f0;">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-6 col-md-3">
                <div class="p-2">
                    <div class="fs-2 fw-bold" style="color:#0f172a; font-variant-numeric:tabular-nums;">@ViewBag.DoctorCount+</div>
                    <div class="text-muted small">Bác sĩ chuyên khoa trực tiếp khám</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-2">
                    <div class="fs-2 fw-bold" style="color:#0f766e; font-variant-numeric:tabular-nums;">@ViewBag.SpecialtyCount</div>
                    <div class="text-muted small">Chuyên khoa lâm sàng & cận lâm sàng</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-2">
                    <div class="fs-2 fw-bold" style="color:#0284c7; font-variant-numeric:tabular-nums;">@ViewBag.PatientCount+</div>
                    <div class="text-muted small">Hồ sơ bệnh án điện tử đã tiếp nhận</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="p-2">
                    <div class="fs-2 fw-bold" style="color:#475569; font-variant-numeric:tabular-nums;">@ViewBag.SatisfactionRate%</div>
                    <div class="text-muted small">Đánh giá hài lòng về phác đồ điều trị</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Specialties Section (No generic AI eyebrow badge) -->
<section class="py-5">
    <div class="container py-3">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 gap-2">
            <div>
                <h2 class="h3 fw-bold mb-1" style="color:#0f172a; letter-spacing:-0.02em;">Chuyên Khoa Điều Trị</h2>
                <p class="text-muted small mb-0">Hệ thống phòng khám chuyên sâu với đầy đủ phương tiện chẩn đoán hiện đại</p>
            </div>
            <a asp-action="Specialties" class="btn btn-sm btn-outline-secondary px-3 py-2 fw-semibold" style="border-color:#cbd5e1; color:#334155;">
                Tất cả chuyên khoa <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-3">
            @foreach (var spec in specialties.Take(6))
            {
                <div class="col-md-6 col-lg-4">
                    <div class="bg-white p-4 rounded-2 h-100 d-flex flex-column justify-content-between" style="border:1px solid #e2e8f0;">
                        <div>
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div style="width:38px; height:38px; border-radius:6px; background:#f0fdfa; color:#0f766e; display:flex; align-items:center; justify-content:center; font-size:1.1rem; border:1px solid #ccfbf1;">
                                    <i class="fa-solid @spec.Icon"></i>
                                </div>
                                <span class="badge font-monospace bg-light text-muted border px-2 py-1" style="font-size:0.75rem;">@spec.Code</span>
                            </div>
                            <h3 class="h5 fw-bold mb-2" style="color:#0f172a;">@spec.Name</h3>
                            <p class="text-muted small mb-3" style="line-height:1.6;">@spec.Description</p>
                        </div>
                        <div class="pt-3 border-top d-flex justify-content-between align-items-center" style="border-color:#f1f5f9 !important;">
                            <a asp-action="SpecialtyDetail" asp-route-id="@spec.Id" class="small fw-semibold text-decoration-none" style="color:#0f766e;">
                                Chi tiết chuyên khoa
                            </a>
                            <a asp-controller="Appointment" asp-action="Book" asp-route-specialtyId="@spec.Id" class="btn btn-sm btn-outline-secondary px-2 py-1 fw-semibold" style="font-size:0.75rem; border-color:#cbd5e1; color:#334155;">
                                Đặt lịch
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Top Doctors Section -->
<section class="py-5 bg-white" style="border-top:1px solid #e2e8f0; border-bottom:1px solid #e2e8f0;">
    <div class="container py-3">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 gap-2">
            <div>
                <h2 class="h3 fw-bold mb-1" style="color:#0f172a; letter-spacing:-0.02em;">Đội Ngũ Bác Sĩ Tiêu Biểu</h2>
                <p class="text-muted small mb-0">Các bác sĩ giàu kinh nghiệm điều trị, công tác tại các bệnh viện tuyến đầu</p>
            </div>
            <a asp-action="Doctors" class="btn btn-sm btn-outline-secondary px-3 py-2 fw-semibold" style="border-color:#cbd5e1; color:#334155;">
                Xem danh sách bác sĩ <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-3">
            @foreach (var doc in doctors.Take(4))
            {
                var avatarUrl = string.IsNullOrWhiteSpace(doc.User?.AvatarUrl)
                    ? "https://images.unsplash.com/photo-1622253692010-333f2da6031d?w=400&auto=format&fit=crop&q=80"
                    : doc.User.AvatarUrl;
                <div class="col-md-6 col-lg-3">
                    <div class="bg-white rounded-2 h-100 d-flex flex-column justify-content-between" style="border:1px solid #e2e8f0;">
                        <div>
                            <div style="height: 200px; overflow: hidden; background:#f8fafc;" class="rounded-top-2 border-bottom">
                                <img src="@avatarUrl" alt="@doc.User?.FullName" class="w-100 h-100 object-fit-cover" />
                            </div>
                            <div class="p-3">
                                <span class="badge px-2 py-1 mb-2" style="background:#e0f2fe; color:#0369a1; border:1px solid #bae6fd; font-size:0.75rem;">
                                    @doc.Specialty?.Name
                                </span>
                                <h3 class="h6 fw-bold mb-1 text-slate-900" style="color:#0f172a;">@doc.User?.FullName</h3>
                                <div class="text-muted small mb-2" style="font-size:0.75rem;">@doc.Title · @doc.ExperienceYears năm kinh nghiệm</div>
                            </div>
                        </div>
                        <div class="p-3 pt-0">
                            <div class="pt-2 border-top d-flex justify-content-between align-items-center mb-3" style="border-color:#f1f5f9 !important;">
                                <span class="text-muted small" style="font-size:0.75rem;">Phí tư vấn:</span>
                                <span class="fw-bold" style="color:#0f766e; font-variant-numeric:tabular-nums; font-size:0.875rem;">@doc.ConsultationFee.ToString("N0") đ</span>
                            </div>
                            <div class="d-grid gap-1">
                                <a asp-controller="Appointment" asp-action="Book" asp-route-doctorId="@doc.Id" class="btn btn-sm btn-dark fw-semibold py-1" style="background:#0f172a; border-color:#0f172a; font-size:0.8125rem;">
                                    Đặt khám bác sĩ
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Medical Equipment Section -->
<section class="py-5">
    <div class="container py-3">
        <div class="row align-items-center g-5">
            <div class="col-lg-5">
                <h2 class="h3 fw-bold mb-3" style="color:#0f172a; letter-spacing:-0.02em;">Hệ Thống Thiết Bị Chẩn Đoán Kỹ Thuật Số</h2>
                <p class="text-muted small mb-4" style="line-height:1.6;">
                    Phòng khám đồng bộ trang thiết bị nội soi, chụp cắt lớp và siêu âm 4D tân tiến nhập khẩu từ các thương hiệu y tế hàng đầu nhằm nâng cao độ chính xác trong chẩn đoán.
                </p>
                <div class="mb-4">
                    <div class="d-flex align-items-start gap-2 mb-3">
                        <i class="fa-solid fa-check text-teal mt-1" style="color:#0f766e; font-size:0.875rem;"></i>
                        <span class="small text-slate-800">Máy chụp cắt lớp vi tính CT đa lát cắt thế hệ mới</span>
                    </div>
                    <div class="d-flex align-items-start gap-2 mb-3">
                        <i class="fa-solid fa-check text-teal mt-1" style="color:#0f766e; font-size:0.875rem;"></i>
                        <span class="small text-slate-800">Hệ thống nội soi ống mềm NBI phóng đại Olympus Nhật Bản</span>
                    </div>
                    <div class="d-flex align-items-start gap-2">
                        <i class="fa-solid fa-check text-teal mt-1" style="color:#0f766e; font-size:0.875rem;"></i>
                        <span class="small text-slate-800">Máy siêu âm màu 4D Doppler ma trận điện tử GE Hoa Kỳ</span>
                    </div>
                </div>
                <a asp-action="Equipment" class="btn btn-sm btn-outline-secondary px-3 py-2 fw-semibold" style="border-color:#cbd5e1; color:#334155;">
                    Xem danh mục thiết bị
                </a>
            </div>
            <div class="col-lg-7">
                <div class="row g-2">
                    @foreach (var eq in equipments.Take(3))
                    {
                        <div class="col-md-4">
                            <div class="bg-white p-3 rounded-2 h-100 text-center" style="border:1px solid #e2e8f0;">
                                <img src="@eq.ImageUrl" alt="@eq.Name" class="img-fluid rounded-1 mb-2 border" style="height: 120px; width:100%; object-fit: cover;" onerror="this.src='https://images.unsplash.com/photo-1516549655169-df83a0774514?w=600&auto=format&fit=crop&q=80'" />
                                <div class="fw-semibold small text-truncate mb-1" style="color:#0f172a;" title="@eq.Name">@eq.Name</div>
                                <div class="text-muted" style="font-size:0.75rem;">Xuất xứ: @eq.Origin</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Action Callout (taste-skill: Clean single CTA) -->
<section class="py-5" style="background:#091e1b; color:#ffffff; border-top:1px solid rgba(255,255,255,0.08);">
    <div class="container py-3 text-center">
        <h2 class="h3 fw-bold mb-2">Đặt Lịch Khám Trực Tuyến Tiết Kiệm Thời Gian</h2>
        <p class="text-slate-300 small mb-4 mx-auto" style="max-width: 580px; color:#cbd5e1;">
            Chủ động lựa chọn chuyên khoa, bác sĩ phụ trách và khung giờ khám mong muốn. Nhận mã số khám ngay trên điện thoại.
        </p>
        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="Appointment" asp-action="Book" class="btn btn-primary px-4 py-2 fw-semibold" style="background:#0f766e; border-color:#0f766e; font-size:0.875rem; border-radius:6px;">
                <i class="fa-solid fa-calendar-check me-2"></i>Đăng ký lịch khám ngay
            </a>
            <a href="tel:19008888" class="btn btn-outline-light px-4 py-2 fw-semibold" style="border-color:rgba(255,255,255,0.25); font-size:0.875rem; border-radius:6px;">
                Tổng đài: 1900 8888
            </a>
        </div>
    </div>
</section>
