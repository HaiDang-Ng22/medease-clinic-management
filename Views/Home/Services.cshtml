@model List<Service>
@{
    ViewData["Title"] = "Bảng Giá Dịch Vụ Khám Chữa Bệnh";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    string? selectedCat = ViewBag.SelectedCategory;
}

<div class="bg-primary text-white py-5">
    <div class="container text-center">
        <h1 class="fw-bold">Bảng Giá Dịch Vụ Y Tế</h1>
        <p class="lead text-white-50 mx-auto" style="max-width: 600px;">
            Minh bạch chi phí, tư vấn tận tâm. Tất cả dịch vụ tại Healthy System đều được niêm yết công khai theo quy định của Sở Y tế.
        </p>
    </div>
</div>

<div class="container py-5">
    <!-- Category Tabs -->
    <div class="d-flex flex-wrap justify-content-center gap-2 mb-5">
        <a asp-action="Services" class="btn rounded-pill px-4 @(string.IsNullOrEmpty(selectedCat) ? "btn-primary" : "btn-outline-primary")">
            Tất cả dịch vụ
        </a>
        @foreach (var cat in categories)
        {
            <a asp-action="Services" asp-route-category="@cat" class="btn rounded-pill px-4 @(selectedCat == cat ? "btn-primary" : "btn-outline-primary")">
                @cat
            </a>
        }
    </div>

    <!-- Services Table -->
    <div class="card card-custom overflow-hidden shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 py-3">Tên Dịch Vụ Khám / Xét Nghiệm</th>
                        <th class="py-3">Phân Loại</th>
                        <th class="py-3">Chuyên Khoa</th>
                        <th class="py-3">Thời Lượng Dự Kiến</th>
                        <th class="text-end py-3 pe-4">Chi Phí</th>
                        <th class="text-center py-3">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@s.Name</div>
                                <small class="text-muted">@s.Description</small>
                            </td>
                            <td><span class="badge bg-light text-secondary border">@s.Category</span></td>
                            <td>@(s.Specialty?.Name ?? "Đa khoa")</td>
                            <td><i class="fa-regular fa-clock me-1 text-muted"></i>@s.EstimatedDurationMinutes phút</td>
                            <td class="text-end pe-4">
                                <span class="fw-bold text-primary fs-5">@s.Price.ToString("N0")</span> <small class="text-muted">VNĐ</small>
                            </td>
                            <td class="text-center">
                                <a asp-controller="Appointment" asp-action="Book" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    Đặt hẹn
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
