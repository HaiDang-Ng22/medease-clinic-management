@model Doctor
@{
    ViewData["Title"] = Model.User?.FullName ?? "Chi tiết Bác sĩ";
}

<div class="container py-5">
    <div class="row g-4">
        <!-- Left: Doctor Card Profile -->
        <div class="col-lg-4">
            <div class="card card-custom text-center p-4 sticky-top" style="top: 100px;">
                <img src="@(Model.User?.AvatarUrl ?? "https://images.unsplash.com/photo-1622253692010-333f2da6031d?w=400&auto=format&fit=crop&q=80")" 
                     alt="@Model.User?.FullName" class="rounded-4 mx-auto mb-3 shadow" style="width: 200px; height: 200px; object-fit: cover;" />
                <span class="badge bg-primary-subtle text-primary mb-2 py-2 px-3 fs-6">@Model.Specialty?.Name</span>
                <h3 class="fw-bold mb-1">@Model.User?.FullName</h3>
                <p class="text-muted mb-3">@Model.Title</p>

                <div class="d-flex justify-content-center align-items-center gap-1 text-warning mb-3">
                    <i class="fa-solid fa-star"></i>
                    <span class="fw-bold text-dark fs-5">@Model.Rating.ToString("0.0")</span>
                    <span class="text-muted small">(@Model.ReviewCount đánh giá từ bệnh nhân)</span>
                </div>

                <div class="bg-light p-3 rounded-4 mb-4 text-start">
                    <div class="mb-2"><strong>Phòng khám:</strong> @Model.RoomNumber</div>
                    <div class="mb-2"><strong>Kinh nghiệm:</strong> @Model.ExperienceYears năm</div>
                    <div class="mb-0"><strong>Phí khám:</strong> <span class="fw-bold text-primary fs-5">@Model.ConsultationFee.ToString("N0") đ</span></div>
                </div>

                <a asp-controller="Appointment" asp-action="Book" asp-route-doctorId="@Model.Id" class="btn btn-booking btn-lg w-100">
                    <i class="fa-solid fa-calendar-check me-2"></i>ĐẶT LỊCH VỚI BÁC SĨ
                </a>
            </div>
        </div>

        <!-- Right: Bio, Qualifications, Schedules -->
        <div class="col-lg-8">
            <div class="card card-custom p-4 mb-4">
                <h4 class="fw-bold mb-3"><i class="fa-solid fa-user-doctor text-primary me-2"></i>Tiểu Sử & Quá Trình Đào Tạo</h4>
                <p class="text-muted" style="line-height: 1.8;">@Model.Bio</p>
                <div class="row g-3 mt-2">
                    <div class="col-md-6">
                        <div class="border p-3 rounded-3">
                            <h6 class="fw-bold text-primary mb-1"><i class="fa-solid fa-graduation-cap me-2"></i>Học vị</h6>
                            <p class="text-muted mb-0 small">@Model.Title - Đại học Y Dược TP.HCM</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border p-3 rounded-3">
                            <h6 class="fw-bold text-primary mb-1"><i class="fa-solid fa-certificate me-2"></i>Chứng chỉ hành nghề</h6>
                            <p class="text-muted mb-0 small">Chứng chỉ chuyên khoa & Kỹ thuật can thiệp chẩn đoán</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Schedules preview -->
            <div class="card card-custom p-4">
                <h4 class="fw-bold mb-3"><i class="fa-solid fa-calendar-days text-primary me-2"></i>Lịch Khám Dự Kiến Trong Tuần</h4>
                <p class="text-muted small mb-4">Bạn có thể chọn một khung giờ phù hợp để đặt hẹn trực tiếp với bác sĩ.</p>

                @if (Model.Schedules != null && Model.Schedules.Any())
                {
                    var groupedSchedules = Model.Schedules.GroupBy(s => s.WorkDate.Date).Take(5);
                    <div class="d-flex flex-column gap-3">
                        @foreach (var group in groupedSchedules)
                        {
                            <div class="border rounded-3 p-3">
                                <h6 class="fw-bold text-secondary mb-2">
                                    <i class="fa-regular fa-calendar me-1"></i> Ngày @group.Key.ToString("dd/MM/yyyy") (@group.Key.ToString("dddd"))
                                </h6>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var slot in group)
                                    {
                                        <a asp-controller="Appointment" asp-action="Book" asp-route-doctorId="@Model.Id" 
                                           class="btn btn-sm btn-outline-primary rounded-pill">
                                            @slot.TimeSlot
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-info rounded-3">Hiện chưa có lịch trống cho bác sĩ này trong tuần. Vui lòng liên hệ hotline 1900 8888 để được hỗ trợ.</div>
                }
            </div>
        </div>
    </div>
</div>
