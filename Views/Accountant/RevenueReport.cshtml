@model List<Healthy_System.Models.Appointment>
@{
    Layout = "_AccountantLayout";
    ViewData["Title"] = "Báo Cáo Doanh Thu Viện Phí";
    string period = ViewBag.Period as string ?? "month";
    int selectedYear = ViewBag.SelectedYear ?? DateTime.Now.Year;
    int selectedMonth = ViewBag.SelectedMonth ?? DateTime.Now.Month;
    string selectedDate = ViewBag.SelectedDate as string ?? DateTime.Today.ToString("yyyy-MM-dd");

    decimal totalRevenue = ViewBag.TotalRevenue ?? 0m;
    int totalTransactions = ViewBag.TotalTransactions ?? 0;
    decimal consultationRev = ViewBag.ConsultationRev ?? 0m;
    decimal serviceRev = ViewBag.ServiceRev ?? 0m;
    decimal labRev = ViewBag.LabRev ?? 0m;
    decimal prescriptionRev = ViewBag.PrescriptionRev ?? 0m;

    decimal cashRevenue = ViewBag.CashRevenue ?? 0m;
    decimal bankRevenue = ViewBag.BankRevenue ?? 0m;
    decimal cardRevenue = ViewBag.CardRevenue ?? 0m;

    var specialtyRevenue = ViewBag.SpecialtyRevenue as Dictionary<string, decimal> ?? new();
    var doctorRevenue = ViewBag.DoctorRevenue as Dictionary<string, decimal> ?? new();
    var costs = ViewBag.Costs as Dictionary<int, Healthy_System.Models.PatientCost> ?? new();
}

<style>
    @@media print {
        body { background: #ffffff !important; }
        .no-print, .app-sidebar, .app-topbar, footer { display: none !important; }
        .app-main-wrapper { margin-left: 0 !important; }
        .app-content-body { padding: 0 !important; }
    }
</style>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-dark">
            <i class="fa-solid fa-chart-line text-success me-2"></i>Báo Cáo Doanh Thu Viện Phí
        </h2>
        <p class="text-muted mb-0 small">
            Theo dõi, tổng hợp và phân tích tình hình tài chính thực thu của phòng khám theo ngày và theo tháng
        </p>
    </div>
    <div class="d-flex gap-2 no-print">
        <button onclick="window.print()" class="btn btn-outline-primary rounded-pill px-3 shadow-sm">
            <i class="fa-solid fa-print me-1"></i>In Báo Cáo
        </button>
        <button onclick="downloadReportPDF()" class="btn btn-success rounded-pill px-3 shadow-sm">
            <i class="fa-solid fa-file-pdf me-1"></i>Xuất Báo Cáo PDF
        </button>
    </div>
</div>

<!-- Bộ lọc kỳ báo cáo -->
<div class="card border-0 shadow-sm rounded-3 mb-4 no-print">
    <div class="card-body p-3">
        <form method="get" asp-action="RevenueReport" class="row g-2 align-items-center">
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Loại kỳ báo cáo</label>
                <select name="period" id="selectPeriod" class="form-select form-select-sm" onchange="togglePeriodInputs()">
                    <option value="month" selected="@(period == "month")">Xem theo Tháng</option>
                    <option value="day" selected="@(period == "day")">Xem theo Ngày cụ thể</option>
                    <option value="year" selected="@(period == "year")">Xem cả Năm</option>
                </select>
            </div>

            <div class="col-md-3" id="groupDate" style="@(period == "day" ? "display:block;" : "display:none;")">
                <label class="form-label small text-muted mb-1">Chọn ngày</label>
                <input type="date" name="date" value="@selectedDate" class="form-control form-control-sm" />
            </div>

            <div class="col-md-3" id="groupMonth" style="@(period == "month" ? "display:block;" : "display:none;")">
                <label class="form-label small text-muted mb-1">Chọn tháng</label>
                <select name="month" class="form-select form-select-sm">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == selectedMonth)">Tháng @m</option>
                    }
                </select>
            </div>

            <div class="col-md-3" id="groupYear" style="@(period != "day" ? "display:block;" : "display:none;")">
                <label class="form-label small text-muted mb-1">Chọn năm</label>
                <select name="year" class="form-select form-select-sm">
                    @for (int y = DateTime.Now.Year - 2; y <= DateTime.Now.Year + 1; y++)
                    {
                        <option value="@y" selected="@(y == selectedYear)">Năm @y</option>
                    }
                </select>
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-sm btn-success rounded-pill px-4 py-2 w-100 fw-bold">
                    <i class="fa-solid fa-chart-pie me-1"></i>Xem Báo Cáo
                </button>
            </div>
        </form>
    </div>
</div>

<div id="reportPrintArea">
    <!-- Tiêu đề in -->
    <div class="d-none d-print-block text-center mb-4">
        <h4 class="fw-bold mb-1">PHÒNG KHÁM ĐA KHOA HEALTHY SYSTEM</h4>
        <h3 class="fw-bold text-success mb-2">BÁO CÁO TỔNG HỢP DOANH THU VIỆN PHÍ</h3>
        <p class="text-muted small">
            Kỳ báo cáo: @(period == "day" ? $"Ngày {DateTime.Parse(selectedDate):dd/MM/yyyy}" : (period == "month" ? $"Tháng {selectedMonth}/{selectedYear}" : $"Năm {selectedYear}"))
            | Ngày xuất: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
        </p>
    </div>

    <!-- 4 KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-success">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold">Tổng Doanh Thu</div>
                        <div class="fs-4 fw-bold text-success">@totalRevenue.ToString("N0") <small class="fs-6">đ</small></div>
                    </div>
                    <div class="p-3 bg-success-subtle text-success rounded-circle">
                        <i class="fa-solid fa-coins fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-primary">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold">Thu Tiền Khám</div>
                        <div class="fs-4 fw-bold text-primary">@consultationRev.ToString("N0") <small class="fs-6">đ</small></div>
                    </div>
                    <div class="p-3 bg-primary-subtle text-primary rounded-circle">
                        <i class="fa-solid fa-stethoscope fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-info">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold">Dịch Vụ & Xét Nghiệm</div>
                        <div class="fs-4 fw-bold text-info">@((serviceRev + labRev).ToString("N0")) <small class="fs-6">đ</small></div>
                    </div>
                    <div class="p-3 bg-info-subtle text-info rounded-circle">
                        <i class="fa-solid fa-vial fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-warning">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold">Thuốc & Đơn Thuốc</div>
                        <div class="fs-4 fw-bold text-warning">@prescriptionRev.ToString("N0") <small class="fs-6">đ</small></div>
                    </div>
                    <div class="p-3 bg-warning-subtle text-warning rounded-circle">
                        <i class="fa-solid fa-pills fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Biểu đồ & Phương thức thanh toán -->
    <div class="row g-4 mb-4">
        <!-- Biểu đồ doanh thu theo thời gian -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="fa-solid fa-chart-column text-success me-2"></i>Biểu Đồ Doanh Thu (@(period == "day" ? "Theo giờ trong ngày" : (period == "month" ? "Theo ngày trong tháng" : "Theo tháng trong năm")))
                    </h6>
                    <span class="badge bg-light text-dark border">@totalTransactions giao dịch</span>
                </div>
                <div style="height: 280px; position: relative;">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Cơ cấu phương thức thanh toán -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                <h6 class="fw-bold text-dark mb-3">
                    <i class="fa-solid fa-pie-chart text-success me-2"></i>Cơ Cấu Phương Thức
                </h6>
                <div style="height: 200px; position: relative;" class="mb-3">
                    <canvas id="paymentMethodChart"></canvas>
                </div>
                <div class="small">
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span><i class="fa-solid fa-circle text-success me-1"></i>Tiền mặt:</span>
                        <strong class="text-dark">@cashRevenue.ToString("N0") đ</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1 border-bottom">
                        <span><i class="fa-solid fa-circle text-primary me-1"></i>Chuyển khoản QR:</span>
                        <strong class="text-dark">@bankRevenue.ToString("N0") đ</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1">
                        <span><i class="fa-solid fa-circle text-warning me-1"></i>Quẹt thẻ POS:</span>
                        <strong class="text-dark">@cardRevenue.ToString("N0") đ</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Doanh thu theo chuyên khoa & bác sĩ -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                <h6 class="fw-bold text-dark mb-3">
                    <i class="fa-solid fa-stethoscope text-primary me-2"></i>Doanh Thu Theo Chuyên Khoa
                </h6>
                @if (specialtyRevenue.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Chuyên khoa</th>
                                    <th class="text-end">Doanh thu</th>
                                    <th class="text-end">Tỷ trọng</th>
                                </tr>
                            </thead>
                            <tbody class="small">
                                @foreach (var sp in specialtyRevenue.OrderByDescending(x => x.Value))
                                {
                                    decimal pct = totalRevenue > 0 ? (sp.Value / totalRevenue * 100m) : 0;
                                    <tr>
                                        <td class="fw-semibold">@sp.Key</td>
                                        <td class="text-end fw-bold text-dark">@sp.Value.ToString("N0") đ</td>
                                        <td class="text-end text-muted">@pct.ToString("0.0")%</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted small">Chưa có giao dịch trong kỳ này</div>
                }
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-3 p-4 h-100">
                <h6 class="fw-bold text-dark mb-3">
                    <i class="fa-solid fa-user-doctor text-info me-2"></i>Doanh Thu Theo Bác Sĩ
                </h6>
                @if (doctorRevenue.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Bác sĩ</th>
                                    <th class="text-end">Doanh thu</th>
                                    <th class="text-end">Tỷ trọng</th>
                                </tr>
                            </thead>
                            <tbody class="small">
                                @foreach (var doc in doctorRevenue.OrderByDescending(x => x.Value))
                                {
                                    decimal pct = totalRevenue > 0 ? (doc.Value / totalRevenue * 100m) : 0;
                                    <tr>
                                        <td class="fw-semibold">@doc.Key</td>
                                        <td class="text-end fw-bold text-dark">@doc.Value.ToString("N0") đ</td>
                                        <td class="text-end text-muted">@pct.ToString("0.0")%</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted small">Chưa có giao dịch trong kỳ này</div>
                }
            </div>
        </div>
    </div>

    <!-- Bảng kê chi tiết các hóa đơn trong kỳ -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white py-3 border-bottom">
            <div class="d-flex justify-content-between align-items-center">
                <h6 class="fw-bold text-dark mb-0">
                    <i class="fa-solid fa-receipt text-success me-2"></i>Bảng Kê Chi Tiết Hóa Đơn Thu Viện Phí (@Model.Count giao dịch)
                </h6>
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-muted">
                            <tr>
                                <th class="ps-4">Mã Hóa Đơn</th>
                                <th>Thời Gian Thu</th>
                                <th>Bệnh Nhân</th>
                                <th>Bác Sĩ</th>
                                <th>Chuyên Khoa</th>
                                <th class="text-center">Hình Thức</th>
                                <th class="text-end pe-4">Số Tiền (VNĐ)</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            @foreach (var item in Model)
                            {
                                string inv = item.InvoiceCode ?? $"HD-{item.AppointmentDate:yyyyMMdd}-{item.Id:D4}";
                                DateTime pDate = item.PaidAt?.ToLocalTime() ?? item.AppointmentDate;
                                decimal amt = item.PaidAmount > 0 ? item.PaidAmount : 200000m;

                                <tr>
                                    <td class="ps-4 font-monospace fw-bold text-dark">
                                        <a asp-action="InvoiceReceipt" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                                            @inv
                                        </a>
                                    </td>
                                    <td class="text-muted">@pDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="fw-semibold text-dark">@item.Patient?.FullName</td>
                                    <td>@item.Doctor?.Title @item.Doctor?.User?.FullName</td>
                                    <td><span class="badge bg-light text-dark border">@item.Specialty?.Name</span></td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border">@(item.PaymentMethod ?? "Tiền mặt")</span>
                                    </td>
                                    <td class="text-end pe-4 fw-bold text-success fs-6">
                                        @amt.ToString("N0") đ
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td colspan="6" class="text-end ps-4">TỔNG DOANH THU THỰC THU:</td>
                                <td class="text-end pe-4 text-success fs-5">@totalRevenue.ToString("N0") đ</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fa-solid fa-coins text-muted display-4 mb-3"></i>
                    <h6 class="text-muted">Không có giao dịch thanh toán trong kỳ này</h6>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script>
        function togglePeriodInputs() {
            const p = document.getElementById('selectPeriod').value;
            document.getElementById('groupDate').style.display = (p === 'day') ? 'block' : 'none';
            document.getElementById('groupMonth').style.display = (p === 'month') ? 'block' : 'none';
            document.getElementById('groupYear').style.display = (p !== 'day') ? 'block' : 'none';
        }

        // Biểu đồ cột/đường doanh thu
        const labels = @Html.Raw(ViewBag.LabelsJson ?? "[]");
        const revenues = @Html.Raw(ViewBag.RevenueJson ?? "[]");
        const counts = @Html.Raw(ViewBag.CountJson ?? "[]");

        const ctxRev = document.getElementById('revenueChart').getContext('2d');
        new Chart(ctxRev, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: revenues,
                    backgroundColor: 'rgba(16, 185, 129, 0.7)',
                    borderColor: '#10b981',
                    borderWidth: 1,
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return value.toLocaleString('vi-VN') + ' đ';
                            }
                        }
                    }
                }
            }
        });

        // Biểu đồ Doughnut phương thức thanh toán
        const ctxPay = document.getElementById('paymentMethodChart').getContext('2d');
        new Chart(ctxPay, {
            type: 'doughnut',
            data: {
                labels: ['Tiền mặt', 'Chuyển khoản QR', 'Thẻ POS'],
                datasets: [{
                    data: [@cashRevenue, @bankRevenue, @cardRevenue],
                    backgroundColor: ['#10b981', '#3b82f6', '#f59e0b']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                }
            }
        });

        function downloadReportPDF() {
            const element = document.getElementById('reportPrintArea');
            const opt = {
                margin:       [10, 10, 10, 10],
                filename:     'BaoCaoDoanhThu_@period' + '.pdf',
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2, useCORS: true },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'landscape' }
            };
            html2pdf().set(opt).from(element).save();
        }
    </script>
}
