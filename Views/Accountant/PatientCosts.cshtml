@model List<Healthy_System.Models.Appointment>
@{
    Layout = "_AccountantLayout";
    ViewData["Title"] = "Danh Sách Chi Phí Bệnh Nhân";
    var costs = ViewBag.Costs as Dictionary<int, Healthy_System.Models.PatientCost> ?? new();
    string curSearch = ViewBag.Search ?? "";
    string curStatus = ViewBag.Status ?? "";
    string fromDate  = ViewBag.FromDate ?? "";
    string toDate    = ViewBag.ToDate ?? "";

    int cntUnpaid = Model.Count(a => !costs.ContainsKey(a.Id));
    int cntWaiting = Model.Count(a => costs.ContainsKey(a.Id) && costs[a.Id].PaymentStatus != "Paid");
    int cntPaid = Model.Count(a => costs.ContainsKey(a.Id) && costs[a.Id].PaymentStatus == "Paid");
}

<!-- Header -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <nav style="font-size:.8rem;" class="mb-1">
            <a asp-action="Dashboard" class="text-decoration-none text-muted">Bàn làm việc</a>
            <span class="mx-2 text-muted">/</span>
            <span class="text-dark fw-semibold">Chi Phí Bệnh Nhân</span>
        </nav>
        <h5 class="fw-bold mb-1 text-dark">
            <i class="fa-solid fa-file-invoice-dollar text-success me-2"></i>Quản Lý Chi Phí Khám Bệnh
        </h5>
        <p class="text-muted small mb-0">
            Tổng @Model.Count ca — @cntUnpaid chưa lập phí, @cntWaiting chờ thanh toán, @cntPaid đã xong
        </p>
    </div>
</div>

<!-- Stat mini -->
<div class="row g-3 mb-4">
    <div class="col-4">
        <div class="card border-0 shadow-sm text-center p-3" style="border-radius:.85rem;border-left:4px solid #f59e0b!important;">
            <div class="fw-bold fs-4 text-warning">@cntUnpaid</div>
            <div class="text-muted small">Chưa lập phí</div>
        </div>
    </div>
    <div class="col-4">
        <div class="card border-0 shadow-sm text-center p-3" style="border-radius:.85rem;border-left:4px solid #0ea5e9!important;">
            <div class="fw-bold fs-4" style="color:#0ea5e9;">@cntWaiting</div>
            <div class="text-muted small">Chờ thanh toán</div>
        </div>
    </div>
    <div class="col-4">
        <div class="card border-0 shadow-sm text-center p-3" style="border-radius:.85rem;border-left:4px solid #22c55e!important;">
            <div class="fw-bold fs-4 text-success">@cntPaid</div>
            <div class="text-muted small">Đã thanh toán</div>
        </div>
    </div>
</div>

<!-- Filter -->
<div class="card border-0 shadow-sm mb-4" style="border-radius:.85rem;">
    <div class="card-body p-3">
        <form method="get" asp-action="PatientCosts" class="row g-2 align-items-end">
            <div class="col-lg-4 col-md-6">
                <label class="form-label small fw-semibold text-muted mb-1">Tìm kiếm</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="fa-solid fa-magnifying-glass text-muted" style="font-size:.8rem;"></i>
                    </span>
                    <input type="text" name="search" class="form-control border-start-0 bg-light"
                           placeholder="Tên BN, SĐT, mã hẹn..." value="@curSearch" />
                </div>
            </div>
            <div class="col-lg-2 col-md-4">
                <label class="form-label small fw-semibold text-muted mb-1">Trạng thái</label>
                <select name="status" class="form-select bg-light">
                    <option value="" selected="@(string.IsNullOrEmpty(curStatus))">Tất cả</option>
                    <option value="Uncalculated" selected="@(curStatus == "Uncalculated")">Chưa lập phí</option>
                    <option value="Calculated"   selected="@(curStatus == "Calculated")">Chờ thanh toán</option>
                    <option value="Paid"          selected="@(curStatus == "Paid")">Đã thanh toán</option>
                </select>
            </div>
            <div class="col-lg-2 col-md-4">
                <label class="form-label small fw-semibold text-muted mb-1">Từ ngày</label>
                <input type="date" name="fromDate" class="form-control bg-light" value="@fromDate" />
            </div>
            <div class="col-lg-2 col-md-4">
                <label class="form-label small fw-semibold text-muted mb-1">Đến ngày</label>
                <input type="date" name="toDate" class="form-control bg-light" value="@toDate" />
            </div>
            <div class="col-lg-2 col-md-4 d-grid">
                <button type="submit" class="btn btn-success fw-semibold" style="border-radius:.5rem;">
                    <i class="fa-solid fa-filter me-1"></i>Lọc
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Table -->
<div class="card border-0 shadow-sm" style="border-radius:1rem;">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size:.875rem;">
                    <thead style="background:#f8fafc;">
                        <tr>
                            <th class="px-4 py-3 text-muted fw-semibold" style="font-size:.72rem;text-transform:uppercase;letter-spacing:.5px;border:none;">Mã hẹn</th>
                            <th class="py-3 text-muted fw-semibold" style="font-size:.72rem;text-transform:uppercase;letter-spacing:.5px;border:none;">Ngày khám</th>
                            <th class="py-3 text-muted fw-semibold" style="font-size:.72rem;text-transform:uppercase;letter-spacing:.5px;border:none;">Bệnh nhân</th>
                            <th class="py-3 text-muted fw-semibold" style="font-size:.72rem;text-transform:uppercase;letter-spacing:.5px;border:none;">Dịch vụ sử dụng</th>
                            <th class="py-3 text-end text-muted fw-semibold" style="font-size:.72rem;text-transform:uppercase;letter-spacing:.5px;border:none;">Khám</th>
                            <th class="py-3 text-end text-muted fw-semibold" style="font-size:.72rem;text-transform:uppercase;letter-spacing:.5px;border:none;">XN + DV</th>
                            <th class="py-3 text-end text-muted fw-semibold" style="font-size:.72rem;text-transform:uppercase;letter-spacing:.5px;border:none;">Thuốc</th>
                            <th class="py-3 text-end text-muted fw-semibold" style="font-size:.72rem;text-transform:uppercase;letter-spacing:.5px;border:none;">Tổng TT</th>
                            <th class="py-3 text-center text-muted fw-semibold" style="font-size:.72rem;text-transform:uppercase;letter-spacing:.5px;border:none;">Trạng thái</th>
                            <th class="py-3 pe-4 text-end text-muted fw-semibold" style="font-size:.72rem;text-transform:uppercase;letter-spacing:.5px;border:none;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in Model)
                        {
                            var hasCost = costs.TryGetValue(appt.Id, out var cost);
                            bool hasLab = !string.IsNullOrWhiteSpace(appt.LabRequest);
                            bool hasRx  = !string.IsNullOrWhiteSpace(appt.Prescription);
                            <tr>
                                <td class="px-4 py-3" style="border-top:1px solid #f1f5f9;">
                                    <span class="badge px-2 py-1 font-monospace fw-semibold"
                                          style="background:#eff6ff;color:#2563eb;font-size:.72rem;border-radius:.4rem;">
                                        @appt.AppointmentCode
                                    </span>
                                </td>
                                <td class="py-3 text-muted" style="border-top:1px solid #f1f5f9;font-size:.82rem;white-space:nowrap;">
                                    @appt.AppointmentDate.ToString("dd/MM/yyyy")
                                    <div style="font-size:.72rem;">@appt.TimeSlot</div>
                                </td>
                                <td class="py-3" style="border-top:1px solid #f1f5f9;">
                                    <div class="fw-semibold text-dark">@appt.Patient?.FullName</div>
                                    <div class="text-muted" style="font-size:.75rem;">@(appt.Patient?.PhoneNumber ?? "—")</div>
                                    <div class="text-muted" style="font-size:.73rem;">@appt.Doctor?.Title @appt.Doctor?.User?.FullName</div>
                                </td>
                                <!-- Dịch vụ sử dụng -->
                                <td class="py-3" style="border-top:1px solid #f1f5f9;">
                                    <div class="d-flex flex-wrap gap-1">
                                        <span class="badge px-2 py-1"
                                              style="background:#eff6ff;color:#2563eb;border:1px solid #bfdbfe;font-size:.7rem;border-radius:.4rem;">
                                            <i class="fa-solid fa-stethoscope me-1"></i>Khám
                                        </span>
                                        @if (hasLab)
                                        {
                                            <span class="badge px-2 py-1"
                                                  style="background:#f0fdfa;color:#0d9488;border:1px solid #99f6e4;font-size:.7rem;border-radius:.4rem;"
                                                  title="@appt.LabRequest">
                                                <i class="fa-solid fa-flask-vial me-1"></i>Xét nghiệm
                                            </span>
                                        }
                                        @if (hasRx)
                                        {
                                            var rxLines = appt.Prescription!.Split('\n', StringSplitOptions.RemoveEmptyEntries).Length;
                                            <span class="badge px-2 py-1"
                                                  style="background:#fdf4ff;color:#9333ea;border:1px solid #e9d5ff;font-size:.7rem;border-radius:.4rem;"
                                                  title="@appt.Prescription">
                                                <i class="fa-solid fa-pills me-1"></i>@rxLines loại thuốc
                                            </span>
                                        }
                                    </div>
                                </td>
                                <!-- Tiền khám -->
                                <td class="py-3 text-end" style="border-top:1px solid #f1f5f9;font-variant-numeric:tabular-nums;font-size:.82rem;">
                                    @if (hasCost && cost != null)
                                    {
                                        <span>@cost.ConsultationFee.ToString("N0") đ</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size:.78rem;">@(appt.Doctor?.ConsultationFee.ToString("N0") ?? "—") đ</span>
                                    }
                                </td>
                                <!-- XN + DV -->
                                <td class="py-3 text-end" style="border-top:1px solid #f1f5f9;font-variant-numeric:tabular-nums;font-size:.82rem;">
                                    @if (hasCost && cost != null)
                                    {
                                        var xnDv = cost.LabFee + cost.ServiceFee;
                                        <span class="@(xnDv > 0 ? "text-teal" : "text-muted")">@xnDv.ToString("N0") đ</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <!-- Thuốc -->
                                <td class="py-3 text-end" style="border-top:1px solid #f1f5f9;font-variant-numeric:tabular-nums;font-size:.82rem;">
                                    @if (hasCost && cost != null)
                                    {
                                        <span class="@(cost.PrescriptionFee > 0 ? "text-purple" : "text-muted")"
                                              style="color:@(cost.PrescriptionFee > 0 ? "#9333ea" : "#94a3b8");">
                                            @cost.PrescriptionFee.ToString("N0") đ
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <!-- Tổng -->
                                <td class="py-3 text-end fw-bold" style="border-top:1px solid #f1f5f9;font-variant-numeric:tabular-nums;">
                                    @if (hasCost && cost != null)
                                    {
                                        <span class="text-success">@cost.TotalAmount.ToString("N0") đ</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fw-normal fst-italic" style="font-size:.78rem;">Chưa tính</span>
                                    }
                                </td>
                                <!-- Trạng thái -->
                                <td class="py-3 text-center" style="border-top:1px solid #f1f5f9;">
                                    @if (!hasCost)
                                    {
                                        <span class="badge px-2 py-1"
                                              style="background:#f8fafc;color:#94a3b8;border:1px solid #e2e8f0;border-radius:2rem;font-size:.7rem;">
                                            Chưa lập phí
                                        </span>
                                    }
                                    else if (cost?.PaymentStatus == "Paid")
                                    {
                                        <span class="badge px-2 py-1"
                                              style="background:#f0fdf4;color:#16a34a;border:1px solid #bbf7d0;border-radius:2rem;font-size:.7rem;">
                                            <i class="fa-solid fa-check me-1"></i>Đã thanh toán
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge px-2 py-1"
                                              style="background:#fffbeb;color:#d97706;border:1px solid #fde68a;border-radius:2rem;font-size:.7rem;">
                                            <i class="fa-solid fa-clock me-1"></i>Chờ thanh toán
                                        </span>
                                    }
                                </td>
                                <!-- Thao tác -->
                                <td class="py-3 pe-4 text-end" style="border-top:1px solid #f1f5f9;">
                                    @if (!hasCost)
                                    {
                                        <a asp-action="Calculate" asp-route-id="@appt.Id"
                                           class="btn btn-sm btn-success px-3" style="border-radius:.5rem;font-size:.8rem;">
                                            <i class="fa-solid fa-calculator me-1"></i>Lập hoá đơn
                                        </a>
                                    }
                                    else if (cost != null)
                                    {
                                        <div class="d-flex gap-1 justify-content-end">
                                            @if (cost.PaymentStatus != "Paid")
                                            {
                                                <a asp-action="ProcessPayment" asp-route-id="@appt.Id"
                                                   class="btn btn-sm btn-primary px-2" style="border-radius:.5rem;font-size:.78rem;">
                                                    <i class="fa-solid fa-money-bill me-1"></i>Thu tiền
                                                </a>
                                            }
                                            <a asp-action="CostSheet" asp-route-id="@cost.Id"
                                               class="btn btn-sm" title="Xem hoá đơn"
                                               style="background:#f8fafc;color:#475569;border:1px solid #e2e8f0;border-radius:.5rem;width:30px;height:30px;padding:0;display:flex;align-items:center;justify-content:center;">
                                                <i class="fa-solid fa-file-lines" style="font-size:.8rem;"></i>
                                            </a>
                                            <a asp-action="Calculate" asp-route-id="@appt.Id"
                                               class="btn btn-sm" title="Sửa phí"
                                               style="background:#f8fafc;color:#475569;border:1px solid #e2e8f0;border-radius:.5rem;width:30px;height:30px;padding:0;display:flex;align-items:center;justify-content:center;">
                                                <i class="fa-solid fa-pen" style="font-size:.8rem;"></i>
                                            </a>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="fa-regular fa-folder-open fa-3x mb-3 opacity-25"></i>
                <h6>Không tìm thấy ca khám nào phù hợp</h6>
                <p class="small">Thử thay đổi bộ lọc tìm kiếm.</p>
            </div>
        }
    </div>
</div>
