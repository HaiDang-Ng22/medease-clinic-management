@model List<Healthy_System.Models.Appointment>
@{
    Layout = "_AccountantLayout";
    ViewData["Title"] = "Quản Lý Hóa Đơn & Thu Viện Phí";
    var costs = ViewBag.Costs as Dictionary<int, Healthy_System.Models.PatientCost> ?? new();
    string search = ViewBag.Search as string ?? "";
    string status = ViewBag.Status as string ?? "";
    string fromDate = ViewBag.FromDate as string ?? "";
    string toDate = ViewBag.ToDate as string ?? "";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-dark">
            <i class="fa-solid fa-file-invoice-dollar text-success me-2"></i>Hóa Đơn & Thu Viện Phí
        </h2>
        <p class="text-muted mb-0 small">
            Quản lý thu ngân, xác nhận thanh toán sau khám và xuất hóa đơn / phiếu thu điện tử cho bệnh nhân
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="PatientCosts" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="fa-solid fa-calculator me-1"></i>Xem Bảng Tính Chi Phí
        </a>
        <a asp-action="RevenueReport" class="btn btn-success rounded-pill px-3 shadow-sm">
            <i class="fa-solid fa-chart-line me-1"></i>Báo Cáo Doanh Thu
        </a>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Invoices" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" name="search" value="@search" class="form-control border-start-0" placeholder="Mã hẹn, mã HĐ, tên bệnh nhân, SĐT..." />
                </div>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select form-select-sm">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="Paid" selected="@(status == "Paid")">Đã thanh toán</option>
                    <option value="Unpaid" selected="@(status == "Unpaid")">Chưa thanh toán</option>
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" name="fromDate" value="@fromDate" class="form-control form-control-sm" title="Từ ngày" />
            </div>
            <div class="col-md-2">
                <input type="date" name="toDate" value="@toDate" class="form-control form-control-sm" title="Đến ngày" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 flex-grow-1">
                    <i class="fa-solid fa-filter me-1"></i>Lọc
                </button>
                <a asp-action="Invoices" class="btn btn-sm btn-outline-secondary rounded-pill px-2" title="Đặt lại">
                    <i class="fa-solid fa-rotate-left"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Danh sách Hóa đơn -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-muted">
                        <tr>
                            <th class="ps-4">Mã Hóa Đơn / Phiếu Thu</th>
                            <th>Mã Hẹn</th>
                            <th>Bệnh Nhân</th>
                            <th>Bác Sĩ Khám</th>
                            <th>Ngày Khám</th>
                            <th class="text-end">Tổng Tiền Viện Phí</th>
                            <th class="text-center">Phương Thức</th>
                            <th class="text-center">Trạng Thái</th>
                            <th class="text-end pe-4">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var hasCost = costs.ContainsKey(item.Id);
                            var cost = hasCost ? costs[item.Id] : null;
                            bool isPaid = item.PaymentStatus == "Paid" || (cost != null && cost.PaymentStatus == "Paid");
                            decimal amount = item.PaidAmount > 0 ? item.PaidAmount : (cost != null ? cost.TotalAmount : (item.Doctor?.ConsultationFee ?? 200000m));
                            string invCode = item.InvoiceCode ?? $"HD-{item.AppointmentDate:yyyyMMdd}-{item.Id:D4}";

                            <tr>
                                <td class="ps-4">
                                    <span class="font-monospace fw-bold text-dark">@invCode</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@item.AppointmentCode</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@item.Patient?.FullName</div>
                                    <small class="text-muted">@item.Patient?.PhoneNumber</small>
                                </td>
                                <td>
                                    <small class="text-dark fw-medium">@item.Doctor?.Title @item.Doctor?.User?.FullName</small>
                                    <small class="text-muted d-block">@item.Specialty?.Name</small>
                                </td>
                                <td>
                                    <small class="text-dark">@item.AppointmentDate.ToString("dd/MM/yyyy")</small>
                                    <small class="text-muted d-block">@item.TimeSlot</small>
                                </td>
                                <td class="text-end">
                                    <span class="fw-bold fs-6 text-success">@amount.ToString("N0") đ</span>
                                </td>
                                <td class="text-center">
                                    @if (!string.IsNullOrEmpty(item.PaymentMethod))
                                    {
                                        <span class="badge bg-light text-dark border">@item.PaymentMethod</span>
                                    }
                                    else if (cost != null && !string.IsNullOrEmpty(cost.PaymentMethod))
                                    {
                                        <span class="badge bg-light text-dark border">@cost.PaymentMethod</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (isPaid)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">
                                            <i class="fa-solid fa-circle-check me-1"></i>Đã thanh toán
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-dark border border-warning-subtle px-3 py-1 rounded-pill">
                                            <i class="fa-solid fa-clock me-1"></i>Chờ thu tiền
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-1">
                                        @if (!isPaid)
                                        {
                                            <a asp-action="ProcessPayment" asp-route-id="@item.Id" class="btn btn-sm btn-success rounded-pill px-3 shadow-sm" title="Thu viện phí">
                                                <i class="fa-solid fa-cash-register me-1"></i>Thu Tiền
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="InvoiceReceipt" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success rounded-pill px-3" title="Xem & In phiếu thu">
                                                <i class="fa-solid fa-receipt me-1"></i>Phiếu Thu
                                            </a>
                                        }

                                        @if (hasCost)
                                        {
                                            <a asp-action="CostSheet" asp-route-id="@cost!.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-2" title="Xem bảng chi phí">
                                                <i class="fa-solid fa-file-lines"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fa-solid fa-receipt text-muted display-4 mb-3"></i>
                <h6 class="text-muted">Không tìm thấy hóa đơn hoặc phiếu thu nào phù hợp</h6>
                <p class="text-muted small">Vui lòng thay đổi từ khóa hoặc điều kiện lọc ngày</p>
            </div>
        }
    </div>
</div>
