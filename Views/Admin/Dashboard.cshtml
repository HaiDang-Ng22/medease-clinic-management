@model Healthy_System.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Bảng Điều Khiển Quản Trị";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Chart.js CDN cho US39 -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<!-- Header & Quick Actions -->
<div class="mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
    <div>
        <h1 class="h4 fw-bold mb-1" style="color:#0f172a; letter-spacing:-0.02em;">Bảng Điều Khiển Quản Trị & Analytics</h1>
        <p class="text-muted small mb-0">Giám sát tổng thể tài nguyên hệ thống, phân quyền người dùng và chỉ số vận hành thời gian thực</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Doctors" class="btn btn-sm btn-outline-secondary px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2" style="background:#ffffff; border-color:#cbd5e1; color:#334155;">
            <i class="fa-solid fa-user-doctor"></i>
            <span>Bác Sĩ & Chuyên Khoa</span>
        </a>
        <a asp-action="CreateDoctor" class="btn btn-sm btn-primary px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2" style="background:#0284c7; border-color:#0284c7;">
            <i class="fa-solid fa-user-plus"></i>
            <span>Thêm Bác Sĩ Mới</span>
        </a>
    </div>
</div>

<!-- 1. CÁC CHỈ SỐ KPI TỔNG QUAN (US39 + US35) -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="bg-white p-3 rounded-2" style="border:1px solid #e2e8f0;">
            <div class="text-muted small mb-1" style="font-size:0.75rem; text-transform:uppercase; letter-spacing:0.04em;">Tổng tài khoản hệ thống</div>
            <div class="d-flex align-items-baseline gap-2">
                <span class="fs-3 fw-bold" style="color:#0f172a; font-variant-numeric:tabular-nums;">@Model.TotalUsers</span>
                <span class="small text-muted">users</span>
            </div>
            <div class="small text-muted mt-1" style="font-size:0.75rem;">Người dùng đã kích hoạt</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="bg-white p-3 rounded-2" style="border:1px solid #e2e8f0;">
            <div class="text-muted small mb-1" style="font-size:0.75rem; text-transform:uppercase; letter-spacing:0.04em;">Bệnh nhân đăng ký</div>
            <div class="d-flex align-items-baseline gap-2">
                <span class="fs-3 fw-bold" style="color:#0f766e; font-variant-numeric:tabular-nums;">@Model.TotalPatients</span>
                <span class="small text-muted">hồ sơ</span>
            </div>
            <div class="small text-muted mt-1" style="font-size:0.75rem;">Có lịch sử khám chữa bệnh</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="bg-white p-3 rounded-2" style="border:1px solid #e2e8f0;">
            <div class="text-muted small mb-1" style="font-size:0.75rem; text-transform:uppercase; letter-spacing:0.04em;">Ca khám hoàn thành</div>
            <div class="d-flex align-items-baseline gap-2">
                <span class="fs-3 fw-bold" style="color:#0284c7; font-variant-numeric:tabular-nums;">@Model.TotalCompletedAppointments</span>
                <span class="small text-muted">ca</span>
            </div>
            <div class="small text-muted mt-1" style="font-size:0.75rem;">Tỷ lệ hủy: <strong class="text-danger">@Model.CancellationRate%</strong></div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="bg-white p-3 rounded-2" style="border:1px solid #e2e8f0;">
            <div class="text-muted small mb-1" style="font-size:0.75rem; text-transform:uppercase; letter-spacing:0.04em;">Tổng doanh thu viện phí</div>
            <div class="d-flex align-items-baseline gap-2">
                <span class="fs-3 fw-bold" style="color:#10b981; font-variant-numeric:tabular-nums;">@Model.TotalRevenue.ToString("N0")</span>
                <span class="small text-muted">VNĐ</span>
            </div>
            <div class="small text-muted mt-1" style="font-size:0.75rem;">Thanh toán thực tế thành công</div>
        </div>
    </div>
</div>

<!-- 2. BIỂU ĐỒ ANALYTICS THỐNG KÊ (US39) -->
<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="bg-white p-3 rounded-2 h-100" style="border:1px solid #e2e8f0;">
            <div class="fw-bold mb-3" style="color:#0f172a; font-size:0.9375rem;">
                <i class="fa-solid fa-chart-pie me-2 text-primary"></i>Phân Bổ Lượt Khám Theo Chuyên Khoa
            </div>
            <div style="height: 250px;" class="d-flex align-items-center justify-content-center">
                <canvas id="specialtyChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="bg-white p-3 rounded-2 h-100" style="border:1px solid #e2e8f0;">
            <div class="fw-bold mb-3" style="color:#0f172a; font-size:0.9375rem;">
                <i class="fa-solid fa-chart-column me-2 text-success"></i>Top Bác Sĩ Khám Nhiều Nhất
            </div>
            <div style="height: 250px;">
                <canvas id="doctorChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- 2.5. CẢNH BÁO TÌNH TRẠNG THIẾT BỊ BẢO TRÌ & THUỐC SẮP HẾT (US39) -->
<div class="row g-3 mb-4">
    <!-- Cảnh báo Thiết bị -->
    <div class="col-lg-6">
        <div class="bg-white p-3 rounded-2" style="border:1px solid #e2e8f0;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="fw-bold" style="color:#0f172a; font-size:0.9375rem;">
                    <i class="fa-solid fa-triangle-exclamation text-warning me-2"></i>Thiết Bị Đang Bảo Trì
                </div>
                <span class="badge bg-warning text-dark">@Model.MaintenanceEquipments.Count thiết bị</span>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0" style="font-size:0.875rem;">
                    <thead>
                        <tr style="background:#f8fafc; color:#64748b; font-size:0.75rem; text-transform:uppercase;">
                            <th>Tên thiết bị</th>
                            <th>Mã Serial</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.MaintenanceEquipments != null && Model.MaintenanceEquipments.Any())
                        {
                            foreach (var eq in Model.MaintenanceEquipments)
                            {
                                <tr>
                                    <td class="fw-semibold" style="color:#0f172a;">@eq.Name</td>
                                    <td class="font-monospace small text-muted">@eq.SerialNumber</td>
                                    <td><span class="badge px-2 py-1" style="background:#fef3c7; color:#92400e; border:1px solid #fde68a;">@eq.Status</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-3">Tất cả thiết bị đều hoạt động bình thường</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Cảnh báo Thuốc -->
    <div class="col-lg-6">
        <div class="bg-white p-3 rounded-2" style="border:1px solid #e2e8f0;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="fw-bold" style="color:#0f172a; font-size:0.9375rem;">
                    <i class="fa-solid fa-capsules text-danger me-2"></i>Thuốc Sắp Hết Tồn Kho / Hạn Dùng
                </div>
                <span class="badge bg-danger">@(Model.LowStockMedicines?.Count ?? 0) mặt hàng</span>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0" style="font-size:0.875rem;">
                    <thead>
                        <tr style="background:#f8fafc; color:#64748b; font-size:0.75rem; text-transform:uppercase;">
                            <th>Tên thuốc</th>
                            <th class="text-center">Số lượng còn</th>
                            <th>Hạn sử dụng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.LowStockMedicines != null && Model.LowStockMedicines.Any())
                        {
                            foreach (var med in Model.LowStockMedicines)
                            {
                                <tr>
                                    <td class="fw-semibold" style="color:#0f172a;">@med.Name</td>
                                    <td class="text-center"><span class="badge bg-danger-subtle text-danger fw-bold">@med.QuantityLeft hộp</span></td>
                                    <td class="small text-muted">@med.ExpiryDate</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- 3. BẢNG DANH SÁCH NGƯỜI DÙNG & PHÂN QUYỀN VAI TRÒ (US35) -->
<div class="bg-white rounded-2" style="border:1px solid #e2e8f0;">
    <!-- Toolbar -->
    <div class="p-3 border-bottom d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3" style="border-color:#e2e8f0 !important;">
        <div class="d-flex align-items-center gap-2">
            <span class="fw-bold" style="color:#0f172a; font-size:0.9375rem;">Danh Sách Người Dùng & Phân Quyền Vai Trò</span>
            <span class="badge rounded-pill text-bg-light border" style="font-size:0.75rem;">@Model.Users.Count tài khoản</span>
        </div>

        <!-- Search & Filter Controls -->
        <div class="d-flex align-items-center gap-2 w-100 w-md-auto">
            <div class="input-group input-group-sm" style="max-width:280px;">
                <span class="input-group-text bg-white border-end-0 text-muted" style="border-color:#e2e8f0;">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </span>
                <input type="text" id="userFilterInput" class="form-control border-start-0 ps-0" placeholder="Lọc theo tên, email, SĐT..." style="border-color:#e2e8f0; font-size:0.8125rem;">
            </div>
            <select id="roleFilterSelect" class="form-select form-select-sm" style="border-color:#e2e8f0; font-size:0.8125rem; max-width:140px;">
                <option value="">Mọi vai trò</option>
                <option value="Admin">Admin</option>
                <option value="Doctor">Doctor</option>
                <option value="Receptionist">Receptionist</option>
                <option value="Patient">Patient</option>
                <option value="LabTech">LabTech</option>
                <option value="Accountant">Accountant</option>
            </select>
        </div>
    </div>

    <!-- Table -->
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="usersTable" style="font-size:0.875rem;">
            <thead>
                <tr style="background:#f8fafc; border-bottom:1px solid #e2e8f0; color:#64748b; font-size:0.75rem; text-transform:uppercase; letter-spacing:0.04em;">
                    <th class="ps-3 py-2" style="width:70px;">ID</th>
                    <th class="py-2">Họ và tên</th>
                    <th class="py-2">Email</th>
                    <th class="py-2">Số điện thoại</th>
                    <th class="py-2" style="width:140px;">Vai trò</th>
                    <th class="py-2" style="width:220px;">Điều chỉnh phân quyền</th>
                    <th class="text-end pe-3 py-2" style="width:120px;">Ngày tạo</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var currentUserIdStr = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                    int.TryParse(currentUserIdStr, out int currentAdminId);
                }
                @foreach (var u in Model.Users)
                {
                    var firstLetter = !string.IsNullOrEmpty(u.FullName) ? u.FullName.Substring(0, 1).ToUpper() : "U";
                    <tr class="user-row" data-search="@(u.FullName?.ToLower()) @(u.Email?.ToLower()) @(u.PhoneNumber)" data-role="@u.Role">
                        <td class="ps-3 py-3 text-muted" style="font-variant-numeric:tabular-nums; font-size:0.8125rem;">#@u.Id</td>
                        <td class="py-3">
                            <div class="d-flex align-items-center gap-2">
                                <div style="width:28px; height:28px; border-radius:6px; background:#f1f5f9; color:#334155; font-weight:700; font-size:0.75rem; display:flex; align-items:center; justify-content:center; border:1px solid #e2e8f0; flex-shrink:0;">
                                    @firstLetter
                                </div>
                                <span class="fw-semibold text-slate-900" style="color:#0f172a;">@u.FullName</span>
                            </div>
                        </td>
                        <td class="py-3 text-muted">@u.Email</td>
                        <td class="py-3 text-muted" style="font-variant-numeric:tabular-nums;">@(u.PhoneNumber ?? "—")</td>
                        <td class="py-3">
                            @switch (u.Role)
                            {
                                case "Admin":
                                    <span class="badge px-2 py-1" style="background:#f1f5f9; color:#0f172a; border:1px solid #cbd5e1; font-weight:600;">
                                        <i class="fa-solid fa-shield-halved me-1"></i>Admin
                                    </span>
                                    break;
                                case "Doctor":
                                    <span class="badge px-2 py-1" style="background:#e0f2fe; color:#0369a1; border:1px solid #bae6fd; font-weight:600;">
                                        <i class="fa-solid fa-user-doctor me-1"></i>Bác Sĩ
                                    </span>
                                    break;
                                case "Receptionist":
                                    <span class="badge px-2 py-1" style="background:#f0fdfa; color:#0f766e; border:1px solid #ccfbf1; font-weight:600;">
                                        <i class="fa-solid fa-headset me-1"></i>Lễ Tân
                                    </span>
                                    break;
                                case "LabTech":
                                    <span class="badge px-2 py-1" style="background:#f3e8ff; color:#6b21a8; border:1px solid #e9d5ff; font-weight:600;">
                                        <i class="fa-solid fa-flask me-1"></i>Kỹ Thuật Viên
                                    </span>
                                    break;
                                case "Accountant":
                                    <span class="badge px-2 py-1" style="background:#fef3c7; color:#92400e; border:1px solid #fde68a; font-weight:600;">
                                        <i class="fa-solid fa-calculator me-1"></i>Kế Toán
                                    </span>
                                    break;
                                default:
                                    <span class="badge px-2 py-1" style="background:#f8fafc; color:#475569; border:1px solid #e2e8f0; font-weight:600;">
                                        <i class="fa-regular fa-user me-1"></i>Bệnh Nhân
                                    </span>
                                    break;
                            }
                        </td>
                        <td class="py-3">
                            @if (u.Role == "Admin")
                            {
                                <span class="text-muted small d-inline-flex align-items-center gap-1" style="font-size:0.75rem;">
                                    <i class="fa-solid fa-lock text-muted" style="font-size:0.7rem;"></i>Cố định (Quản trị viên)
                                </span>
                            }
                            else if (u.Role == "Doctor")
                            {
                                <div class="d-flex align-items-center gap-2">
                                    <a asp-action="Doctors" class="btn btn-sm btn-outline-secondary px-2 py-1" style="font-size:0.75rem; border-color:#cbd5e1; color:#334155;">
                                        <i class="fa-solid fa-stethoscope me-1"></i>Hồ sơ Bác sĩ
                                    </a>
                                </div>
                            }
                            else if (u.Id == currentAdminId)
                            {
                                <span class="text-muted small" style="font-size:0.75rem;">Tài khoản hiện tại</span>
                            }
                            else
                            {
                                <form asp-action="ChangeRole" method="post" class="d-flex gap-1 align-items-center m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@u.Id" />
                                    <select name="newRole" class="form-select form-select-sm" style="font-size:0.75rem; height:28px; padding-top:2px; padding-bottom:2px; border-color:#cbd5e1; max-width:130px;">
                                        @foreach (var r in new[] { "Patient", "Receptionist", "LabTech", "Accountant" })
                                        {
                                            if (r == u.Role)
                                            {
                                                <option value="@r" selected>@r</option>
                                            }
                                            else
                                            {
                                                <option value="@r">@r</option>
                                            }
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-dark px-2 py-0 fw-semibold" style="height:28px; font-size:0.75rem; border-color:#cbd5e1;" title="Lưu phân quyền">
                                        <i class="fa-solid fa-check"></i>
                                    </button>
                                </form>
                            }
                        </td>
                        <td class="text-end pe-3 py-3 text-muted" style="font-size:0.8125rem; font-variant-numeric:tabular-nums;">
                            @u.CreatedAt.ToString("dd/MM/yyyy")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // 1. Script Lọc theo Tên/Email/SĐT và Vai trò (US35)
            const filterInput = document.getElementById('userFilterInput');
            const roleSelect = document.getElementById('roleFilterSelect');
            if (filterInput && roleSelect) {
                function applyFilter() {
                    const term = filterInput.value.trim().toLowerCase();
                    const selectedRole = roleSelect.value;
                    const rows = document.querySelectorAll('.user-row');

                    rows.forEach(row => {
                        const searchData = row.getAttribute('data-search') || '';
                        const role = row.getAttribute('data-role') || '';

                        const matchesSearch = !term || searchData.includes(term);
                        const matchesRole = !selectedRole || role === selectedRole;

                        if (matchesSearch && matchesRole) {
                            row.style.display = '';
                        } else {
                            row.style.display = 'none';
                        }
                    });
                }

                filterInput.addEventListener('input', applyFilter);
                roleSelect.addEventListener('change', applyFilter);
            }

            // 2. Script Render Biểu đồ Chart.js (US39)
            const specialtyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SpecialtyNames));
            const specialtyCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SpecialtyAppointmentCounts));
            const doctorLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DoctorNames));
            const doctorCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DoctorAppointmentCounts));

            new Chart(document.getElementById('specialtyChart'), {
                type: 'doughnut',
                data: {
                    labels: specialtyLabels.length > 0 ? specialtyLabels : ['Chưa có dữ liệu'],
                    datasets: [{
                        data: specialtyCounts.length > 0 ? specialtyCounts : [1],
                        backgroundColor: ['#0284c7', '#0d9488', '#8b5cf6', '#f59e0b', '#ec4899']
                    }]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
            });

            new Chart(document.getElementById('doctorChart'), {
                type: 'bar',
                data: {
                    labels: doctorLabels.length > 0 ? doctorLabels : ['Chưa có dữ liệu'],
                    datasets: [{ label: 'Số ca khám', data: doctorCounts.length > 0 ? doctorCounts : [0], backgroundColor: '#10b981', borderRadius: 6 }]
                },
                options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }, plugins: { legend: { display: false } } }
            });
        });
    </script>
}