@model List<Healthy_System.Models.User>
@{
    ViewData["Title"] = "Dashboard Quản Trị";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row mb-4 g-3">
    <div class="col-12">
        <h4 class="fw-bold text-dark mb-0"><i class="fa-solid fa-gauge-high me-2" style="color:#7c3aed"></i>Dashboard Quản Trị</h4>
        <p class="text-muted mb-0">Quản lý toàn bộ tài khoản và phân quyền hệ thống</p>
    </div>
    <div class="col-md-3">
        <div class="card border-0 rounded-3 shadow-sm text-white" style="background:linear-gradient(135deg,#7c3aed,#4f46e5)">
            <div class="card-body py-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div><div class="fs-2 fw-bold">@ViewBag.TotalUsers</div><div class="opacity-75">Tổng tài khoản</div></div>
                    <i class="fa-solid fa-users fs-1 opacity-25"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 rounded-3 shadow-sm text-white" style="background:linear-gradient(135deg,#0369a1,#0284c7)">
            <div class="card-body py-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div><div class="fs-2 fw-bold">@ViewBag.TotalDoctors</div><div class="opacity-75">Bác sĩ</div></div>
                    <i class="fa-solid fa-user-doctor fs-1 opacity-25"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 rounded-3 shadow-sm text-white" style="background:linear-gradient(135deg,#059669,#10b981)">
            <div class="card-body py-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div><div class="fs-2 fw-bold">@ViewBag.TotalPatients</div><div class="opacity-75">Bệnh nhân</div></div>
                    <i class="fa-solid fa-hospital-user fs-1 opacity-25"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 rounded-3 shadow-sm text-white" style="background:linear-gradient(135deg,#d97706,#f59e0b)">
            <div class="card-body py-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div><div class="fs-2 fw-bold">@ViewBag.TotalAppointments</div><div class="opacity-75">Lịch hẹn</div></div>
                    <i class="fa-solid fa-calendar-check fs-1 opacity-25"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 rounded-3 shadow-sm">
    <div class="card-header bg-white border-0 py-3 d-flex align-items-center justify-content-between">
        <h6 class="fw-bold mb-0"><i class="fa-solid fa-users me-2 text-purple" style="color:#7c3aed"></i>Danh Sách Người Dùng & Phân Quyền</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="px-4 py-3">ID</th>
                        <th class="py-3">Họ tên</th>
                        <th class="py-3">Email</th>
                        <th class="py-3">Điện thoại</th>
                        <th class="py-3">Vai trò hiện tại</th>
                        <th class="py-3">Đổi vai trò</th>
                        <th class="py-3">Ngày tạo</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="px-4 text-muted">#@u.Id</td>
                            <td class="fw-semibold">@u.FullName</td>
                            <td class="text-muted">@u.Email</td>
                            <td class="text-muted">@u.PhoneNumber</td>
                            <td>
                                @{
                                    var (badge, icon) = u.Role switch {
                                        "Admin" => ("bg-purple text-white", "fa-shield-halved"),
                                        "Doctor" => ("bg-primary text-white", "fa-user-doctor"),
                                        "Receptionist" => ("bg-success text-white", "fa-headset"),
                                        "LabTech" => ("bg-info text-white", "fa-flask"),
                                        "Accountant" => ("bg-warning text-dark", "fa-calculator"),
                                        _ => ("bg-secondary text-white", "fa-user")
                                    };
                                }
                                <span class="badge @badge rounded-pill px-3">
                                    <i class="fa-solid @icon me-1"></i>@u.Role
                                </span>
                            </td>
                            <td>
                                <form asp-action="ChangeRole" method="post" class="d-flex gap-2 align-items-center">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@u.Id" />
                                    <select name="newRole" class="form-select form-select-sm" style="min-width:140px">
                                        @foreach (var r in new[]{"Admin","Doctor","Receptionist","LabTech","Accountant","Patient"})
                                        {
                                            if (r == u.Role) { <option value="@r" selected>@r</option> }
                                            else { <option value="@r">@r</option> }
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-purple fw-semibold" style="color:#7c3aed;border-color:#7c3aed">
                                        <i class="fa-solid fa-floppy-disk"></i>
                                    </button>
                                </form>
                            </td>
                            <td class="text-muted small">@u.CreatedAt.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
