@{
    ViewData["Title"] = "Thêm Dịch Vụ Mới";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 rounded-4 shadow-sm">
            <div class="card-header bg-white border-0 py-4 px-4">
                <h5 class="fw-bold mb-0"><i class="fa-solid fa-plus-circle me-2" style="color:#7c3aed"></i>Thêm Dịch Vụ Mới</h5>
            </div>
            <div class="card-body px-4 pb-4">
                <form asp-action="CreateService" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên dịch vụ <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control rounded-3" required maxlength="150" placeholder="VD: Khám tim mạch tổng quát" />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Danh mục</label>
                            <select name="category" class="form-select rounded-3">
                                <option value="Khám bệnh">Khám bệnh</option>
                                <option value="Xét nghiệm">Xét nghiệm</option>
                                <option value="Chẩn đoán hình ảnh">Chẩn đoán hình ảnh</option>
                                <option value="Phẫu thuật">Phẫu thuật</option>
                                <option value="Vật lý trị liệu">Vật lý trị liệu</option>
                                <option value="Tư vấn">Tư vấn</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Chuyên khoa</label>
                            <select name="specialtyId" class="form-select rounded-3">
                                <option value="">-- Không chọn --</option>
                                @foreach (var sp in (List<Healthy_System.Models.Specialty>)ViewBag.Specialties)
                                {
                                    <option value="@sp.Id">@sp.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Giá (VNĐ) <span class="text-danger">*</span></label>
                            <input type="number" name="price" class="form-control rounded-3" required min="0" step="1000" placeholder="VD: 300000" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Thời gian (phút)</label>
                            <input type="number" name="duration" class="form-control rounded-3" value="30" min="5" max="240" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mô tả</label>
                        <textarea name="description" class="form-control rounded-3" rows="3" maxlength="500" placeholder="Mô tả ngắn về dịch vụ..."></textarea>
                    </div>
                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="isActive" value="true" checked id="isActive" />
                            <label class="form-check-label fw-semibold" for="isActive">Kích hoạt dịch vụ</label>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn fw-semibold px-4 text-white rounded-pill" style="background:#7c3aed">
                            <i class="fa-solid fa-floppy-disk me-1"></i>Lưu Dịch Vụ
                        </button>
                        <a asp-action="Services" class="btn btn-outline-secondary rounded-pill px-4">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
