@model List<Healthy_System.Models.Specialty>
@{
    ViewData["Title"] = "Quản Lý Danh Mục Chuyên Khoa";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var allDoctors = ViewBag.AllDoctors as List<Healthy_System.Models.Doctor> ?? new List<Healthy_System.Models.Doctor>();
}

<!-- Header -->
<div class="mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
    <div>
        <h1 class="h4 fw-bold mb-1" style="color:#0f172a; letter-spacing:-0.02em;">Danh Mục Chuyên Khoa & Phân Bổ Bác Sĩ</h1>
        <p class="text-muted small mb-0">Quản lý cấu trúc chuyên khoa khám chữa bệnh, đóng/mở tiếp nhận và điều chuyển nhân sự bác sĩ phụ trách</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Doctors" class="btn btn-sm btn-outline-secondary px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2" style="background:#ffffff; border-color:#cbd5e1; color:#334155;">
            <i class="fa-solid fa-user-doctor"></i>
            <span>Đội Ngũ Bác Sĩ</span>
        </a>
        <a asp-action="CreateSpecialty" class="btn btn-sm btn-primary px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2" style="background:#0284c7; border-color:#0284c7;">
            <i class="fa-solid fa-plus"></i>
            <span>Thêm Chuyên Khoa Mới</span>
        </a>
    </div>
</div>

<!-- Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2 py-2 px-3 mb-4 rounded-2 small" style="background:#f0fdf4; border-color:#bbf7d0; color:#166534;">
        <i class="fa-solid fa-circle-check fs-5"></i>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2 py-2 px-3 mb-4 rounded-2 small" style="background:#fef2f2; border-color:#fecaca; color:#991b1b;">
        <i class="fa-solid fa-triangle-exclamation fs-5"></i>
        <span>@TempData["ErrorMessage"]</span>
    </div>
}

<!-- Authentic Metrics -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="bg-white p-3 rounded-2" style="border:1px solid #e2e8f0;">
            <div class="text-muted small mb-1" style="font-size:0.75rem; text-transform:uppercase; letter-spacing:0.04em;">Tổng chuyên khoa</div>
            <div class="d-flex align-items-baseline gap-2">
                <span class="fs-3 fw-bold" style="color:#0f172a; font-variant-numeric:tabular-nums;">@ViewBag.TotalSpecialties</span>
                <span class="small text-muted">khoa</span>
            </div>
            <div class="small text-muted mt-1" style="font-size:0.75rem;">Định hình cấu trúc y tế</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="bg-white p-3 rounded-2" style="border:1px solid #e2e8f0;">
            <div class="text-muted small mb-1" style="font-size:0.75rem; text-transform:uppercase; letter-spacing:0.04em;">Đang tiếp nhận khám</div>
            <div class="d-flex align-items-baseline gap-2">
                <span class="fs-3 fw-bold" style="color:#0f766e; font-variant-numeric:tabular-nums;">@ViewBag.ActiveSpecialties</span>
                <span class="small text-muted">hoạt động</span>
            </div>
            <div class="small text-muted mt-1" style="font-size:0.75rem;">Mở đặt lịch trực tuyến</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="bg-white p-3 rounded-2" style="border:1px solid #e2e8f0;">
            <div class="text-muted small mb-1" style="font-size:0.75rem; text-transform:uppercase; letter-spacing:0.04em;">Tạm ngưng tiếp nhận</div>
            <div class="d-flex align-items-baseline gap-2">
                <span class="fs-3 fw-bold" style="color:#64748b; font-variant-numeric:tabular-nums;">@ViewBag.ClosedSpecialties</span>
                <span class="small text-muted">tạm đóng</span>
            </div>
            <div class="small text-muted mt-1" style="font-size:0.75rem;">Bảo lưu lịch sử khám</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="bg-white p-3 rounded-2" style="border:1px solid #e2e8f0;">
            <div class="text-muted small mb-1" style="font-size:0.75rem; text-transform:uppercase; letter-spacing:0.04em;">Bác sĩ đã phân bổ</div>
            <div class="d-flex align-items-baseline gap-2">
                <span class="fs-3 fw-bold" style="color:#0284c7; font-variant-numeric:tabular-nums;">@ViewBag.TotalDoctorsAllocated</span>
                <span class="small text-muted">bác sĩ</span>
            </div>
            <div class="small text-muted mt-1" style="font-size:0.75rem;">Trực tiếp khám chữa bệnh</div>
        </div>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="bg-white p-3 rounded-2 mb-4" style="border:1px solid #e2e8f0;">
    <form method="get" asp-action="Specialties" class="row g-2 align-items-center">
        <div class="col-12 col-md-5">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white text-muted border-end-0" style="border-color:#cbd5e1;">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </span>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control border-start-0 ps-0" placeholder="Tìm theo tên hoặc mã chuyên khoa..." style="border-color:#cbd5e1;" />
            </div>
        </div>
        <div class="col-6 col-md-4">
            <select name="status" class="form-select form-select-sm" style="border-color:#cbd5e1;">
                <option value="all" selected="@(ViewBag.Status == "all")">Tất cả trạng thái</option>
                <option value="active" selected="@(ViewBag.Status == "active")">Đang hoạt động (Mở khám)</option>
                <option value="closed" selected="@(ViewBag.Status == "closed")">Tạm đóng (Ngưng tiếp nhận)</option>
            </select>
        </div>
        <div class="col-6 col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-primary w-100 fw-semibold" style="background:#0f766e; border-color:#0f766e;">
                <i class="fa-solid fa-filter me-1"></i>Lọc
            </button>
            <a asp-action="Specialties" class="btn btn-sm btn-outline-secondary" style="border-color:#cbd5e1;" title="Đặt lại bộ lọc">
                <i class="fa-solid fa-rotate-right"></i>
            </a>
        </div>
    </form>
</div>

<!-- Main Specialty Table Card -->
<div class="bg-white rounded-2" style="border:1px solid #e2e8f0;">
    <div class="p-3 border-bottom d-flex justify-content-between align-items-center" style="border-color:#e2e8f0 !important;">
        <div class="d-flex align-items-center gap-2">
            <span class="fw-bold" style="color:#0f172a; font-size:0.9375rem;">Danh Mục Chuyên Khoa</span>
            <span class="badge rounded-pill text-bg-light border" style="font-size:0.75rem;">@Model.Count khoa hiển thị</span>
        </div>
        <div class="small text-muted">
            <i class="fa-solid fa-circle-info me-1 text-teal"></i>Nhấn nút <b>Đóng/Mở</b> để tạm ngưng hoặc kích hoạt nhận lịch hẹn
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" style="font-size:0.875rem;">
            <thead>
                <tr style="background:#f8fafc; border-bottom:1px solid #e2e8f0; color:#64748b; font-size:0.75rem; text-transform:uppercase; letter-spacing:0.04em;">
                    <th class="ps-3 py-2" style="width:50px;">Icon</th>
                    <th class="py-2" style="min-width:180px;">Chuyên khoa & Mã</th>
                    <th class="py-2" style="min-width:220px;">Mô tả</th>
                    <th class="py-2" style="min-width:260px;">Đội ngũ bác sĩ phụ trách</th>
                    <th class="py-2 text-center" style="width:100px;">Quy mô</th>
                    <th class="py-2" style="width:130px;">Trạng thái</th>
                    <th class="text-end pe-3 py-2" style="width:170px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-folder-open fs-2 mb-2 text-muted opacity-50 d-block"></i>
                            <div class="fw-semibold">Không tìm thấy chuyên khoa nào</div>
                            <small class="text-muted">Thử thay đổi từ khóa tìm kiếm hoặc bấm "Thêm Chuyên Khoa Mới".</small>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var s in Model)
                    {
                        var iconClass = string.IsNullOrWhiteSpace(s.Icon) ? "fa-stethoscope" : s.Icon;
                        <tr style="@(!s.IsActive ? "background-color: #fafafa; opacity: 0.88;" : "")">
                            <td class="ps-3 py-3 text-center">
                                <div class="rounded-2 d-inline-flex align-items-center justify-content-center" 
                                     style="width:36px; height:36px; background:@(s.IsActive ? "#f0fdfa" : "#f1f5f9"); color:@(s.IsActive ? "#0f766e" : "#64748b"); border:1px solid @(s.IsActive ? "#ccfbf1" : "#e2e8f0");">
                                    <i class="fa-solid @iconClass fs-6"></i>
                                </div>
                            </td>
                            <td class="py-3">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-bold text-slate-900" style="color:#0f172a; line-height:1.2;">@s.Name</span>
                                    <span class="badge bg-light text-secondary border px-2 py-0" style="font-size:0.7rem; font-family:monospace;">@s.Code</span>
                                </div>
                                <div class="small text-muted mt-1" style="font-size:0.75rem;">
                                    ID: #@s.Id
                                </div>
                            </td>
                            <td class="py-3">
                                @if (!string.IsNullOrWhiteSpace(s.Description))
                                {
                                    <div class="text-muted small" style="font-size:0.8125rem; line-height:1.35; max-width:320px;">
                                        @(s.Description.Length > 90 ? s.Description[..90] + "..." : s.Description)
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small fst-italic">Chưa có phần mô tả</span>
                                }
                            </td>
                            <td class="py-3">
                                @if (s.Doctors != null && s.Doctors.Any())
                                {
                                    <div class="d-flex flex-wrap gap-1 align-items-center mb-1">
                                        @foreach (var doc in s.Doctors)
                                        {
                                            <span class="badge d-inline-flex align-items-center gap-1 px-2 py-1" 
                                                  style="background:#f8fafc; color:#334155; border:1px solid #cbd5e1; font-weight:500; font-size:0.75rem;">
                                                <i class="fa-solid fa-user-doctor text-primary" style="font-size:0.7rem; color:#0284c7 !important;"></i>
                                                @(doc.User?.FullName ?? "BS #" + doc.Id)
                                                <span class="text-muted" style="font-size:0.65rem;">(@doc.RoomNumber)</span>
                                            </span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="badge px-2 py-1 mb-1" style="background:#fffbeb; color:#b45309; border:1px solid #fde68a; font-weight:500; font-size:0.75rem;">
                                        <i class="fa-solid fa-triangle-exclamation me-1"></i>Chưa phân bổ bác sĩ
                                    </span>
                                }
                                <div>
                                    <button type="button" class="btn btn-link p-0 text-decoration-none fw-semibold" 
                                            style="font-size:0.75rem; color:#0284c7;"
                                            data-bs-toggle="modal" data-bs-target="#allocateModal"
                                            data-specialty-id="@s.Id" data-specialty-name="@s.Name">
                                        <i class="fa-solid fa-user-plus me-1"></i>Phân bổ thêm bác sĩ
                                    </button>
                                </div>
                            </td>
                            <td class="py-3 text-center">
                                <div class="small fw-semibold text-slate-800" style="font-variant-numeric:tabular-nums;">
                                    @(s.Services?.Count ?? 0) <span class="text-muted fw-normal" style="font-size:0.7rem;">dịch vụ</span>
                                </div>
                                <div class="small text-muted" style="font-size:0.7rem; font-variant-numeric:tabular-nums;">
                                    @(s.Appointments?.Count ?? 0) lượt khám
                                </div>
                            </td>
                            <td class="py-3">
                                @if (s.IsActive)
                                {
                                    <span class="badge px-2 py-1 d-inline-flex align-items-center gap-1" style="background:#f0fdfa; color:#0f766e; border:1px solid #ccfbf1; font-weight:600;">
                                        <span class="d-inline-block rounded-circle" style="width:6px; height:6px; background:#0f766e;"></span>
                                        Đang hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="badge px-2 py-1 d-inline-flex align-items-center gap-1" style="background:#f1f5f9; color:#64748b; border:1px solid #e2e8f0; font-weight:600;">
                                        <span class="d-inline-block rounded-circle" style="width:6px; height:6px; background:#94a3b8;"></span>
                                        Tạm đóng
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-3 py-3">
                                <div class="d-flex gap-1 justify-content-end align-items-center">
                                    <!-- Toggle Active / Close Status -->
                                    <form asp-action="ToggleSpecialtyStatus" asp-route-id="@s.Id" method="post" class="d-inline m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm px-2 py-1" 
                                                style="font-size:0.75rem; border:1px solid @(s.IsActive ? "#fcd34d" : "#86efac"); background:@(s.IsActive ? "#fffbeb" : "#f0fdf4"); color:@(s.IsActive ? "#b45309" : "#15803d");"
                                                title="@(s.IsActive ? "Tạm đóng chuyên khoa (Ngưng nhận lịch đặt mới)" : "Mở lại chuyên khoa (Tiếp tục nhận đặt lịch)")">
                                            <i class="fa-solid @(s.IsActive ? "fa-ban" : "fa-check")"></i>
                                            <span>@(s.IsActive ? "Đóng" : "Mở")</span>
                                        </button>
                                    </form>

                                    <!-- Edit Link -->
                                    <a asp-action="EditSpecialty" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary px-2 py-1" style="font-size:0.75rem; border-color:#cbd5e1; color:#334155;" title="Chỉnh sửa thông tin">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>

                                    <!-- Delete Button with validation alert -->
                                    @{
                                        bool hasDependencies = (s.Doctors != null && s.Doctors.Any()) || (s.Appointments != null && s.Appointments.Any()) || (s.Services != null && s.Services.Any());
                                    }
                                    @if (hasDependencies)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary px-2 py-1 text-muted" 
                                                style="font-size:0.75rem; border-color:#e2e8f0; opacity:0.65;" 
                                                title="Không thể xóa do đang có bác sĩ/lịch khám/dịch vụ ràng buộc. Hãy dùng thao tác 'Đóng' chuyên khoa."
                                                onclick="alert('Không thể xóa chuyên khoa @s.Name vì đang có dữ liệu ràng buộc (Bác sĩ: @(s.Doctors?.Count ?? 0), Ca khám: @(s.Appointments?.Count ?? 0), Dịch vụ: @(s.Services?.Count ?? 0)).\n\nHãy nhấn nút \'Đóng\' để tạm dừng tiếp nhận bệnh nhân mà vẫn giữ toàn vẹn lịch sử y tế!');">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <form asp-action="DeleteSpecialty" asp-route-id="@s.Id" method="post" class="d-inline m-0"
                                              onsubmit="return confirm('Xác nhận xóa vĩnh viễn chuyên khoa: @s.Name? Thao tác này không thể hoàn tác.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger px-2 py-1" style="font-size:0.75rem; border-color:#fecaca;" title="Xóa chuyên khoa">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Phân Bổ Bác Sĩ -->
<div class="modal fade" id="allocateModal" tabindex="-1" aria-labelledby="allocateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-2" style="border:1px solid #e2e8f0;">
            <div class="modal-header py-3 px-4" style="background:#f8fafc; border-bottom:1px solid #e2e8f0;">
                <h6 class="modal-title fw-bold" id="allocateModalLabel" style="color:#0f172a;">
                    <i class="fa-solid fa-user-doctor me-2 text-primary" style="color:#0284c7 !important;"></i>Phân Bổ Bác Sĩ Vào Chuyên Khoa
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AllocateDoctor" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <input type="hidden" name="targetSpecialtyId" id="modalTargetSpecialtyId" />
                    
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Chuyên khoa tiếp nhận:</label>
                        <div class="p-2 rounded-2 fw-bold text-dark" id="modalSpecialtyName" style="background:#f1f5f9; border:1px solid #e2e8f0; font-size:0.9375rem;">
                            —
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-slate-800" style="color:#334155;">Chọn Bác sĩ cần điều chuyển / phân bổ:</label>
                        <select name="doctorId" class="form-select" required style="border-color:#cbd5e1; font-size:0.875rem;">
                            <option value="">-- Chọn bác sĩ --</option>
                            @foreach (var doc in allDoctors)
                            {
                                <option value="@doc.Id">
                                    @(doc.User?.FullName ?? "Bác sĩ #" + doc.Id) - @doc.Title (Hiện tại: @(doc.Specialty?.Name ?? "Chưa rõ") - Phòng @doc.RoomNumber)
                                </option>
                            }
                        </select>
                        <div class="form-text small text-muted mt-2" style="font-size:0.75rem;">
                            <i class="fa-solid fa-info-circle me-1"></i>Bác sĩ được chọn sẽ lập tức chuyển sang chuyên khoa mới, đồng bộ với lịch khám và cổng đặt lịch bệnh nhân.
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2 px-4" style="background:#f8fafc; border-top:1px solid #e2e8f0;">
                    <button type="button" class="btn btn-sm btn-outline-secondary px-3 py-2" data-bs-dismiss="modal" style="border-color:#cbd5e1;">Hủy</button>
                    <button type="submit" class="btn btn-sm btn-primary px-3 py-2 fw-semibold" style="background:#0284c7; border-color:#0284c7;">
                        <i class="fa-solid fa-check me-1"></i>Lưu Phân Bổ
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const allocateModal = document.getElementById('allocateModal');
        if (allocateModal) {
            allocateModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const specId = button.getAttribute('data-specialty-id');
                const specName = button.getAttribute('data-specialty-name');

                document.getElementById('modalTargetSpecialtyId').value = specId;
                document.getElementById('modalSpecialtyName').textContent = specName;
            });
        }
    </script>
}
