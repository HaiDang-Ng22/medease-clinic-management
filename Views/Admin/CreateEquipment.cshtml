@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Thêm Trang Thiết Bị Mới";
    var specialties = ViewBag.Specialties as List<Specialty> ?? new List<Specialty>();
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1"><i class="fa-solid fa-plus-circle text-primary me-2"></i>Thêm Trang Thiết Bị Y Tế</h2>
                <p class="text-muted mb-0">Nhập thông số kỹ thuật, nguồn gốc và phân bổ chuyên khoa</p>
            </div>
            <a asp-action="Equipments" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="fa-solid fa-arrow-left me-1"></i>Quay lại danh sách
            </a>
        </div>

        <div class="card shadow-sm border-0 p-4 p-md-5">
            <form asp-action="CreateEquipment" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-bold">Tên Trang Thiết Bị <span class="text-danger">*</span></label>
                    <input type="text" name="name" class="form-control rounded-3" required 
                           placeholder="Ví dụ: Máy Siêu Âm Doppler Màu 4D GE Voluson E10..." />
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Chuyên Khoa Sử Dụng</label>
                        <select name="specialtyId" class="form-select rounded-3">
                            <option value="">-- Dùng chung toàn phòng khám --</option>
                            @foreach (var s in specialties)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Xuất Xứ / Quốc Gia</label>
                        <input type="text" name="origin" class="form-control rounded-3" value="Đức" 
                               placeholder="Ví dụ: Đức, Nhật Bản, Hoa Kỳ..." />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Tình Trạng Ban Đầu</label>
                        <select name="status" class="form-select rounded-3">
                            <option value="Đang vận hành tốt">Đang vận hành tốt</option>
                            <option value="Đang bảo trì">Đang bảo trì</option>
                            <option value="Cần kiểm định">Cần kiểm định</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Đường Dẫn Hình Ảnh (URL)</label>
                        <input type="text" name="imageUrl" class="form-control rounded-3" 
                               value="https://images.unsplash.com/photo-1516549655169-df83a0774514?w=600&auto=format&fit=crop&q=80" 
                               placeholder="https://..." />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Mô Tả Chức Năng & Tiêu Chuẩn Kỹ Thuật</label>
                    <textarea name="description" rows="4" class="form-control rounded-3" 
                              placeholder="Mô tả công năng của thiết bị, độ phân giải, ứng dụng chẩn đoán..."></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Equipments" class="btn btn-outline-secondary rounded-pill px-4">Hủy</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold">
                        <i class="fa-solid fa-check me-2"></i>Lưu Thiết Bị
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
