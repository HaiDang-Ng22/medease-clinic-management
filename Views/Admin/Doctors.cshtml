@model List<Healthy_System.Models.Doctor>
@{
    ViewData["Title"] = "Quản Lý Bác Sĩ & Chuyên Khoa";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
    <div>
        <h1 class="h4 fw-bold mb-1" style="color:#0f172a; letter-spacing:-0.02em;">Quản Lý Đội Ngũ Bác Sĩ</h1>
        <p class="text-muted small mb-0">Hồ sơ năng lực chuyên môn, chuyên khoa khám chữa bệnh, phân công phòng khám và biểu phí</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Dashboard" class="btn btn-sm btn-outline-secondary px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2" style="background:#ffffff; border-color:#cbd5e1; color:#334155;">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Dashboard</span>
        </a>
        <a asp-action="CreateDoctor" class="btn btn-sm btn-primary px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2" style="background:#0284c7; border-color:#0284c7;">
            <i class="fa-solid fa-user-plus"></i>
            <span>Tiếp Nhận Bác Sĩ Mới</span>
        </a>
    </div>
</div>

<!-- Authentic Doctor Metrics (taste-skill app-screens §2.2) -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4">
        <div class="bg-white p-3 rounded-2" style="border:1px solid #e2e8f0;">
            <div class="text-muted small mb-1" style="font-size:0.75rem; text-transform:uppercase; letter-spacing:0.04em;">Tổng số bác sĩ đang công tác</div>
            <div class="d-flex align-items-baseline gap-2">
                <span class="fs-3 fw-bold" style="color:#0f172a; font-variant-numeric:tabular-nums;">@Model.Count</span>
                <span class="small text-muted">bác sĩ</span>
            </div>
            <div class="small text-muted mt-1" style="font-size:0.75rem;">Phụ trách các phòng khám</div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="bg-white p-3 rounded-2" style="border:1px solid #e2e8f0;">
            <div class="text-muted small mb-1" style="font-size:0.75rem; text-transform:uppercase; letter-spacing:0.04em;">Chuyên khoa phục vụ</div>
            <div class="d-flex align-items-baseline gap-2">
                <span class="fs-3 fw-bold" style="color:#0284c7; font-variant-numeric:tabular-nums;">@(ViewBag.Specialties != null ? ((List<Healthy_System.Models.Specialty>)ViewBag.Specialties).Count : 0)</span>
                <span class="small text-muted">chuyên khoa</span>
            </div>
            <div class="small text-muted mt-1" style="font-size:0.75rem;">Nội, Ngoại, Nhi, Mắt, Tai Mũi Họng...</div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="bg-white p-3 rounded-2" style="border:1px solid #e2e8f0;">
            <div class="text-muted small mb-1" style="font-size:0.75rem; text-transform:uppercase; letter-spacing:0.04em;">Tổng ca khám đã tiếp nhận</div>
            <div class="d-flex align-items-baseline gap-2">
                <span class="fs-3 fw-bold" style="color:#0f766e; font-variant-numeric:tabular-nums;">@Model.Sum(d => d.Appointments?.Count ?? 0)</span>
                <span class="small text-muted">lượt khám</span>
            </div>
            <div class="small text-muted mt-1" style="font-size:0.75rem;">Toàn thời gian hệ thống ghi nhận</div>
        </div>
    </div>
</div>

<!-- Main Doctor Table Card -->
<div class="bg-white rounded-2" style="border:1px solid #e2e8f0;">
    <div class="p-3 border-bottom d-flex justify-content-between align-items-center" style="border-color:#e2e8f0 !important;">
        <span class="fw-bold" style="color:#0f172a; font-size:0.9375rem;">Danh Sách Bác Sĩ & Hồ Sơ Năng Lực</span>
        <span class="badge rounded-pill text-bg-light border" style="font-size:0.75rem;">@Model.Count bác sĩ</span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" style="font-size:0.875rem;">
            <thead>
                <tr style="background:#f8fafc; border-bottom:1px solid #e2e8f0; color:#64748b; font-size:0.75rem; text-transform:uppercase; letter-spacing:0.04em;">
                    <th class="ps-3 py-2">Bác sĩ</th>
                    <th class="py-2">Chuyên khoa</th>
                    <th class="py-2">Phòng khám</th>
                    <th class="py-2">Kinh nghiệm</th>
                    <th class="py-2 text-end">Phí khám</th>
                    <th class="py-2 text-center">Đánh giá</th>
                    <th class="py-2 text-center">Ca khám</th>
                    <th class="text-end pe-3 py-2" style="width:140px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="fa-solid fa-user-doctor fs-2 mb-2 text-muted opacity-50 d-block"></i>
                            <div class="fw-semibold">Chưa có bác sĩ nào trong hệ thống</div>
                            <small class="text-muted">Bấm "Tiếp Nhận Bác Sĩ Mới" ở góc trên để phân công.</small>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var d in Model)
                    {
                        var avatarUrl = string.IsNullOrWhiteSpace(d.User?.AvatarUrl)
                            ? "https://images.unsplash.com/photo-1622253692010-333f2da6031d?w=100&auto=format&fit=crop&q=80"
                            : d.User.AvatarUrl;
                        <tr>
                            <td class="ps-3 py-3">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@avatarUrl" alt="@d.User?.FullName" 
                                         class="rounded-circle border" 
                                         style="width: 38px; height: 38px; object-fit: cover;" />
                                    <div>
                                        <div class="fw-semibold text-slate-900" style="color:#0f172a; line-height:1.2;">@d.User?.FullName</div>
                                        <div class="text-muted small" style="font-size:0.75rem;">@d.User?.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3">
                                <span class="badge px-2 py-1" style="background:#e0f2fe; color:#0369a1; border:1px solid #bae6fd; font-weight:600;">
                                    <i class="fa-solid fa-stethoscope me-1" style="font-size:0.7rem;"></i>@d.Specialty?.Name
                                </span>
                            </td>
                            <td class="py-3">
                                <span class="badge bg-light text-secondary border px-2 py-1" style="font-size:0.75rem;">
                                    <i class="fa-solid fa-door-open me-1"></i>@d.RoomNumber
                                </span>
                            </td>
                            <td class="py-3">
                                <div class="fw-semibold text-slate-800" style="color:#334155;">@d.ExperienceYears năm</div>
                                <div class="text-muted small" style="font-size:0.75rem;">@d.Title</div>
                            </td>
                            <td class="py-3 text-end fw-semibold" style="color:#0f766e; font-variant-numeric:tabular-nums;">
                                @d.ConsultationFee.ToString("N0") đ
                            </td>
                            <td class="py-3 text-center">
                                <div class="d-inline-flex align-items-center gap-1">
                                    <i class="fa-solid fa-star text-warning" style="font-size:0.75rem;"></i>
                                    <span class="fw-bold" style="font-size:0.8125rem;">@d.Rating.ToString("F1")</span>
                                    <span class="text-muted small" style="font-size:0.7rem;">(@d.ReviewCount)</span>
                                </div>
                            </td>
                            <td class="py-3 text-center">
                                <span class="badge bg-light text-muted border px-2 py-1" style="font-size:0.75rem;">
                                    @(d.Appointments?.Count ?? 0) ca
                                </span>
                            </td>
                            <td class="text-end pe-3 py-3">
                                <a asp-action="EditDoctor" asp-route-id="@d.Id" 
                                   class="btn btn-sm btn-outline-secondary px-2 py-1 fw-semibold" style="font-size:0.75rem; border-color:#cbd5e1; color:#334155;">
                                    <i class="fa-solid fa-pen-to-square me-1"></i>Cấu hình
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
