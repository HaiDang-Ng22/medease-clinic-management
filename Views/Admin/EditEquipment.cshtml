@model Equipment
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Chỉnh Sửa Trang Thiết Bị";
    var specialties = ViewBag.Specialties as List<Specialty> ?? new List<Specialty>();
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1"><i class="fa-solid fa-pen-to-square text-primary me-2"></i>Chỉnh Sửa Trang Thiết Bị (US38)</h2>
                <p class="text-muted mb-0">Cập nhật thông số kỹ thuật, tình trạng vận hành của thiết bị: <strong>@Model.Name</strong></p>
            </div>
            <a asp-action="Equipments" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="fa-solid fa-arrow-left me-1"></i>Quay lại danh sách
            </a>
        </div>

        <div class="card shadow-sm border-0 p-4 p-md-5">
            <form asp-action="EditEquipment" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="mb-3">
                    <label class="form-label fw-bold">Tên Trang Thiết Bị <span class="text-danger">*</span></label>
                    <input type="text" name="name" class="form-control rounded-3" value="@Model.Name" required />
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Chuyên Khoa Phụ Trách</label>
                        <select name="specialtyId" class="form-select rounded-3">
                            <option value="">-- Dùng chung toàn phòng khám --</option>
                            @foreach (var s in specialties)
                            {
                                <option value="@s.Id" selected="@(Model.SpecialtyId == s.Id ? "selected" : null)">@s.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Xuất Xứ / Quốc Gia</label>
                        <input type="text" name="origin" class="form-control rounded-3" value="@Model.Origin" />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Tình Trạng Vận Hành</label>
                        <select name="status" class="form-select rounded-3">
                            <option value="Đang vận hành tốt" selected="@(Model.Status == "Đang vận hành tốt" ? "selected" : null)">Đang vận hành tốt</option>
                            <option value="Đang bảo trì" selected="@(Model.Status == "Đang bảo trì" ? "selected" : null)">Đang bảo trì</option>
                            <option value="Cần kiểm định" selected="@(Model.Status == "Cần kiểm định" ? "selected" : null)">Cần kiểm định</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Đường Dẫn Hình Ảnh (URL)</label>
                        <input type="text" name="imageUrl" class="form-control rounded-3" value="@Model.ImageUrl" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Mô Tả Chức Năng</label>
                    <textarea name="description" rows="4" class="form-control rounded-3">@Model.Description</textarea>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Equipments" class="btn btn-outline-secondary rounded-pill px-4">Hủy</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold">
                        <i class="fa-solid fa-check me-2"></i>Lưu Thay Đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
