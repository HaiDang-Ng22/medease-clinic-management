@using Healthy_System.Models
@model List<Equipment>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản Lý Danh Mục Trang Thiết Bị Y Tế";
    var specialties = ViewBag.Specialties as List<Specialty> ?? new List<Specialty>();
}

<div class="mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
    <div>
        <h1 class="h4 fw-bold mb-1" style="color:#0f172a; letter-spacing:-0.02em;">Quản Lý Danh Mục Trang Thiết Bị Y Tế</h1>
        <p class="text-muted small mb-0">Kiểm soát tình trạng kỹ thuật, xuất xứ và điều phối thiết bị tại các chuyên khoa lâm sàng</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Dashboard" class="btn btn-sm btn-outline-secondary px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2" style="background:#ffffff; border-color:#cbd5e1; color:#334155;">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Dashboard</span>
        </a>
        <a asp-action="CreateEquipment" class="btn btn-sm btn-primary px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2" style="background:#0284c7; border-color:#0284c7;">
            <i class="fa-solid fa-plus"></i>
            <span>Thêm Thiết Bị Mới</span>
        </a>
    </div>
</div>

<!-- Search & Filters -->
<div class="bg-white p-3 rounded-2 mb-4" style="border:1px solid #e2e8f0;">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white border-end-0 text-muted" style="border-color:#e2e8f0;">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </span>
                <input type="text" name="searchKeyword" value="@ViewBag.SearchKeyword" class="form-control border-start-0 ps-0" 
                       placeholder="Tìm theo tên thiết bị, xuất xứ..." style="border-color:#e2e8f0; font-size:0.875rem;" />
            </div>
        </div>
        <div class="col-md-3">
            <select name="specialtyId" class="form-select form-select-sm" style="border-color:#e2e8f0; font-size:0.875rem;">
                <option value="">Tất cả chuyên khoa</option>
                @foreach (var spec in specialties)
                {
                    <option value="@spec.Id" selected="@(ViewBag.SelectedSpecialty == spec.Id ? "selected" : null)">@spec.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select form-select-sm" style="border-color:#e2e8f0; font-size:0.875rem;">
                <option value="">Mọi tình trạng</option>
                <option value="Đang vận hành tốt" selected="@(ViewBag.SelectedStatus == "Đang vận hành tốt" ? "selected" : null)">Đang vận hành tốt</option>
                <option value="Đang bảo trì" selected="@(ViewBag.SelectedStatus == "Đang bảo trì" ? "selected" : null)">Đang bảo trì</option>
                <option value="Cần kiểm định" selected="@(ViewBag.SelectedStatus == "Cần kiểm định" ? "selected" : null)">Cần kiểm định</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-sm btn-dark flex-grow-1 fw-semibold" style="background:#0f172a; border-color:#0f172a; font-size:0.875rem;">Lọc</button>
            <a asp-action="Equipments" class="btn btn-sm btn-outline-secondary" style="border-color:#cbd5e1; font-size:0.875rem;">Reset</a>
        </div>
    </form>
</div>

<!-- Table Card -->
<div class="bg-white rounded-2" style="border:1px solid #e2e8f0;">
    <div class="p-3 border-bottom d-flex justify-content-between align-items-center" style="border-color:#e2e8f0 !important;">
        <span class="fw-bold" style="color:#0f172a; font-size:0.9375rem;">Danh Mục Thiết Bị Y Tế Hoạt Động</span>
        <span class="badge rounded-pill text-bg-light border" style="font-size:0.75rem;">@Model.Count thiết bị</span>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="fa-solid fa-microscope fs-2 mb-2 text-muted opacity-50 d-block"></i>
            <div class="fw-semibold">Không tìm thấy thiết bị y tế nào</div>
            <small class="text-muted">Thử thay đổi từ khóa tìm kiếm hoặc nhấn nút Reset bộ lọc.</small>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size:0.875rem;">
                <thead>
                    <tr style="background:#f8fafc; border-bottom:1px solid #e2e8f0; color:#64748b; font-size:0.75rem; text-transform:uppercase; letter-spacing:0.04em;">
                        <th class="ps-3 py-2" style="width:70px;">Hình ảnh</th>
                        <th class="py-2">Tên thiết bị & Mã</th>
                        <th class="py-2">Chuyên khoa</th>
                        <th class="py-2">Xuất xứ</th>
                        <th class="py-2">Mô tả công năng</th>
                        <th class="py-2" style="width:140px;">Tình trạng</th>
                        <th class="text-end pe-3 py-2" style="width:110px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var eq in Model)
                    {
                        <tr>
                            <td class="ps-3 py-3">
                                <img src="@eq.ImageUrl" alt="@eq.Name" class="rounded-1 border" style="width: 54px; height: 42px; object-fit: cover;" onerror="this.src='https://images.unsplash.com/photo-1516549655169-df83a0774514?w=600&auto=format&fit=crop&q=80'" />
                            </td>
                            <td class="py-3">
                                <div class="fw-semibold text-slate-900" style="color:#0f172a; line-height:1.2;">@eq.Name</div>
                                <small class="text-muted" style="font-size:0.75rem; font-variant-numeric:tabular-nums;">EQ-@eq.Id.ToString("D4")</small>
                            </td>
                            <td class="py-3">
                                <span class="badge bg-light text-secondary border px-2 py-1" style="font-size:0.75rem;">@(eq.Specialty?.Name ?? "Dùng chung")</span>
                            </td>
                            <td class="py-3 text-muted" style="font-size:0.8125rem;">
                                @eq.Origin
                            </td>
                            <td class="py-3">
                                <div class="text-muted small text-truncate" style="max-width: 260px;" title="@eq.Description">
                                    @(string.IsNullOrWhiteSpace(eq.Description) ? "—" : eq.Description)
                                </div>
                            </td>
                            <td class="py-3">
                                @if (eq.Status == "Đang vận hành tốt")
                                {
                                    <span class="badge px-2 py-1" style="background:#f0fdfa; color:#0f766e; border:1px solid #ccfbf1; font-weight:600;">
                                        <i class="fa-solid fa-circle-check me-1" style="font-size:0.65rem;"></i>Vận hành tốt
                                    </span>
                                }
                                else if (eq.Status == "Đang bảo trì")
                                {
                                    <span class="badge px-2 py-1" style="background:#fffbeb; color:#b45309; border:1px solid #fef3c7; font-weight:600;">
                                        <i class="fa-solid fa-wrench me-1" style="font-size:0.65rem;"></i>Đang bảo trì
                                    </span>
                                }
                                else
                                {
                                    <span class="badge px-2 py-1" style="background:#f1f5f9; color:#475569; border:1px solid #e2e8f0; font-weight:600;">
                                        @eq.Status
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-3 py-3">
                                <div class="d-flex justify-content-end gap-1 align-items-center">
                                    <form asp-action="ToggleEquipmentStatus" asp-route-id="@eq.Id" method="post" class="d-inline m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-secondary px-2 py-1" style="font-size:0.75rem; border-color:#cbd5e1; color:#334155;" title="Chuyển trạng thái">
                                            <i class="fa-solid fa-arrows-rotate"></i>
                                        </button>
                                    </form>

                                    <a asp-action="EditEquipment" asp-route-id="@eq.Id" class="btn btn-sm btn-outline-secondary px-2 py-1" style="font-size:0.75rem; border-color:#cbd5e1; color:#334155;" title="Chỉnh sửa">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>

                                    <form asp-action="DeleteEquipment" asp-route-id="@eq.Id" method="post" class="d-inline m-0" onsubmit="return confirm('Bạn có chắc muốn xóa thiết bị này không?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger px-2 py-1" style="font-size:0.75rem; border-color:#fecaca;" title="Xóa">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
