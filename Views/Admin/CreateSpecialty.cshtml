@model Healthy_System.Models.Specialty
@{
    ViewData["Title"] = "Thêm Chuyên Khoa Mới";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="h4 fw-bold mb-1" style="color:#0f172a; letter-spacing:-0.02em;">Thêm Chuyên Khoa Khám Bệnh Mới</h1>
        <p class="text-muted small mb-0">Khởi tạo chuyên khoa mới trong cấu trúc phân cấp dịch vụ y tế của phòng khám</p>
    </div>
    <a asp-action="Specialties" class="btn btn-sm btn-outline-secondary px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2" style="background:#ffffff; border-color:#cbd5e1; color:#334155;">
        <i class="fa-solid fa-arrow-left"></i>
        <span>Quay lại Danh mục</span>
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="bg-white rounded-2 p-4 p-md-5" style="border: 1px solid #e2e8f0;">
            <form asp-action="CreateSpecialty" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 mb-4 rounded-2 small" style="background:#fef2f2; border-color:#fecaca; color:#991b1b;"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label small fw-semibold text-slate-800" style="color:#334155;">
                            Tên Chuyên Khoa <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Name" class="form-control" placeholder="Ví dụ: Tim Mạch, Da Liễu, Nhi Khoa..." style="border-color:#cbd5e1; font-size:0.875rem;" required />
                        <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Code" class="form-label small fw-semibold text-slate-800" style="color:#334155;">
                            Mã Chuyên Khoa
                        </label>
                        <input asp-for="Code" class="form-control" placeholder="VD: TIMMACH, DALIEU" style="border-color:#cbd5e1; font-size:0.875rem; text-transform:uppercase;" />
                        <span asp-validation-for="Code" class="text-danger small mt-1 d-block"></span>
                        <div class="form-text small text-muted" style="font-size:0.75rem;">Để trống sẽ tự sinh mã hệ thống.</div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Icon" class="form-label small fw-semibold text-slate-800" style="color:#334155;">
                            Biểu tượng FontAwesome
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0" id="iconPreview" style="border-color:#cbd5e1; width:44px; justify-content:center;">
                                <i class="fa-solid fa-stethoscope" id="previewIconTag"></i>
                            </span>
                            <input asp-for="Icon" id="iconInput" class="form-control border-start-0 ps-0" placeholder="fa-stethoscope" style="border-color:#cbd5e1; font-size:0.875rem;" value="fa-stethoscope" />
                        </div>
                        <span asp-validation-for="Icon" class="text-danger small mt-1 d-block"></span>
                        
                        <!-- Quick Icon Suggestions -->
                        <div class="d-flex flex-wrap gap-1 mt-2">
                            <span class="text-muted small me-1" style="font-size:0.75rem;">Gợi ý:</span>
                            <button type="button" class="badge bg-light text-dark border px-2 py-1 icon-btn" data-icon="fa-heart-pulse">fa-heart-pulse</button>
                            <button type="button" class="badge bg-light text-dark border px-2 py-1 icon-btn" data-icon="fa-brain">fa-brain</button>
                            <button type="button" class="badge bg-light text-dark border px-2 py-1 icon-btn" data-icon="fa-bone">fa-bone</button>
                            <button type="button" class="badge bg-light text-dark border px-2 py-1 icon-btn" data-icon="fa-eye">fa-eye</button>
                            <button type="button" class="badge bg-light text-dark border px-2 py-1 icon-btn" data-icon="fa-tooth">fa-tooth</button>
                            <button type="button" class="badge bg-light text-dark border px-2 py-1 icon-btn" data-icon="fa-baby">fa-baby</button>
                            <button type="button" class="badge bg-light text-dark border px-2 py-1 icon-btn" data-icon="fa-lungs">fa-lungs</button>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ImageUrl" class="form-label small fw-semibold text-slate-800" style="color:#334155;">
                            URL Hình Ảnh Minh Họa (Tùy chọn)
                        </label>
                        <input asp-for="ImageUrl" class="form-control" placeholder="https://images.unsplash.com/..." style="border-color:#cbd5e1; font-size:0.875rem;" />
                        <span asp-validation-for="ImageUrl" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label small fw-semibold text-slate-800" style="color:#334155;">
                        Mô Tả Chức Năng Khám Chữa Bệnh
                    </label>
                    <textarea asp-for="Description" rows="4" class="form-control" placeholder="Giới thiệu về phạm vi điều trị, các bệnh lý chuyên sâu, trang thiết bị hỗ trợ của chuyên khoa..." style="border-color:#cbd5e1; font-size:0.875rem;"></textarea>
                    <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4 p-3 rounded-2" style="background:#f8fafc; border:1px solid #e2e8f0;">
                    <div class="form-check form-switch mb-0">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch" checked />
                        <label class="form-check-label fw-semibold text-dark small" for="isActiveSwitch">
                            Kích hoạt nhận đặt lịch ngay sau khi tạo
                        </label>
                    </div>
                    <div class="text-muted small mt-1 ps-4" style="font-size:0.75rem;">
                        Nếu tắt, chuyên khoa sẽ được tạo ở trạng thái Tạm đóng và chưa hiển thị cho bệnh nhân trên cổng đặt lịch trực tuyến.
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top" style="border-color:#f1f5f9 !important;">
                    <a asp-action="Specialties" class="btn btn-sm btn-outline-secondary px-3 py-2 fw-semibold" style="border-color:#cbd5e1; color:#334155;">
                        Hủy Bỏ
                    </a>
                    <button type="submit" class="btn btn-sm btn-primary px-4 py-2 fw-semibold" style="background:#0284c7; border-color:#0284c7;">
                        <i class="fa-solid fa-plus me-1"></i>Tạo Chuyên Khoa
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const iconInput = document.getElementById('iconInput');
        const previewIconTag = document.getElementById('previewIconTag');

        iconInput.addEventListener('input', function() {
            previewIconTag.className = 'fa-solid ' + this.value.trim();
        });

        document.querySelectorAll('.icon-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const icon = this.getAttribute('data-icon');
                iconInput.value = icon;
                previewIconTag.className = 'fa-solid ' + icon;
            });
        });
    </script>
}
