@model Healthy_System.Models.ViewModels.CreateDoctorViewModel
@{
    ViewData["Title"] = "Tiếp Nhận Bác Sĩ Mới";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var specialties = (List<Healthy_System.Models.Specialty>)ViewBag.Specialties;
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h4 class="fw-bold text-dark mb-1">
                    <i class="fa-solid fa-user-plus me-2" style="color:#7c3aed"></i>Tiếp Nhận Bác Sĩ Mới
                </h4>
                <p class="text-muted mb-0 small">Tạo tài khoản đăng nhập nội bộ và cấu hình hồ sơ chuyên môn cho Bác sĩ</p>
            </div>
            <a asp-action="Doctors" class="btn btn-outline-secondary rounded-pill px-3 fw-semibold">
                <i class="fa-solid fa-arrow-left me-1"></i> Quay lại danh sách
            </a>
        </div>

        <div class="card border-0 rounded-4 shadow-sm p-4 p-md-5 bg-white">
            <form asp-action="CreateDoctor" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

                <!-- 1. THÔNG TIN ĐĂNG NHẬP & CÁ NHÂN -->
                <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                    <span class="badge rounded-circle p-2" style="background:#7c3aed; color:white">1</span>
                    <h5 class="fw-bold mb-0 text-dark">Thông Tin Tài Khoản Đăng Nhập & Cá Nhân</h5>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control rounded-3" placeholder="Ví dụ: BS. Nguyễn Văn A" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" type="email" class="form-control rounded-3" placeholder="bs.nguyenvana@healthysystem.vn" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <input asp-for="Password" type="password" class="form-control rounded-3" placeholder="Tối thiểu 6 ký tự" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                        <input asp-for="PhoneNumber" class="form-control rounded-3" placeholder="09xxxxxxxx" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Gender" class="form-label fw-semibold"></label>
                        <select asp-for="Gender" class="form-select rounded-3">
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>
                            <option value="Khác">Khác</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Address" class="form-label fw-semibold"></label>
                        <input asp-for="Address" class="form-control rounded-3" placeholder="Địa chỉ thường trú hoặc công tác" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="AvatarUrl" class="form-label fw-semibold"></label>
                        <input asp-for="AvatarUrl" class="form-control rounded-3" placeholder="https://... (để trống sẽ dùng ảnh mặc định)" />
                    </div>
                </div>

                <!-- 2. THÔNG TIN CHUYÊN MÔN & PHÒNG KHÁM -->
                <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                    <span class="badge rounded-circle p-2" style="background:#0284c7; color:white">2</span>
                    <h5 class="fw-bold mb-0 text-dark">Hồ Sơ Chuyên Môn & Phân Công Phòng Khám</h5>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="SpecialtyId" class="form-label fw-semibold"></label>
                        <select asp-for="SpecialtyId" class="form-select rounded-3">
                            <option value="">-- Chọn chuyên khoa --</option>
                            @if (specialties != null)
                            {
                                foreach (var spec in specialties)
                                {
                                    <option value="@spec.Id">@spec.Name (@spec.Code)</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="SpecialtyId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Title" class="form-label fw-semibold"></label>
                        <input asp-for="Title" class="form-control rounded-3" placeholder="Ví dụ: Bác sĩ Chuyên khoa II, Thạc sĩ Bác sĩ" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="RoomNumber" class="form-label fw-semibold"></label>
                        <input asp-for="RoomNumber" class="form-control rounded-3" placeholder="Ví dụ: Phòng 201 - Tầng 2" />
                        <span asp-validation-for="RoomNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="ExperienceYears" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="ExperienceYears" type="number" min="0" max="60" class="form-control rounded-start-3" />
                            <span class="input-group-text rounded-end-3">năm</span>
                        </div>
                        <span asp-validation-for="ExperienceYears" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="ConsultationFee" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="ConsultationFee" type="number" step="10000" min="10000" class="form-control rounded-start-3" />
                            <span class="input-group-text rounded-end-3">VNĐ</span>
                        </div>
                        <span asp-validation-for="ConsultationFee" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Bio" class="form-label fw-semibold"></label>
                        <textarea asp-for="Bio" rows="3" class="form-control rounded-3" 
                                  placeholder="Mô tả quá trình đào tạo, bệnh viện từng công tác, kinh nghiệm chuyên sâu..."></textarea>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Doctors" class="btn btn-outline-secondary rounded-pill px-4">Hủy</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 fw-semibold" style="background:#7c3aed; border-color:#7c3aed;">
                        <i class="fa-solid fa-floppy-disk me-2"></i>Tiếp Nhận & Lưu Bác Sĩ
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
