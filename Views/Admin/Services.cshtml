@model List<Healthy_System.Models.Service>
@{
    ViewData["Title"] = "Quản Lý Dịch Vụ & Biểu Giá";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
    <div>
        <h1 class="h4 fw-bold mb-1" style="color:#0f172a; letter-spacing:-0.02em;">Danh Mục Dịch Vụ & Biểu Giá Niêm Yết</h1>
        <p class="text-muted small mb-0">Quản lý các gói khám bệnh, xét nghiệm cận lâm sàng, thời lượng khám và mức phí áp dụng</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Dashboard" class="btn btn-sm btn-outline-secondary px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2" style="background:#ffffff; border-color:#cbd5e1; color:#334155;">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Dashboard</span>
        </a>
        <a asp-action="CreateService" class="btn btn-sm btn-primary px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2" style="background:#0284c7; border-color:#0284c7;">
            <i class="fa-solid fa-plus"></i>
            <span>Thêm Dịch Vụ Mới</span>
        </a>
    </div>
</div>

<!-- Table Card -->
<div class="bg-white rounded-2" style="border:1px solid #e2e8f0;">
    <div class="p-3 border-bottom d-flex justify-content-between align-items-center" style="border-color:#e2e8f0 !important;">
        <span class="fw-bold" style="color:#0f172a; font-size:0.9375rem;">Biểu Phí & Thời Lượng Dịch Vụ</span>
        <span class="badge rounded-pill text-bg-light border" style="font-size:0.75rem;">@Model.Count dịch vụ</span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" style="font-size:0.875rem;">
            <thead>
                <tr style="background:#f8fafc; border-bottom:1px solid #e2e8f0; color:#64748b; font-size:0.75rem; text-transform:uppercase; letter-spacing:0.04em;">
                    <th class="ps-3 py-2" style="width:70px;">ID</th>
                    <th class="py-2">Tên dịch vụ</th>
                    <th class="py-2">Danh mục</th>
                    <th class="py-2">Chuyên khoa</th>
                    <th class="py-2 text-end" style="width:140px;">Đơn giá</th>
                    <th class="py-2 text-center" style="width:110px;">Thời lượng</th>
                    <th class="py-2" style="width:120px;">Trạng thái</th>
                    <th class="text-end pe-3 py-2" style="width:100px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td class="ps-3 py-3 text-muted" style="font-variant-numeric:tabular-nums; font-size:0.8125rem;">#@s.Id</td>
                        <td class="py-3">
                            <div class="fw-semibold text-slate-900" style="color:#0f172a; line-height:1.2;">@s.Name</div>
                            @if (!string.IsNullOrEmpty(s.Description))
                            {
                                <small class="text-muted d-block mt-1" style="font-size:0.75rem;">@(s.Description.Length > 75 ? s.Description[..75] + "..." : s.Description)</small>
                            }
                        </td>
                        <td class="py-3">
                            <span class="badge bg-light text-secondary border px-2 py-1" style="font-size:0.75rem;">@s.Category</span>
                        </td>
                        <td class="py-3 text-muted">
                            @(s.Specialty?.Name ?? "—")
                        </td>
                        <td class="py-3 text-end fw-semibold" style="color:#0f766e; font-variant-numeric:tabular-nums;">
                            @s.Price.ToString("N0") đ
                        </td>
                        <td class="py-3 text-center text-muted" style="font-variant-numeric:tabular-nums; font-size:0.8125rem;">
                            @s.EstimatedDurationMinutes phút
                        </td>
                        <td class="py-3">
                            @if (s.IsActive)
                            {
                                <span class="badge px-2 py-1" style="background:#f0fdfa; color:#0f766e; border:1px solid #ccfbf1; font-weight:600;">Đang áp dụng</span>
                            }
                            else
                            {
                                <span class="badge px-2 py-1" style="background:#f1f5f9; color:#64748b; border:1px solid #e2e8f0; font-weight:600;">Tạm ngưng</span>
                            }
                        </td>
                        <td class="text-end pe-3 py-3">
                            <div class="d-flex gap-1 justify-content-end align-items-center">
                                <a asp-action="EditService" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary px-2 py-1" style="font-size:0.75rem; border-color:#cbd5e1; color:#334155;" title="Chỉnh sửa">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                <form asp-action="DeleteService" asp-route-id="@s.Id" method="post" class="d-inline m-0"
                                      onsubmit="return confirm('Xác nhận ngừng dịch vụ: @s.Name?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger px-2 py-1" style="font-size:0.75rem; border-color:#fecaca;" title="Xóa">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
