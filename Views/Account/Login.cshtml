@model LoginViewModel
@{
    ViewData["Title"] = "Đăng Nhập Cổng Thông Tin";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="bg-white p-4 p-md-5 rounded-2" style="border: 1px solid #e2e8f0;">
                <div class="mb-4">
                    <h1 class="h4 fw-bold mb-1" style="color:#0f172a; letter-spacing:-0.02em;">Đăng Nhập Hệ Thống</h1>
                    <p class="text-muted small mb-0">Truy cập cổng điều phối, hồ sơ bệnh án điện tử và đặt lịch khám</p>
                </div>

                <form asp-action="Login" method="post" id="loginForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-2 small mb-3" style="background:#fef2f2; color:#991b1b; border:1px solid #fee2e2;"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold text-slate-800" style="color:#334155;">Địa chỉ Email</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted border-end-0" style="border-color:#e2e8f0;">
                                <i class="fa-solid fa-envelope"></i>
                            </span>
                            <input asp-for="Email" id="inputEmail" class="form-control border-start-0 ps-0" placeholder="name@healthysystem.vn" style="border-color:#e2e8f0; font-size:0.875rem;" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="Password" class="form-label small fw-semibold text-slate-800 mb-0" style="color:#334155;">Mật khẩu</label>
                            <a href="tel:19008888" class="small text-muted text-decoration-none" style="font-size:0.75rem;">Hỗ trợ: 1900 8888</a>
                        </div>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted border-end-0" style="border-color:#e2e8f0;">
                                <i class="fa-solid fa-lock"></i>
                            </span>
                            <input asp-for="Password" id="inputPassword" type="password" class="form-control border-start-0 ps-0" placeholder="••••••••" style="border-color:#e2e8f0; font-size:0.875rem;" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" id="rememberMeCheck" />
                            <label class="form-check-label small text-muted" for="rememberMeCheck">Ghi nhớ phiên đăng nhập</label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-semibold py-2 mb-3" style="background:#0f766e; border-color:#0f766e; font-size:0.9375rem; border-radius:6px;">
                        Đăng Nhập
                    </button>
                </form>

                <!-- Quick Test Roles Selector for Examiner / Demo -->
                <div class="p-3 rounded-2 mb-3" style="background:#f8fafc; border:1px solid #e2e8f0;">
                    <div class="small fw-bold text-slate-800 mb-2" style="color:#0f172a; font-size:0.75rem; text-transform:uppercase; letter-spacing:0.04em;">
                        <i class="fa-solid fa-vial me-1 text-teal" style="color:#0f766e;"></i>Tài khoản mẫu kiểm thử nhanh:
                    </div>
                    <div class="d-flex flex-wrap gap-1">
                        <button type="button" class="btn btn-sm btn-outline-secondary px-2 py-1 fill-acc-btn" data-email="admin@healthysystem.vn" data-role="Admin" style="font-size:0.75rem; border-color:#cbd5e1; background:#ffffff;">
                            Admin
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary px-2 py-1 fill-acc-btn" data-email="bs.minhanh@healthysystem.vn" data-role="Bác Sĩ" style="font-size:0.75rem; border-color:#cbd5e1; background:#ffffff;">
                            Bác Sĩ
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary px-2 py-1 fill-acc-btn" data-email="reception@healthysystem.vn" data-role="Lễ Tân" style="font-size:0.75rem; border-color:#cbd5e1; background:#ffffff;">
                            Lễ Tân
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary px-2 py-1 fill-acc-btn" data-email="benhnhan@gmail.com" data-role="Bệnh Nhân" style="font-size:0.75rem; border-color:#cbd5e1; background:#ffffff;">
                            Bệnh Nhân
                        </button>
                    </div>
                    <div class="text-muted mt-2" style="font-size:0.7rem;">Mật khẩu chung: <code class="text-dark bg-white px-1 border rounded">123456</code></div>
                </div>

                <div class="text-center pt-3 border-top" style="border-color:#f1f5f9 !important;">
                    <p class="text-muted small mb-0">
                        Chưa có tài khoản bệnh nhân? 
                        <a asp-action="Register" class="fw-semibold text-decoration-none" style="color:#0f766e;">Đăng ký tại đây</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.fill-acc-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                const email = this.getAttribute('data-email');
                document.getElementById('inputEmail').value = email;
                document.getElementById('inputPassword').value = '123456';
            });
        });
    </script>
}
