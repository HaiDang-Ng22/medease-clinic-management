@model LoginViewModel
@{
    ViewData["Title"] = "Đăng Nhập";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card card-custom p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="bg-primary-subtle text-primary d-inline-block p-3 rounded-circle mb-2">
                        <i class="fa-solid fa-right-to-bracket fs-3"></i>
                    </div>
                    <h2 class="fw-bold">Đăng Nhập</h2>
                    <p class="text-muted small">Truy cập hệ thống quản lý lịch hẹn và hồ sơ bệnh án</p>
                </div>

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fa-solid fa-envelope text-muted"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="email@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fa-solid fa-lock text-muted"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label small text-muted"></label>
                        </div>
                        <a href="tel:19008888" class="small text-primary text-decoration-none">Quên mật khẩu?</a>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold mb-3">
                        ĐĂNG NHẬP
                    </button>
                </form>

                @* <div class="alert alert-light border rounded-3 p-3 small mb-0">
                    <div class="fw-bold text-secondary mb-1"><i class="fa-solid fa-circle-info me-1"></i>Tài khoản mẫu để kiểm thử:</div>
                    <ul class="mb-0 ps-3">
                        <li><strong>Bệnh nhân:</strong> <code>benhnhan@gmail.com</code> / <code>123456</code></li>
                        <li><strong>Bác sĩ:</strong> <code>bs.minhanh@healthysystem.vn</code> / <code>123456</code></li>
                        <li><strong>Lễ tân:</strong> <code>reception@healthysystem.vn</code> / <code>123456</code></li>
                    </ul>
                </div> *@

                <div class="text-center mt-4 pt-3 border-top">
                    <p class="text-muted small mb-0">
                        Chưa có tài khoản? 
                        <a asp-action="Register" class="text-primary fw-bold text-decoration-none">Đăng ký tài khoản mới</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
