@model List<Healthy_System.Models.Appointment>
@{
    Layout = "_ReceptionistLayout";
    ViewData["Title"] = "Quản Lý Thu Ngân & Viện Phí";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="fa-solid fa-cash-register text-success me-2"></i>Quản Lý Thu Ngân & Xuất Hóa Đơn</h2>
            <p class="text-muted mb-0">US32: Xác nhận thanh toán viện phí, lưu vết giao dịch và in phiếu thu cho bệnh nhân.</p>
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-warning-subtle text-dark border px-3 py-2">Chưa thanh toán: <strong>@ViewBag.UnpaidCount</strong></span>
            <span class="badge bg-success-subtle text-success border px-3 py-2">Đã thanh toán: <strong>@ViewBag.PaidCount</strong></span>
        </div>
    </div>

    <!-- Bộ lọc tìm kiếm -->
    <div class="card card-custom p-3 mb-4 shadow-sm">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-7">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm theo mã hẹn, tên bệnh nhân, SĐT..." />
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">Tất cả trạng thái</option>
                    <option value="Unpaid" selected="@(ViewBag.Status == "Unpaid")">Chưa thanh toán</option>
                    <option value="Paid" selected="@(ViewBag.Status == "Paid")">Đã thanh toán</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 fw-bold">Lọc kết quả</button>
            </div>
        </form>
    </div>

    <!-- Bảng danh sách -->
    <div class="card card-custom p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Mã hẹn / Hóa đơn</th>
                        <th>Bệnh nhân</th>
                        <th>Bác sĩ / Chuyên khoa</th>
                        <th>Viện phí (VNĐ)</th>
                        <th>Trạng thái</th>
                        <th class="text-center pe-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    <span class="badge bg-light text-dark border font-monospace">@item.AppointmentCode</span>
                                    @if (!string.IsNullOrEmpty(item.InvoiceCode))
                                    {
                                        <div class="small text-muted font-monospace">@item.InvoiceCode</div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold">@(item.Patient?.FullName ?? "Chưa rõ")</div>
                                    <small class="text-muted">@(item.Patient?.PhoneNumber ?? "—")</small>
                                </td>
                                <td>
                                    <div>@(item.Doctor?.Title) @(item.Doctor?.User?.FullName)</div>
                                    <small class="text-muted">@(item.Specialty?.Name)</small>
                                </td>
                                <td class="fw-bold text-success">
                                    @((item.Doctor?.ConsultationFee ?? 0).ToString("N0")) đ
                                </td>
                                <td>
                                    @if (item.PaymentStatus == "Paid")
                                    {
                                        <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-bold">
                                            <i class="fa-solid fa-circle-check me-1"></i>Đã thanh toán (@(item.PaymentMethod == "Cash" ? "Tiền mặt" : "Chuyển khoản"))
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-dark px-3 py-2 rounded-pill fw-bold">
                                            <i class="fa-solid fa-clock me-1"></i>Chưa thanh toán
                                        </span>
                                    }
                                </td>
                                <td class="text-center pe-3">
                                    @if (item.PaymentStatus != "Paid")
                                    {
                                        <a asp-action="ProcessPayment" asp-route-id="@item.Id" class="btn btn-success btn-sm rounded-pill px-3 fw-bold">
                                            <i class="fa-solid fa-money-bill-wave me-1"></i>Thanh Toán
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="InvoiceReceipt" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold">
                                            <i class="fa-solid fa-print me-1"></i>In Phiếu Thu
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Không tìm thấy lịch hẹn hoặc hóa đơn phù hợp.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>