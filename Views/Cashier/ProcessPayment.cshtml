@model Healthy_System.Models.ViewModels.PaymentViewModel
@{
    Layout = "_ReceptionistLayout";
    ViewData["Title"] = "Xác Nhận Thanh Toán Viện Phí";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card card-custom p-4 p-md-5 border-success border-opacity-25 shadow-sm">
                <div class="text-center mb-4">
                    <div class="bg-success-subtle text-success d-inline-block p-3 rounded-circle mb-2">
                        <i class="fa-solid fa-cash-register fs-3"></i>
                    </div>
                    <h3 class="fw-bold text-success">Xác Nhận Thanh Toán Viện Phí</h3>
                    <p class="text-muted small">Mã hóa đơn dự kiến: <strong class="font-monospace text-dark">@Model.InvoiceCode</strong></p>
                </div>

                <div class="border rounded-4 p-3 bg-light mb-4">
                    <div class="row g-2 small">
                        <div class="col-6"><strong>Bệnh nhân:</strong> @Model.PatientName</div>
                        <div class="col-6"><strong>Số điện thoại:</strong> @Model.PatientPhone</div>
                        <div class="col-6"><strong>Bác sĩ khám:</strong> @Model.DoctorName</div>
                        <div class="col-6"><strong>Chuyên khoa:</strong> @Model.SpecialtyName</div>
                        <div class="col-12 pt-2 border-top mt-2 d-flex justify-content-between align-items-center">
                            <span class="fs-6 fw-bold">Tổng tiền cần thu:</span>
                            <span class="fs-4 fw-bold text-success">@Model.TotalAmount.ToString("N0") VNĐ</span>
                        </div>
                    </div>
                </div>

                <form asp-action="ProcessPayment" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="AppointmentId" />
                    <input type="hidden" asp-for="InvoiceCode" />
                    <input type="hidden" asp-for="TotalAmount" />

                    <!-- Tiêu chí 1: Chọn phương thức thanh toán -->
                    <div class="mb-4">
                        <label class="form-label fw-bold fs-6">Chọn phương thức thanh toán <span class="text-danger">*</span></label>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <input type="radio" class="btn-check" asp-for="PaymentMethod" id="methodCash" value="Cash" checked />
                                <label class="btn btn-outline-success w-100 py-3 rounded-3 fw-bold" for="methodCash">
                                    <i class="fa-solid fa-money-bill-1-wave fa-lg d-block mb-1"></i>Tiền mặt
                                </label>
                            </div>
                            <div class="col-md-6">
                                <input type="radio" class="btn-check" asp-for="PaymentMethod" id="methodBank" value="BankTransfer" />
                                <label class="btn btn-outline-primary w-100 py-3 rounded-3 fw-bold" for="methodBank">
                                    <i class="fa-solid fa-qrcode fa-lg d-block mb-1"></i>Chuyển khoản ngân hàng
                                </label>
                            </div>
                        </div>
                        <span asp-validation-for="PaymentMethod" class="text-danger small"></span>
                    </div>

                    <!-- Tiêu chí 4: Lưu vết nhân viên thu ngân thực hiện -->
                    <div class="mb-4">
                        <label class="form-label fw-bold">Nhân viên thu ngân / Kế toán thực hiện:</label>
                        <input asp-for="CashierName" class="form-control bg-light" readonly />
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Hủy bỏ</a>
                        <button type="submit" class="btn btn-success rounded-pill px-5 fw-bold shadow">
                            <i class="fa-solid fa-check-circle me-1"></i>XÁC NHẬN THANH TOÁN & IN PHIẾU
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>