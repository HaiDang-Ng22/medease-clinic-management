@model Appointment
@{
    ViewData["Title"] = "Hồ Sơ Bệnh Án & Đơn Thuốc - " + Model.AppointmentCode;
    var labResult = ViewBag.LabResult as Healthy_System.Models.LabResult;
}

<style>
    /* CSS In ấn chuẩn A4 y tế */
    @@media print {
        @@page {
            size: A4 portrait;
            margin: 10mm 12mm 12mm 12mm;
        }
        body {
            background: #ffffff !important;
            font-size: 11pt !important;
            color: #0f172a !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
        header, nav, footer, .top-bar, .navbar-main, .no-print, .alert, .btn-print-hide {
            display: none !important;
        }
        .main-content {
            padding: 0 !important;
            margin: 0 !important;
        }
        .container {
            max-width: 100% !important;
            width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }
        .record-card {
            border: 1px solid #cbd5e1 !important;
            box-shadow: none !important;
            padding: 24px !important;
            margin: 0 !important;
            border-radius: 0 !important;
        }
        .record-watermark {
            opacity: 0.05 !important;
        }
        a {
            text-decoration: none !important;
            color: inherit !important;
        }
    }

    /* Style cho giao diện hiển thị web */
    .record-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.08);
        position: relative;
    }
    .record-header-code {
        font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
        letter-spacing: 0.05em;
    }
    .record-section-title {
        font-size: 0.8125rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #0f766e;
        border-bottom: 2px solid #ccfbf1;
        padding-bottom: 6px;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .prescription-box {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-left: 4px solid #0f766e;
        font-family: 'SFMono-Regular', Consolas, monospace;
        font-size: 0.95rem;
        line-height: 1.7;
        white-space: pre-wrap;
        color: #0f172a;
    }
    .seal-badge {
        display: inline-block;
        border: 2px dashed #0f766e;
        color: #0f766e;
        padding: 8px 16px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 0.8125rem;
        text-align: center;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        background: #f0fdfa;
    }
</style>

<!-- Thanh công cụ điều khiển (ẩn khi in) -->
<div class="bg-dark text-white py-3 no-print border-bottom">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-success px-2 py-1">US11 Hoàn thành</span>
                    <h5 class="fw-bold mb-0 text-white">Hồ Sơ Bệnh Án & Đơn Thuốc PDF</h5>
                </div>
                <small class="text-white-50">Mã tra cứu ca khám: <strong class="text-white font-monospace">@Model.AppointmentCode</strong></small>
            </div>
            <div class="d-flex gap-2">
                <!-- Nút Tải về PDF -->
                <button type="button" id="btnDownloadPdf" onclick="downloadPdf()" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm d-inline-flex align-items-center gap-2">
                    <i class="fa-solid fa-file-pdf"></i>
                    <span>Tải Về File PDF</span>
                </button>
                <!-- Nút In trực tiếp -->
                <button type="button" onclick="window.print()" class="btn btn-outline-light rounded-pill px-4 fw-semibold d-inline-flex align-items-center gap-2">
                    <i class="fa-solid fa-print"></i>
                    <span>In Phiếu Khám</span>
                </button>
                <!-- Quay lại -->
                <a asp-action="MyAppointments" class="btn btn-outline-secondary rounded-pill px-3 text-white-50">
                    <i class="fa-solid fa-arrow-left me-1"></i>Trở Về
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">

            <!-- VÙNG NỘI DUNG HỒ SƠ BỆNH ÁN & ĐƠN THUỐC DÙNG ĐỂ IN VÀ XUẤT PDF -->
            <div id="printableRecord" class="record-card p-4 p-md-5">

                <!-- 1. Header Phòng Khám & Tiêu Đề Phiếu -->
                <div class="row align-items-center pb-4 mb-4 border-bottom border-2">
                    <div class="col-sm-7">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <div style="width:34px; height:34px; background:#0f766e; color:#fff; border-radius:6px; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:1.1rem;">
                                <i class="fa-solid fa-plus"></i>
                            </div>
                            <span class="fs-4 fw-bold text-dark tracking-tight">PHÒNG KHÁM ĐA KHOA MEDEASE</span>
                        </div>
                        <div class="text-muted small">Hệ thống Y tế & Chăm sóc Sức khỏe Tiêu chuẩn Quốc tế</div>
                        <div class="text-muted small">Giấy phép hoạt động số: <strong>01842/HCM-GPHĐ</strong> do Sở Y Tế cấp</div>
                        <div class="text-muted small">Địa chỉ: 280 An Dương Vương, P.4, Q.5, TP.HCM | Hotline: <strong>1900 8888</strong></div>
                    </div>
                    <div class="col-sm-5 text-sm-end mt-3 mt-sm-0">
                        <div class="text-uppercase fw-bold text-primary mb-1" style="font-size:0.875rem; letter-spacing:0.04em;">Phiếu Khám Chữa Bệnh</div>
                        <h4 class="fw-bold text-dark mb-1">HỒ SƠ BỆNH ÁN & ĐƠN THUỐC</h4>
                        <div class="mt-2">
                            <span class="badge px-3 py-2 fs-6 fw-bold border record-header-code" style="background:#f0fdfa; color:#0f766e; border-color:#99f6e4 !important;">
                                @Model.AppointmentCode
                            </span>
                        </div>
                        <div class="text-muted small mt-1">Ngày in: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                </div>

                <!-- 2. Thông Tin Bệnh Nhân -->
                <div class="mb-4">
                    <div class="record-section-title">
                        <i class="fa-solid fa-address-card"></i>
                        <span>I. THÔNG TIN HÀNH CHÍNH BỆNH NHÂN</span>
                    </div>
                    <div class="row g-3 p-3 bg-light rounded-3 border">
                        <div class="col-md-6">
                            <span class="text-muted small d-block">Họ và tên bệnh nhân:</span>
                            <span class="fs-6 fw-bold text-dark">@(Model.Patient?.FullName ?? "Chưa có tên")</span>
                        </div>
                        <div class="col-md-3">
                            <span class="text-muted small d-block">Giới tính:</span>
                            <span class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(Model.Patient?.Gender) ? "N/A" : Model.Patient?.Gender)</span>
                        </div>
                        <div class="col-md-3">
                            <span class="text-muted small d-block">Ngày sinh:</span>
                            <span class="fw-semibold text-dark">@(Model.Patient?.DateOfBirth?.ToString("dd/MM/yyyy") ?? "N/A")</span>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted small d-block">Số điện thoại liên hệ:</span>
                            <span class="fw-semibold text-dark font-monospace">@(Model.Patient?.PhoneNumber ?? "Chưa cung cấp")</span>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted small d-block">Địa chỉ:</span>
                            <span class="fw-semibold text-dark">@(Model.Patient?.Address ?? "TP. Hồ Chí Minh")</span>
                        </div>
                        <div class="col-12 pt-2 border-top">
                            <span class="text-muted small d-block">Lý do đến khám / Triệu chứng ban đầu:</span>
                            <span class="fw-semibold text-danger">@Model.ReasonForVisit</span>
                        </div>
                    </div>
                </div>

                <!-- 3. Kết Quả Khám Lâm Sàng & Chẩn Đoán -->
                <div class="mb-4">
                    <div class="record-section-title">
                        <i class="fa-solid fa-stethoscope"></i>
                        <span>II. KẾT QUẢ KHÁM LÂM SÀNG & CHẨN ĐOÁN XÁC ĐỊNH</span>
                    </div>
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="row g-3 mb-2">
                            <div class="col-md-6">
                                <span class="text-muted small d-block">Bác sĩ phụ trách khám:</span>
                                <span class="fw-bold text-dark">@Model.Doctor?.Title @Model.Doctor?.User?.FullName</span>
                            </div>
                            <div class="col-md-6">
                                <span class="text-muted small d-block">Chuyên khoa:</span>
                                <span class="fw-bold text-teal" style="color:#0f766e;">@Model.Specialty?.Name</span>
                            </div>
                            <div class="col-md-6">
                                <span class="text-muted small d-block">Thời gian khám:</span>
                                <span class="text-dark">@Model.AppointmentDate.ToString("dd/MM/yyyy") (Khung giờ: <strong>@Model.TimeSlot</strong>)</span>
                            </div>
                            <div class="col-md-6">
                                <span class="text-muted small d-block">Trạng thái hồ sơ:</span>
                                <span class="badge bg-success-subtle text-success px-2 py-1 fw-bold">Hoàn tất buổi khám</span>
                            </div>
                        </div>
                        <div class="pt-3 border-top">
                            <span class="text-muted small d-block mb-1">Kết luận chẩn đoán:</span>
                            <div class="fs-6 fw-bold text-primary p-2 bg-white rounded border">
                                @(string.IsNullOrWhiteSpace(Model.Diagnosis) ? "Chưa ghi nhận chẩn đoán chi tiết" : Model.Diagnosis)
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.LabRequest))
                        {
                            <div class="mt-3 pt-2 border-top small">
                                <span class="fw-bold text-secondary"><i class="fa-solid fa-microscope me-1"></i>Chỉ định Cận lâm sàng / Xét nghiệm:</span>
                                <span class="text-dark ms-1">@Model.LabRequest</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- 4. Kết Quả Cận Lâm Sàng (Nếu có) -->
                @if (labResult != null)
                {
                    <div class="mb-4">
                        <div class="record-section-title">
                            <i class="fa-solid fa-flask-vial"></i>
                            <span>III. KẾT QUẢ CẬN LÂM SÀNG / XÉT NGHIỆM</span>
                        </div>
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="row g-2 mb-2">
                                <div class="col-md-6">
                                    <span class="text-muted small d-block">Kỹ thuật viên thực hiện:</span>
                                    <span class="fw-bold text-dark">@(labResult.LabTech?.FullName ?? "KTV Phòng Cận Lâm Sàng")</span>
                                </div>
                                <div class="col-md-6 text-md-end">
                                    <span class="text-muted small d-block">Ngày trả kết quả:</span>
                                    <span class="text-dark">@labResult.ResultDate.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                            </div>
                            <div class="mb-2">
                                <span class="text-muted small d-block">Tóm tắt kết luận xét nghiệm:</span>
                                <div class="fw-bold text-dark p-2 bg-white rounded border">
                                    @labResult.ResultSummary
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(labResult.DetailedResult))
                            {
                                <div class="mb-2">
                                    <span class="text-muted small d-block">Chỉ số xét nghiệm chi tiết:</span>
                                    <div class="small p-2 bg-white rounded border font-monospace" style="white-space:pre-wrap;">@labResult.DetailedResult</div>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(labResult.ImageFilePath))
                            {
                                <div class="mt-2 text-center p-2 bg-white rounded border">
                                    <img src="@labResult.ImageFilePath" alt="Ảnh kết quả cận lâm sàng" class="img-fluid rounded" style="max-height: 250px;" />
                                    <div class="small text-muted mt-1">Ảnh đính kèm: @labResult.ImageFileName</div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- 5. Đơn Thuốc Điều Trị (e-Prescription) -->
                <div class="mb-4">
                    <div class="record-section-title">
                        <i class="fa-solid fa-pills"></i>
                        <span>IV. ĐƠN THUỐC ĐIỀU TRỊ ĐIỆN TỬ</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.Prescription))
                    {
                        <div class="prescription-box p-3 p-md-4 rounded-3">
@Model.Prescription
                        </div>
                        <div class="text-muted small mt-2 fst-italic">
                            * Bệnh nhân vui lòng dùng thuốc đúng liều lượng, đúng thời gian theo hướng dẫn của bác sĩ. Không tự ý ngưng hoặc đổi thuốc.
                        </div>
                    }
                    else
                    {
                        <div class="p-3 bg-light text-muted rounded-3 border fst-italic">
                            Ca khám không kê đơn thuốc hoặc sử dụng phác đồ theo dõi ngoại trú không dùng thuốc.
                        </div>
                    }
                </div>

                <!-- 6. Lời Dặn Của Bác Sĩ -->
                @if (!string.IsNullOrWhiteSpace(Model.DoctorNotes))
                {
                    <div class="mb-4">
                        <div class="record-section-title">
                            <i class="fa-solid fa-clipboard-check"></i>
                            <span>V. LỜI DẶN DÒ & CHẾ ĐỘ SINH HOẠT</span>
                        </div>
                        <div class="p-3 bg-light rounded-3 text-dark border">
                            @Model.DoctorNotes
                        </div>
                    </div>
                }

                <!-- 7. Xác Nhận & Chữ Ký -->
                <div class="row pt-4 mt-3 border-top">
                    <div class="col-6 text-center">
                        <div class="text-muted small">BỆNH NHÂN / NGƯỜI NHÀ</div>
                        <small class="text-muted fst-italic">(Ký và ghi rõ họ tên)</small>
                        <div style="height: 70px;"></div>
                        <div class="fw-semibold text-dark">@(Model.Patient?.FullName ?? "")</div>
                    </div>
                    <div class="col-6 text-center">
                        <div class="text-muted small">Ngày @DateTime.Now.Day tháng @DateTime.Now.Month năm @DateTime.Now.Year</div>
                        <div class="fw-bold text-dark">BÁC SĨ KHÁM BỆNH</div>
                        <div class="my-2">
                            <div class="seal-badge">
                                <i class="fa-solid fa-stamp me-1"></i>MEDEASE CLINIC<br>
                                <small style="font-size:0.65rem;">CHỨNG THỰC ĐIỆN TỬ</small>
                            </div>
                        </div>
                        <div class="fw-bold text-primary mt-1">@Model.Doctor?.Title @Model.Doctor?.User?.FullName</div>
                        <small class="text-muted">Chuyên khoa: @Model.Specialty?.Name</small>
                    </div>
                </div>

            </div>
            <!-- KẾT THÚC VÙNG NỘI DUNG XUẤT PDF -->

        </div>
    </div>
</div>

@section Scripts {
    <!-- Thư viện html2pdf.bundle.min.js để xuất file PDF cục bộ không phụ thuộc mạng -->
    <script src="~/js/html2pdf.bundle.min.js"></script>
    <script>
        function downloadPdf() {
            const btn = document.getElementById('btnDownloadPdf');
            const originalContent = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i><span>Đang tạo PDF...</span>';

            const element = document.getElementById('printableRecord');
            const code = '@Model.AppointmentCode';
            
            const opt = {
                margin:       [8, 10, 8, 10],
                filename:     'Ho_So_Benh_An_' + code + '.pdf',
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { 
                    scale: 2, 
                    useCORS: true, 
                    letterRendering: true,
                    logging: false
                },
                jsPDF: { 
                    unit: 'mm', 
                    format: 'a4', 
                    orientation: 'portrait' 
                }
            };

            // Thực hiện chuyển đổi và tải về
            html2pdf().set(opt).from(element).save().then(() => {
                btn.disabled = false;
                btn.innerHTML = originalContent;
            }).catch(err => {
                console.error('Lỗi khi xuất PDF:', err);
                btn.disabled = false;
                btn.innerHTML = originalContent;
                alert('Có lỗi xảy ra khi tạo file PDF. Bạn có thể sử dụng nút "In Phiếu Khám" và chọn "Lưu dưới dạng PDF" (Save as PDF) của trình duyệt.');
            });
        }
    </script>
}
