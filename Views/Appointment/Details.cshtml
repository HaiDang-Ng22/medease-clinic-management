@model Appointment
@{
    ViewData["Title"] = "Phiếu Hẹn Khám " + Model.AppointmentCode;
    bool canModify = ViewBag.CanModify ?? false;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Printable Voucher -->
            <div class="card card-custom p-4 p-md-5 border-2 shadow-sm" id="printableCard">
                <!-- Header -->
                <div class="d-flex justify-content-between align-items-center border-bottom pb-4 mb-4">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="fa-solid fa-hospital-user text-primary fs-3"></i>
                            <h4 class="fw-bold mb-0 text-primary">PHÒNG KHÁM HEALTHY SYSTEM</h4>
                        </div>
                        <small class="text-muted">280 An Dương Vương, P.4, Q.5, TP.HCM | Hotline: 1900 8888</small>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-light text-primary border px-3 py-2 fs-6 fw-bold">
                            @Model.AppointmentCode
                        </span>
                        <div class="text-muted small mt-1">Ngày lập: @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</div>
                    </div>
                </div>

                <div class="text-center mb-4">
                    <h3 class="fw-bold text-dark">PHIẾU HẸN KHÁM BỆNH TRỰC TUYẾN</h3>
                    <div>
                        @switch (Model.Status)
                        {
                            case "Confirmed":
                                <span class="badge bg-success px-3 py-2 rounded-pill fs-6"><i class="fa-solid fa-circle-check me-1"></i>Đã Xác Nhận</span>
                                break;
                            case "Pending":
                                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fs-6"><i class="fa-solid fa-clock me-1"></i>Chờ Xác Nhận Tiếp Nhận</span>
                                break;
                            case "Completed":
                                <span class="badge bg-primary px-3 py-2 rounded-pill fs-6"><i class="fa-solid fa-square-check me-1"></i>Đã Hoàn Thành Buổi Khám</span>
                                break;
                            case "Cancelled":
                                <span class="badge bg-danger px-3 py-2 rounded-pill fs-6"><i class="fa-solid fa-ban me-1"></i>Đã Hủy Lịch</span>
                                break;
                        }
                    </div>
                </div>

                <!-- Info Grid -->
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <div class="border rounded-4 p-3 h-100 bg-light">
                            <h6 class="fw-bold text-primary mb-3"><i class="fa-solid fa-user me-2"></i>Thông Tin Bệnh Nhân</h6>
                            <div class="mb-2"><strong>Họ và tên:</strong> @Model.Patient?.FullName</div>
                            <div class="mb-2"><strong>Số điện thoại:</strong> @Model.Patient?.PhoneNumber</div>
                            <div class="mb-2"><strong>Giới tính:</strong> @Model.Patient?.Gender</div>
                            <div class="mb-0"><strong>Ngày sinh:</strong> @(Model.Patient?.DateOfBirth?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border rounded-4 p-3 h-100 bg-light">
                            <h6 class="fw-bold text-secondary mb-3"><i class="fa-solid fa-user-doctor me-2"></i>Thông Tin Khám</h6>
                            <div class="mb-2"><strong>Bác sĩ khám:</strong> @Model.Doctor?.Title @Model.Doctor?.User?.FullName</div>
                            <div class="mb-2"><strong>Chuyên khoa:</strong> @Model.Specialty?.Name</div>
                            <div class="mb-2"><strong>Phòng khám:</strong> @Model.Doctor?.RoomNumber</div>
                            <div class="mb-0"><strong>Phí khám:</strong> @Model.Doctor?.ConsultationFee.ToString("N0") VNĐ</div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="border border-primary border-opacity-25 rounded-4 p-3 bg-primary-subtle text-dark">
                            <div class="row text-center">
                                <div class="col-6 border-end">
                                    <div class="text-muted small">NGÀY HẸN KHÁM</div>
                                    <div class="fs-4 fw-bold text-primary">@Model.AppointmentDate.ToString("dd/MM/yyyy")</div>
                                </div>
                                <div class="col-6">
                                    <div class="text-muted small">KHUNG GIỜ KHÁM</div>
                                    <div class="fs-4 fw-bold text-primary">@Model.TimeSlot</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="border rounded-4 p-3">
                            <strong>Lý do khám / Triệu chứng ban đầu:</strong>
                            <p class="text-muted mb-0 mt-1">@Model.ReasonForVisit</p>
                        </div>
                    </div>
                </div>

                <!-- Footer note -->
                <div class="alert alert-secondary rounded-3 small mb-4">
                    <strong>Lưu ý quan trọng:</strong>
                    <ul class="mb-0 ps-3">
                        <li>Quý khách vui lòng có mặt tại quầy Lễ tân trước giờ hẹn <strong>15 phút</strong> và xuất trình mã <strong>@Model.AppointmentCode</strong>.</li>
                        <li>Trường hợp cần thay đổi hoặc hủy lịch, vui lòng thực hiện trước giờ khám ít nhất <strong>2 tiếng</strong>.</li>
                    </ul>
                </div>

                <!-- Actions -->
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-3 border-top d-print-none">
                    <a asp-action="MyAppointments" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="fa-solid fa-arrow-left me-1"></i>Lịch hẹn của tôi
                    </a>

                    <div class="d-flex gap-2">
                        <button onclick="window.print()" class="btn btn-outline-primary rounded-pill px-4">
                            <i class="fa-solid fa-print me-1"></i>In phiếu hẹn
                        </button>

                        @if (canModify)
                        {
                            <a asp-action="Reschedule" asp-route-id="@Model.Id" class="btn btn-outline-warning text-dark rounded-pill px-3">
                                <i class="fa-solid fa-arrows-rotate me-1"></i>Đổi giờ khám
                            </a>
                            <a asp-action="Cancel" asp-route-id="@Model.Id" class="btn btn-outline-danger rounded-pill px-3">
                                <i class="fa-solid fa-xmark me-1"></i>Hủy lịch
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
