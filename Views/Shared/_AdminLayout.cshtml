<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin | Healthy System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f1f5f9; min-height: 100vh; display: flex; flex-direction: column; }
        .admin-navbar { background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%); box-shadow: 0 4px 15px rgba(0,0,0,0.2); padding: 12px 0; }
        .admin-brand { color: #ffffff !important; font-weight: 800; font-size: 1.35rem; display: flex; align-items: center; gap: 10px; text-decoration: none; }
        .admin-brand-badge { background-color: #7c3aed; color: white; font-size: 0.72rem; padding: 4px 12px; border-radius: 9999px; text-transform: uppercase; letter-spacing: 0.05em; }
        .admin-nav-link { color: #c4b5fd !important; font-weight: 600; padding: 8px 16px !important; border-radius: 8px; transition: all 0.2s; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
        .admin-nav-link:hover, .admin-nav-link.active { color: #ffffff !important; background-color: rgba(255,255,255,0.12); }
        footer { margin-top: auto; background: #1e1b4b; color: #a5b4fc; padding: 20px 0; font-size: 0.85rem; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg admin-navbar sticky-top">
        <div class="container-fluid px-4">
            <a class="admin-brand" asp-controller="Admin" asp-action="Dashboard">
                <i class="fa-solid fa-shield-halved text-violet-300 fs-3" style="color:#a78bfa"></i>
                <span>HEALTHY<span style="color:#a78bfa">SYSTEM</span></span>
                <span class="admin-brand-badge ms-2"><i class="fa-solid fa-user-shield me-1"></i>QUẢN TRỊ</span>
            </a>
            <button class="navbar-toggler text-white border-0" type="button" data-bs-toggle="collapse" data-bs-target="#adminNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="adminNav">
                <ul class="navbar-nav me-auto ms-4 mb-2 mb-lg-0 gap-1">
                    <li class="nav-item">
                        <a class="admin-nav-link" asp-controller="Admin" asp-action="Dashboard">
                            <i class="fa-solid fa-gauge-high"></i>Dashboard & Người Dùng
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="admin-nav-link" asp-controller="Admin" asp-action="Services">
                            <i class="fa-solid fa-list-check"></i>Dịch Vụ & Biểu Giá
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="admin-nav-link" asp-controller="Admin" asp-action="Equipments">
                            <i class="fa-solid fa-microscope"></i>Trang Thiết Bị Y Tế
                        </a>
                    </li>
                </ul>
                <div class="d-flex align-items-center gap-3">
                    <div class="text-end text-white d-none d-md-block">
                        <div class="fw-bold fs-6">@User.Identity?.Name</div>
                        <small style="color:#a78bfa">Quản Trị Viên</small>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-2 fw-semibold">
                            <i class="fa-solid fa-right-from-bracket me-1"></i>Đăng Xuất
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </nav>

    <div class="container-fluid px-4 mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="fa-solid fa-circle-check fs-4 me-3 text-success"></i>
                <div class="flex-grow-1">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="fa-solid fa-triangle-exclamation fs-4 me-3 text-danger"></i>
                <div class="flex-grow-1">@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <main class="container-fluid px-4 py-3 flex-grow-1">
        @RenderBody()
    </main>

    <footer>
        <div class="container-fluid px-4 text-center">
            <span>&copy; 2026 Cổng Quản Trị Hệ Thống - Phòng Khám Healthy System.</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
