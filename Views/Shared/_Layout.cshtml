<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Phòng Khám Đa Khoa MedEase</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary: #0f766e;
            --primary-hover: #115e59;
            --primary-light: #f0fdfa;
            --secondary: #0284c7;
            --dark: #0f172a;
            --gray-100: #f8fafc;
            --gray-200: #e2e8f0;
            --gray-600: #475569;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            color: #334155;
            background-color: #f8fafc;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .main-content {
            flex: 1;
        }

        /* Top Bar */
        .top-bar {
            background-color: #0f172a;
            color: #94a3b8;
            font-size: 0.8125rem;
            padding: 8px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }
        .top-bar a {
            color: #cbd5e1;
            text-decoration: none;
            transition: color 0.15s;
        }
        .top-bar a:hover {
            color: #2dd4bf;
        }

        /* Navbar */
        .navbar-main {
            background: #ffffff;
            border-bottom: 1px solid var(--gray-200);
            padding: 12px 0;
        }
        .navbar-brand {
            font-weight: 800;
            font-size: 1.25rem;
            color: var(--dark) !important;
            display: flex;
            align-items: center;
            gap: 10px;
            letter-spacing: -0.02em;
        }
        .brand-monogram {
            width: 34px;
            height: 34px;
            border-radius: 6px;
            background-color: #0f766e;
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
        }
        .nav-link {
            font-weight: 500;
            color: #334155 !important;
            padding: 6px 14px !important;
            border-radius: 6px;
            font-size: 0.875rem;
            white-space: nowrap;
            transition: color 0.15s, background-color 0.15s;
        }
        .nav-link:hover, .nav-link.active {
            color: #0f766e !important;
            background-color: #f0fdfa;
        }
        .btn-booking {
            background-color: var(--primary);
            color: #ffffff !important;
            font-weight: 600;
            border: 1px solid var(--primary);
            border-radius: 6px;
            padding: 8px 18px;
            font-size: 0.875rem;
            transition: background-color 0.18s;
            white-space: nowrap;
            text-decoration: none;
        }
        .btn-booking:hover {
            background-color: var(--primary-hover);
            color: #ffffff !important;
        }

        /* Search bar */
        .navbar-search-wrap {
            position: relative;
            width: 200px;
        }
        .navbar-search-wrap input {
            border-radius: 6px;
            border: 1px solid var(--gray-200);
            padding: 6px 32px 6px 12px;
            font-size: 0.8125rem;
            width: 100%;
            outline: none;
            background: #f8fafc;
        }
        .navbar-search-wrap input:focus {
            border-color: var(--primary);
            background: #ffffff;
        }
        .navbar-search-wrap .search-btn {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--gray-600);
            cursor: pointer;
            padding: 0;
            font-size: 0.8125rem;
        }

        /* Hero */
        .hero-section {
            background-color: #091e1b;
            color: #ffffff;
            padding: 72px 0 60px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        /* Card Styles */
        .card-custom {
            border: 1px solid var(--gray-200);
            border-radius: 8px;
            background: #ffffff;
            transition: border-color 0.2s;
        }
        .card-custom:hover {
            border-color: #0d9488;
        }

        /* Section Titles */
        .section-title {
            font-weight: 800;
            color: var(--dark);
            margin-bottom: 12px;
            letter-spacing: -0.02em;
        }

        /* Footer */
        footer {
            background-color: #0f172a;
            color: #94a3b8;
            padding: 56px 0 24px;
            margin-top: 56px;
            border-top: 1px solid #1e293b;
        }
        footer h5 {
            color: #ffffff;
            font-weight: 700;
            font-size: 0.9375rem;
            margin-bottom: 16px;
        }
        footer a {
            color: #94a3b8;
            text-decoration: none;
            transition: color 0.15s;
        }
        footer a:hover {
            color: #2dd4bf;
        }
        .footer-bottom {
            border-top: 1px solid #1e293b;
            padding-top: 20px;
            margin-top: 36px;
            font-size: 0.8125rem;
        }
    </style>
</head>
<body data-ui="public-site">
    <!-- Top Bar -->
    <div class="top-bar d-none d-md-block">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex gap-4">
                <span><i class="fa-solid fa-location-dot text-teal me-2" style="color:#2dd4bf;"></i>280 An Dương Vương, P.4, Q.5, TP. Hồ Chí Minh</span>
                <span><i class="fa-solid fa-clock text-teal me-2" style="color:#2dd4bf;"></i>Giờ làm việc: Thứ 2 - Thứ 7 (07:30 - 20:00)</span>
            </div>
            <div class="d-flex gap-3 align-items-center">
                <a href="tel:19008888" class="fw-semibold"><i class="fa-solid fa-phone me-1" style="color:#2dd4bf;"></i>Hotline: 1900 8888</a>
                <span class="text-secondary opacity-50">|</span>
                <a href="/Home/Contact">Liên hệ & Tư vấn</a>
            </div>
        </div>
    </div>

    <!-- Main Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-main sticky-top">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <div class="brand-monogram">
                    <i class="fa-solid fa-plus"></i>
                </div>
                <span>MedEase</span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Specialties">Chuyên khoa</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Doctors">Đội ngũ bác sĩ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Services">Dịch vụ & Biểu giá</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Equipment">Thiết bị y tế</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Contact">Liên hệ</a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-2">
                    <form asp-controller="Home" asp-action="Search" method="get" class="navbar-search-wrap d-none d-xl-flex me-2">
                        <input type="text" name="q" placeholder="Tìm bác sĩ, chuyên khoa..." autocomplete="off" />
                        <button type="submit" class="search-btn" title="Tìm kiếm">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </button>
                    </form>

                    @if (User.IsInRole("Doctor"))
                    {
                        <a asp-controller="Doctor" asp-action="Dashboard" class="btn btn-sm btn-primary rounded-1 px-3 py-2 fw-semibold" style="background:#0284c7; border-color:#0284c7;">
                            <i class="fa-solid fa-user-doctor me-1"></i>Cổng Bác Sĩ
                        </a>
                    }
                    else if (User.IsInRole("Receptionist"))
                    {
                        <a asp-controller="Receptionist" asp-action="Dashboard" class="btn btn-sm btn-primary rounded-1 px-3 py-2 fw-semibold" style="background:#0f766e; border-color:#0f766e;">
                            <i class="fa-solid fa-clipboard-user me-1"></i>Bàn Lễ Tân
                        </a>
                    }
                    else if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-sm btn-dark rounded-1 px-3 py-2 fw-semibold" style="background:#0f172a; border-color:#0f172a;">
                            <i class="fa-solid fa-shield-halved me-1"></i>Quản Trị
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Appointment" asp-action="Book" class="btn btn-booking">
                            <i class="fa-solid fa-calendar-check me-1"></i>Đặt Lịch Khám
                        </a>
                    }

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown ms-1">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle rounded-1 px-3 py-2 fw-semibold" type="button" data-bs-toggle="dropdown" style="border-color:#cbd5e1; color:#334155;">
                                <i class="fa-regular fa-circle-user me-1"></i>
                                @User.Identity.Name
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end border rounded-2 mt-2" style="min-width: 220px; border-color:#e2e8f0;">
                                <li>
                                    <div class="px-3 py-2 border-bottom" style="border-color:#e2e8f0 !important;">
                                        <div class="fw-bold text-dark">@User.Identity.Name</div>
                                        <small class="text-muted">
                                            @(User.IsInRole("Doctor") ? "Bác sĩ Chuyên khoa" : (User.IsInRole("Receptionist") ? "Nhân viên Lễ tân" : (User.IsInRole("Admin") ? "Quản trị viên" : "Bệnh nhân")))
                                        </small>
                                    </div>
                                </li>

                                @if (User.IsInRole("Doctor"))
                                {
                                    <li><a class="dropdown-item py-2" asp-controller="Doctor" asp-action="Dashboard"><i class="fa-solid fa-gauge-high me-2 text-muted"></i>Bàn làm việc</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Doctor" asp-action="Queue"><i class="fa-solid fa-list-ol me-2 text-muted"></i>Hàng đợi khám</a></li>
                                }
                                else if (User.IsInRole("Receptionist"))
                                {
                                    <li><a class="dropdown-item py-2" asp-controller="Receptionist" asp-action="Dashboard"><i class="fa-solid fa-desktop me-2 text-muted"></i>Bàn tiếp đón</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Receptionist" asp-action="Appointments"><i class="fa-solid fa-calendar-check me-2 text-muted"></i>Toàn bộ lịch hẹn</a></li>
                                }
                                else
                                {
                                    <li><a class="dropdown-item py-2" asp-controller="Appointment" asp-action="MyAppointments"><i class="fa-solid fa-calendar-days me-2 text-muted"></i>Lịch hẹn của tôi</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Appointment" asp-action="MyAppointments" asp-route-status="Completed"><i class="fa-solid fa-folder-medical me-2 text-muted"></i>Hồ sơ bệnh án</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile"><i class="fa-solid fa-id-card me-2 text-muted"></i>Hồ sơ cá nhân</a></li>
                                }
                                <li><hr class="dropdown-divider my-1"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item py-2 text-danger">
                                            <i class="fa-solid fa-arrow-right-from-bracket me-2"></i>Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex gap-2 ms-1">
                            <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-secondary rounded-1 px-3 py-2 fw-semibold" style="border-color:#cbd5e1; color:#334155;">Đăng nhập</a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-sm btn-dark rounded-1 px-3 py-2 fw-semibold" style="background:#0f172a; border-color:#0f172a;">Đăng ký</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- Global Alert Messages -->
    <div class="container mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-2 border-0 d-flex align-items-center mb-0" role="alert" style="background:#ecfdf5; color:#065f46; border-left:4px solid #10b981 !important;">
                <i class="fa-solid fa-circle-check fs-5 me-2" style="color:#059669;"></i>
                <div class="flex-grow-1">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-2 border-0 d-flex align-items-center mb-0" role="alert" style="background:#fef2f2; color:#991b1b; border-left:4px solid #ef4444 !important;">
                <i class="fa-solid fa-circle-exclamation fs-5 me-2" style="color:#dc2626;"></i>
                <div class="flex-grow-1">@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <!-- Body Content -->
    <main class="main-content">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer>
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="brand-monogram">
                            <i class="fa-solid fa-plus"></i>
                        </div>
                        <span class="fs-4 fw-bold text-white">MedEase</span>
                    </div>
                    <p class="text-muted pe-lg-4" style="font-size:0.875rem; line-height:1.6;">
                        Hệ thống phòng khám đa khoa tư nhân ứng dụng quy chuẩn số hóa tiếp nhận và điều trị. Đồng bộ hồ sơ bệnh án, đặt lịch trực tuyến và quản lý chuyên khoa.
                    </p>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h5>Danh Mục</h5>
                    <ul class="list-unstyled" style="font-size:0.875rem;">
                        <li class="mb-2"><a href="/Home/Specialties">Chuyên khoa khám</a></li>
                        <li class="mb-2"><a href="/Home/Doctors">Đội ngũ bác sĩ</a></li>
                        <li class="mb-2"><a href="/Home/Services">Bảng giá dịch vụ</a></li>
                        <li class="mb-2"><a href="/Home/Equipment">Trang thiết bị</a></li>
                        <li class="mb-2"><a href="/Appointment/Book">Đặt lịch khám</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h5>Thời Gian Làm Việc</h5>
                    <ul class="list-unstyled text-muted" style="font-size:0.875rem;">
                        <li class="mb-2"><strong class="text-white">Thứ 2 - Thứ 7:</strong> 07:30 - 20:00</li>
                        <li class="mb-2"><strong class="text-white">Chủ Nhật:</strong> 08:00 - 12:00</li>
                        <li class="mb-2"><strong class="text-white">Đặt lịch hẹn:</strong> 24/7 qua cổng trực tuyến</li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h5>Địa Chỉ & Hotline</h5>
                    <ul class="list-unstyled text-muted" style="font-size:0.875rem;">
                        <li class="mb-2"><i class="fa-solid fa-location-dot me-2" style="color:#2dd4bf;"></i>280 An Dương Vương, P.4, Q.5, TP.HCM</li>
                        <li class="mb-2"><i class="fa-solid fa-phone me-2" style="color:#2dd4bf;"></i>Tổng đài: 1900 8888</li>
                        <li class="mb-2"><i class="fa-solid fa-envelope me-2" style="color:#2dd4bf;"></i>contact@healthysystem.vn</li>
                    </ul>
                </div>
            </div>

            <div class="footer-bottom d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                <div>&copy; 2026 MedEase · Hệ Thống Quản Lý Phòng Khám Tư Nhân</div>
                <div>Đồ án môn Công nghệ Phần mềm Nâng cao · ASP.NET Core 8 & PostgreSQL</div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
