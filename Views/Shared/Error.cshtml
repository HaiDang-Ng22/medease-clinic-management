@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi";
}

<div class="container py-5 text-center">
    <div class="card card-custom p-5 mx-auto" style="max-width: 600px;">
        <i class="fa-solid fa-triangle-exclamation text-danger display-1 mb-3"></i>
        <h2 class="fw-bold mb-3">Đã xảy ra sự cố!</h2>
        <p class="text-muted mb-4">Hệ thống ghi nhận lỗi trong quá trình xử lý yêu cầu của bạn. Vui lòng thử lại hoặc liên hệ quản trị viên.</p>
        @if (Model.ShowRequestId)
        {
            <div class="badge bg-light text-dark p-2 mb-4 border">Request ID: <code>@Model.RequestId</code></div>
        }
        <div>
            <a href="/" class="btn btn-primary rounded-pill px-4">Quay về trang chủ</a>
        </div>
    </div>
</div>
