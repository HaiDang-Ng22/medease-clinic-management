<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bàn Tiếp Đón Lễ Tân | Healthy System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .reception-navbar {
            background: #064e3b;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            padding: 12px 0;
        }
        .reception-brand {
            color: #ffffff !important;
            font-weight: 800;
            font-size: 1.35rem;
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }
        .reception-brand-badge {
            background-color: #059669;
            color: white;
            font-size: 0.75rem;
            padding: 4px 10px;
            border-radius: 9999px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .reception-nav-link {
            color: #a7f3d0 !important;
            font-weight: 600;
            padding: 6px 12px !important;
            border-radius: 8px;
            transition: all 0.2s;
            text-decoration: none;
            font-size: 0.875rem;
            white-space: nowrap;
        }
        .reception-nav-link:hover, .reception-nav-link.active {
            color: #ffffff !important;
            background-color: rgba(255,255,255,0.15);
        }
        .card-reception {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.03);
        }
        footer {
            margin-top: auto;
            background: #064e3b;
            color: #a7f3d0;
            padding: 16px 0;
            font-size: 0.85rem;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg reception-navbar sticky-top">
        <div class="container-fluid px-4">
            <a class="reception-brand" asp-controller="Receptionist" asp-action="Dashboard">
                <i class="fa-solid fa-headset text-warning fs-3"></i>
                <span>HEALTHY<span class="text-warning">SYSTEM</span></span>
                <span class="reception-brand-badge ms-2"><i class="fa-solid fa-clipboard-user me-1"></i>BÀN LỄ TÂN</span>
            </a>
            <button class="navbar-toggler text-white" type="button" data-bs-toggle="collapse" data-bs-target="#receptionNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="receptionNav">
                <ul class="navbar-nav me-auto ms-4 mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="reception-nav-link" asp-controller="Receptionist" asp-action="Dashboard">
                            <i class="fa-solid fa-desktop me-1"></i>Bàn Tiếp Đón Hôm Nay
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="reception-nav-link" asp-controller="Receptionist" asp-action="Appointments">
                            <i class="fa-solid fa-calendar-check me-1"></i>Toàn Bộ Lịch Hẹn
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="reception-nav-link" asp-controller="Receptionist" asp-action="CreateAppointment">
                            <i class="fa-solid fa-user-plus me-1"></i>Đặt Lịch Tại Quầy
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="reception-nav-link" asp-controller="Receptionist" asp-action="DoctorsSchedule">
                            <i class="fa-solid fa-calendar-days me-1"></i>Lịch Trực Bác Sĩ
                        </a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-3">
                    <div class="text-end text-white d-none d-md-block">
                        <div class="fw-bold fs-6">@User.Identity?.Name</div>
                        <small class="text-warning">Nhân viên Lễ tân</small>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-2 fw-semibold bg-white text-danger">
                            <i class="fa-solid fa-right-from-bracket me-1"></i>Đăng Xuất
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </nav>

    <!-- Global Alerts -->
    <div class="container-fluid px-4 mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="fa-solid fa-circle-check fs-4 me-3 text-success"></i>
                <div class="flex-grow-1">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="fa-solid fa-triangle-exclamation fs-4 me-3 text-danger"></i>
                <div class="flex-grow-1">@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <main class="container-fluid px-4 py-3 flex-grow-1">
        @RenderBody()
    </main>

    <footer>
        <div class="container-fluid px-4 text-center">
            <span>&copy; 2026 Bàn Tiếp Đón Lễ Tân - Phòng Khám Healthy System. Tiếp nhận bệnh nhân & điều phối ca khám.</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
