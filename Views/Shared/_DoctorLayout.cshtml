<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cổng Bác Sĩ | Healthy System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --doctor-primary: #0369a1;
            --doctor-secondary: #0284c7;
            --doctor-dark: #0f172a;
            --doctor-bg: #f0fdf4;
            --doctor-card-border: #e2e8f0;
        }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f1f5f9;
            color: #1e293b;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .doctor-navbar {
            background: #0f172a;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            padding: 12px 0;
        }
        .doctor-brand {
            color: #ffffff !important;
            font-weight: 800;
            font-size: 1.35rem;
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }
        .doctor-brand-badge {
            background-color: #0284c7;
            color: white;
            font-size: 0.75rem;
            padding: 4px 10px;
            border-radius: 9999px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .doctor-nav-link {
            color: #cbd5e1 !important;
            font-weight: 600;
            padding: 8px 16px !important;
            border-radius: 8px;
            transition: all 0.2s;
            text-decoration: none;
        }
        .doctor-nav-link:hover, .doctor-nav-link.active {
            color: #ffffff !important;
            background-color: rgba(255,255,255,0.1);
        }
        .card-doctor {
            background: #ffffff;
            border: 1px solid var(--doctor-card-border);
            border-radius: 14px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.03);
            transition: all 0.2s;
        }
        .card-doctor:hover {
            box-shadow: 0 8px 20px rgba(0,0,0,0.06);
        }
        footer {
            margin-top: auto;
            background: #0f172a;
            color: #94a3b8;
            padding: 20px 0;
            font-size: 0.85rem;
        }
    </style>
</head>
<body>
    <!-- Doctor Top Header -->
    <nav class="navbar navbar-expand-lg doctor-navbar sticky-top">
        <div class="container-fluid px-4">
            <a class="doctor-brand" asp-controller="Doctor" asp-action="Dashboard">
                <i class="fa-solid fa-user-doctor text-info fs-3"></i>
                <span>HEALTHY<span class="text-info">SYSTEM</span></span>
                <span class="doctor-brand-badge ms-2"><i class="fa-solid fa-stethoscope me-1"></i>BÁC SĨ KHÁM</span>
            </a>
            <button class="navbar-toggler text-white" type="button" data-bs-toggle="collapse" data-bs-target="#doctorNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="doctorNav">
                <ul class="navbar-nav me-auto ms-4 mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="doctor-nav-link" asp-controller="Doctor" asp-action="Dashboard">
                            <i class="fa-solid fa-gauge-high me-1"></i>Tổng Quan Ca Khám
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="doctor-nav-link" asp-controller="Doctor" asp-action="Queue">
                            <i class="fa-solid fa-list-ol me-1"></i>Hàng Đợi Khám Hôm Nay
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="doctor-nav-link" asp-controller="Doctor" asp-action="Schedule">
                            <i class="fa-solid fa-calendar-week me-1"></i>Lịch Trực / Ca Khám
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="doctor-nav-link" asp-controller="Doctor" asp-action="MedicalRecords">
                            <i class="fa-solid fa-folder-medical me-1"></i>Hồ Sơ & Đơn Thuốc
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="doctor-nav-link" asp-controller="Doctor" asp-action="Profile">
                            <i class="fa-solid fa-hospital-user me-1"></i>Hồ Sơ Chuyên Môn
                        </a>
                    </li>
                </ul>

                <!-- Doctor Right Profile -->
                <div class="d-flex align-items-center gap-3">
                    <div class="text-end text-white d-none d-md-block">
                        <div class="fw-bold fs-6">@User.Identity?.Name</div>
                        <small class="text-info">Bác sĩ chuyên khoa</small>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-2 fw-semibold">
                            <i class="fa-solid fa-right-from-bracket me-1"></i>Đăng Xuất
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </nav>

    <!-- Global Alerts -->
    <div class="container-fluid px-4 mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="fa-solid fa-circle-check fs-4 me-3 text-success"></i>
                <div class="flex-grow-1">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="fa-solid fa-triangle-exclamation fs-4 me-3 text-danger"></i>
                <div class="flex-grow-1">@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <!-- Main Doctor Content -->
    <main class="container-fluid px-4 py-3 flex-grow-1">
        @RenderBody()
    </main>

    <footer>
        <div class="container-fluid px-4 text-center">
            <span>&copy; 2026 Cổng Thông Tin Bác Sĩ - Phòng Khám Healthy System. Phân hệ phục vụ Bác Sĩ & Điều trị.</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
