@{
    ViewData["Title"] = "Chưa Thiết Lập Hồ Sơ Bác Sĩ";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 text-center">
            <div class="card border-0 rounded-4 shadow-sm p-4 p-md-5">
                <div class="mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-warning-subtle text-warning rounded-circle" style="width: 80px; height: 80px;">
                        <i class="fa-solid fa-user-doctor fs-1"></i>
                    </div>
                </div>
                <h4 class="fw-bold text-dark mb-2">Tài Khoản Chưa Hoàn Tất Cấu Hình Bác Sĩ</h4>
                <p class="text-muted small mb-4">
                    Tài khoản của bạn được cấp quyền vai trò <strong>Bác Sĩ</strong>, nhưng chưa được liên kết với thông tin Chuyên khoa và Phòng khám cụ thể trong cơ sở dữ liệu.
                </p>
                <div class="alert alert-info rounded-3 text-start small mb-4">
                    <i class="fa-solid fa-circle-info me-2"></i>
                    <strong>Hướng dẫn giải quyết:</strong> Vui lòng liên hệ với Quản Trị Viên (Admin) để được cấu hình hồ sơ bác sĩ tại mục <em>"Quản lý Bác sĩ & Tiếp nhận nhân sự"</em>.
                </div>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="fa-solid fa-house me-1"></i>Về Trang Chủ
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold">
                            <i class="fa-solid fa-right-from-bracket me-1"></i>Đăng Xuất
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
