            </div>

            <!-- 2. Thông Tin Bệnh Nhân -->
            <div class="mb-4">
                <div class="record-section-title">
                    <i class="fa-solid fa-address-card"></i>
                    <span>I. THÔNG TIN HÀNH CHÍNH BỆNH NHÂN</span>
