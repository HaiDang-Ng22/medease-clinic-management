@section Scripts {
    <script src="~/js/html2pdf.bundle.min.js"></script>
    <script>
        function downloadDoctorPdf() {
            const btn = document.getElementById('btnDoctorDownloadPdf');
            const originalContent = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i><span>Đang tạo PDF...</span>';

            const element = document.getElementById('printableRecord');
            const code = '@Model.AppointmentCode';
            
            const opt = {
                margin:       [8, 10, 8, 10],
                filename:     'Ho_So_Benh_An_' + code + '.pdf',
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { 
                    scale: 2, 
                    useCORS: true, 
                    letterRendering: true,
                    logging: false
                },
                jsPDF: { 
                    unit: 'mm', 
                    format: 'a4', 
                    orientation: 'portrait' 
                }
            };

            html2pdf().set(opt).from(element).save().then(() => {
                btn.disabled = false;
                btn.innerHTML = originalContent;
            }).catch(err => {
                console.error('Lỗi khi xuất PDF:', err);
                btn.disabled = false;
                btn.innerHTML = originalContent;
                alert('Có lỗi xảy ra khi tạo file PDF. Bạn có thể sử dụng nút "In Đơn & Bệnh Án" và chọn "Lưu dưới dạng PDF" (Save as PDF).');
            });
        }
    </script>
}
