                    <div class="text-muted small">Địa chỉ: 280 An Dương Vương, P.4, Q.5, TP.HCM | Hotline: <strong>1900 8888</strong></div>
                </div>
                <div class="col-sm-5 text-sm-end mt-3 mt-sm-0">
                    <div class="text-uppercase fw-bold text-primary mb-1" style="font-size:0.875rem; letter-spacing:0.04em;">Cổng Thông Tin Bác Sĩ</div>
                    <h4 class="fw-bold text-dark mb-1">PHIẾU KHÁM & ĐƠN THUỐC</h4>
                    <div class="mt-2">
                        <span class="badge px-3 py-2 fs-6 fw-bold border record-header-code" style="background:#f0f9ff; color:#0284c7; border-color:#bae6fd !important;">
                            @Model.AppointmentCode
                        </span>
                    </div>
                    <div class="text-muted small mt-1">Ngày xuất: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
