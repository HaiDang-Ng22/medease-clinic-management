@model Appointment
@{
    Layout = "_DoctorLayout";
    ViewData["Title"] = "Hồ Sơ Bệnh Án & Đơn Thuốc - " + Model.AppointmentCode;
    var labResult = ViewBag.LabResult as Healthy_System.Models.LabResult;
}

<style>
    /* CSS In ấn chuẩn A4 */
    @@media print {
        @@page {
            size: A4 portrait;
            margin: 10mm 12mm 12mm 12mm;
        }
        body {
            background: #ffffff !important;
            font-size: 11pt !important;
            color: #0f172a !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
        .doctor-sidebar, .doctor-topbar, .doctor-navbar, footer, .no-print, .alert, .btn-print-hide {
            display: none !important;
        }
        .doctor-content-wrapper {
            margin-left: 0 !important;
            padding: 0 !important;
        }
        .container-fluid {
            padding: 0 !important;
            margin: 0 !important;
        }
        .record-card {
            border: 1px solid #cbd5e1 !important;
            box-shadow: none !important;
            padding: 24px !important;
            margin: 0 !important;
            border-radius: 0 !important;
        }
    }

    .record-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.08);
    }
    .record-header-code {
        font-family: 'SFMono-Regular', Consolas, monospace;
        letter-spacing: 0.05em;
    }
    .record-section-title {
        font-size: 0.8125rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #0284c7;
        border-bottom: 2px solid #e0f2fe;
        padding-bottom: 6px;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .prescription-box {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-left: 4px solid #0284c7;
        font-family: 'SFMono-Regular', Consolas, monospace;
        font-size: 0.95rem;
        line-height: 1.7;
        white-space: pre-wrap;
        color: #0f172a;
    }
    .seal-badge {
        display: inline-block;
        border: 2px dashed #0284c7;
        color: #0284c7;
        padding: 8px 16px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 0.8125rem;
        text-align: center;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        background: #f0f9ff;
    }
</style>

<!-- Thanh tác vụ Bác sĩ (ẩn khi in) -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 no-print">
    <div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-success px-2 py-1">US11 Hoàn thành</span>
            <h3 class="fw-bold mb-0 text-dark">Hồ Sơ Khám Bệnh & Đơn Thuốc</h3>
        </div>
        <p class="text-muted mb-0 small">Mã tra cứu: <strong class="text-primary font-monospace">@Model.AppointmentCode</strong> | Trạng thái: <span class="badge bg-success-subtle text-success">Hoàn tất buổi khám</span></p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <!-- Nút Tải file PDF -->
        <button type="button" id="btnDoctorDownloadPdf" onclick="downloadDoctorPdf()" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm d-inline-flex align-items-center gap-2">
            <i class="fa-solid fa-file-pdf"></i>
            <span>Tải File PDF</span>
        </button>
        <!-- Nút In trực tiếp -->
        <button type="button" onclick="window.print()" class="btn btn-primary rounded-pill px-4 fw-semibold d-inline-flex align-items-center gap-2">
            <i class="fa-solid fa-print"></i>
            <span>In Đơn & Bệnh Án</span>
        </button>
        <a asp-action="MedicalRecords" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="fa-solid fa-list me-1"></i>Danh Sách Bệnh Án
        </a>
        <a asp-action="Examination" asp-route-id="@Model.Id" class="btn btn-outline-primary rounded-pill px-3">
            <i class="fa-solid fa-pen-to-square me-1"></i>Sửa Ca Khám
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-xl-11 col-xxl-10">

        <!-- VÙNG NỘI DUNG HỒ SƠ BỆNH ÁN & ĐƠN THUỐC DÙNG ĐỂ IN VÀ XUẤT PDF -->
