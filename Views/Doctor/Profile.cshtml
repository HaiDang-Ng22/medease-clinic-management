@model Healthy_System.Models.ViewModels.DoctorProfileViewModel
@{
    ViewData["Title"] = "Cập nhật hồ sơ cá nhân & chuyên môn";
    Layout = "_Layout";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-user-md me-2"></i>Cập nhật thông tin cá nhân & chuyên môn
                    </h5>
                </div>
                <div class="card-body p-4">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Profile" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <!-- Thông tin cá nhân -->
                        <h6 class="text-primary fw-bold mb-3"><i class="fas fa-id-card me-2"></i>1. Thông tin cá nhân</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label fw-semibold"></label>
                                <input asp-for="FullName" class="form-class form-control" placeholder="Nhập họ và tên bác sĩ" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold"></label>
                                <input asp-for="Email" class="form-control bg-light" readonly />
                                <small class="text-muted">Email đăng nhập không thể thay đổi</small>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="Nhập số điện thoại liên hệ" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="AvatarUrl" class="form-label fw-semibold"></label>
                                <input asp-for="AvatarUrl" class="form-control" placeholder="Dán đường dẫn ảnh URL (https://...)" />
                                <span asp-validation-for="AvatarUrl" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- Thông tin chuyên môn -->
                        <h6 class="text-primary fw-bold mb-3"><i class="fas fa-stethoscope me-2"></i>2. Thông tin chuyên môn</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Title" class="form-label fw-semibold"></label>
                                <input asp-for="Title" class="form-control" placeholder="VD: Thạc sĩ, Bác sĩ CKI..." />
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="SpecialtyId" class="form-label fw-semibold"></label>
                                <select asp-for="SpecialtyId" class="form-select">
                                    <option value="">-- Chọn chuyên khoa --</option>
                                    @if (Model.Specialties != null)
                                    {
                                        foreach (var spec in Model.Specialties)
                                        {
                                            <option value="@spec.Id">@spec.Name</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="SpecialtyId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ExperienceYears" class="form-label fw-semibold"></label>
                                <input asp-for="ExperienceYears" type="number" class="form-control" min="0" />
                                <span asp-validation-for="ExperienceYears" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="RoomNumber" class="form-label fw-semibold"></label>
                                <input asp-for="RoomNumber" class="form-control" placeholder="VD: P.102" />
                                <span asp-validation-for="RoomNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ConsultationFee" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <input asp-for="ConsultationFee" type="number" step="10000" class="form-control" />
                                    <span class="input-group-text">VNĐ</span>
                                </div>
                                <span asp-validation-for="ConsultationFee" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Bio" class="form-label fw-semibold"></label>
                                <textarea asp-for="Bio" class="form-control" rows="4" placeholder="Mô tả quá trình đào tạo, kinh nghiệm công tác, thành tựu..."></textarea>
                                <span asp-validation-for="Bio" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Dashboard" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="fas fa-save me-1"></i> Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>