@model List<Appointment>
@{
    Layout = "_DoctorLayout";
    ViewData["Title"] = "Hàng Đợi Khám Hôm Nay";
    var doctor = ViewBag.Doctor as Doctor;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="fa-solid fa-list-ol text-primary me-2"></i>Hàng Đợi Bệnh Nhân Khám Trong Ngày</h2>
        <p class="text-muted mb-0">Hôm nay: <strong>@DateTime.Today.ToString("dddd, dd/MM/yyyy")</strong> | Bác sĩ: <strong>@doctor?.Title @doctor?.User?.FullName</strong></p>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="fa-solid fa-arrow-left me-1"></i>Về Tổng Quan
    </a>
</div>

<div class="card card-doctor p-4">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Giờ hẹn</th>
                        <th>Mã lịch</th>
                        <th>Họ tên Bệnh nhân</th>
                        <th>Thông tin liên hệ</th>
                        <th>Triệu chứng ban đầu</th>
                        <th>Trạng thái</th>
                        <th class="text-center pe-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appt in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold text-primary fs-6">@appt.TimeSlot</td>
                            <td><span class="badge bg-light text-dark border">@appt.AppointmentCode</span></td>
                            <td>
                                <div class="fw-bold">@appt.Patient?.FullName</div>
                                <small class="text-muted">NS: @(appt.Patient?.DateOfBirth?.ToString("dd/MM/yyyy") ?? "Chưa rõ") (@appt.Patient?.Gender)</small>
                            </td>
                            <td>
                                <div><i class="fa-solid fa-phone text-muted me-1 small"></i>@appt.Patient?.PhoneNumber</div>
                                <small class="text-muted">@appt.Patient?.Email</small>
                            </td>
                            <td>
                                <span class="text-muted small">@appt.ReasonForVisit</span>
                            </td>
                            <td>
                                @if (appt.Status == "Completed")
                                {
                                    <span class="badge bg-success-subtle text-success py-2 px-3 rounded-pill fw-bold">
                                        <i class="fa-solid fa-check me-1"></i>Đã khám xong
                                    </span>
                                }
                                else if (appt.Status == "Confirmed")
                                {
                                    <span class="badge bg-primary-subtle text-primary py-2 px-3 rounded-pill fw-bold">
                                        <i class="fa-solid fa-user-check me-1"></i>Sẵn sàng khám
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-dark py-2 px-3 rounded-pill fw-bold">
                                        <i class="fa-solid fa-clock me-1"></i>Chờ tiếp nhận
                                    </span>
                                }
                            </td>
                            <td class="text-center pe-3">
                                <div class="btn-group">
                                    <a asp-action="Examination" asp-route-id="@appt.Id" class="btn btn-primary rounded-pill btn-sm px-3 fw-bold me-1">
                                        <i class="fa-solid fa-stethoscope me-1"></i>@(appt.Status == "Completed" ? "Bệnh án" : "Vào Khám")
                                    </a>
                                    @if (appt.Status != "Completed" && appt.Status != "Cancelled")
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2 dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" title="Xử lý khẩn cấp">
                                            <i class="fa-solid fa-triangle-exclamation"></i> Khẩn
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow">
                                            <li><h6 class="dropdown-header text-danger"><i class="fa-solid fa-bolt me-1"></i>Thao Tác Khẩn Cấp (US27)</h6></li>
                                            <li>
                                                <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#cancelModal_@appt.Id">
                                                    <i class="fa-solid fa-ban me-2"></i>Hủy ca khám khẩn cấp
                                                </button>
                                            </li>
                                            <li>
                                                <button type="button" class="dropdown-item text-warning-emphasis" data-bs-toggle="modal" data-bs-target="#rescheduleModal_@appt.Id">
                                                    <i class="fa-solid fa-calendar-xmark me-2"></i>Dời lịch khám khẩn cấp
                                                </button>
                                            </li>
                                        </ul>

                                        <!-- Modal Hủy Khẩn Cấp -->
                                        <div class="modal fade text-start" id="cancelModal_@appt.Id" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <form asp-action="CancelEmergency" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="appointmentId" value="@appt.Id" />
                                                        <div class="modal-header bg-danger text-white">
                                                            <h5 class="modal-title fw-bold"><i class="fa-solid fa-triangle-exclamation me-2"></i>Hủy Ca Khám Khẩn Cấp</h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="alert alert-warning small mb-3">
                                                                Hệ thống sẽ chuyển ca khám sang trạng thái <strong>Cancelled</strong> và tự động gửi <strong>Thông báo khẩn cấp</strong> đến tài khoản của bệnh nhân <strong>@appt.Patient?.FullName</strong>.
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold">Mã lịch hẹn:</label>
                                                                <input type="text" class="form-control" value="@appt.AppointmentCode" readonly />
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold">Lý do bác sĩ hủy khẩn cấp <span class="text-danger">*</span>:</label>
                                                                <textarea name="emergencyReason" class="form-control" rows="3" required placeholder="Ví dụ: Bác sĩ có ca phẫu thuật cấp cứu đột xuất; Bác sĩ sốt cao đột ngột..."></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
                                                            <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Xác Nhận Hủy Khẩn Cấp</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Modal Dời Lịch Khẩn Cấp -->
                                        <div class="modal fade text-start" id="rescheduleModal_@appt.Id" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <form asp-action="RescheduleEmergency" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="appointmentId" value="@appt.Id" />
                                                        <div class="modal-header bg-warning text-dark">
                                                            <h5 class="modal-title fw-bold"><i class="fa-solid fa-calendar-days me-2"></i>Dời Lịch Khám Khẩn Cấp</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold">Bệnh nhân:</label>
                                                                <div>@appt.Patient?.FullName (@appt.AppointmentCode)</div>
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold">Chọn Ngày Mới <span class="text-danger">*</span>:</label>
                                                                <input type="date" name="newDate" class="form-control" required min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold">Chọn Khung Giờ Mới <span class="text-danger">*</span>:</label>
                                                                <select name="newTimeSlot" class="form-select" required>
                                                                    <option value="08:00 - 09:00">08:00 - 09:00</option>
                                                                    <option value="09:00 - 10:00">09:00 - 10:00</option>
                                                                    <option value="10:00 - 11:00">10:00 - 11:00</option>
                                                                    <option value="13:30 - 14:30">13:30 - 14:30</option>
                                                                    <option value="14:30 - 15:30">14:30 - 15:30</option>
                                                                    <option value="15:30 - 16:30">15:30 - 16:30</option>
                                                                </select>
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label fw-bold">Lý do dời lịch khẩn cấp <span class="text-danger">*</span>:</label>
                                                                <textarea name="emergencyReason" class="form-control" rows="2" required placeholder="Lý do điều chỉnh lịch khám..."></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
                                                            <button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold">Xác Nhận Dời Lịch</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fa-regular fa-clipboard text-muted display-4 mb-3"></i>
            <h4 class="text-muted">Chưa có bệnh nhân nào trong hàng đợi hôm nay</h4>
        </div>
    }
</div>
