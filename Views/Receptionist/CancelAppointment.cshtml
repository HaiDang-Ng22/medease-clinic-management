@model Healthy_System.Models.Appointment
@{
    Layout = "_ReceptionistLayout";
    ViewData["Title"] = "Hủy Lịch Hẹn";
}

<div class="row justify-content-center">
    <div class="col-lg-7">

        <div class="card card-reception mb-4">
            <div class="card-header bg-danger bg-opacity-10 py-3 px-4">
                <h4 class="fw-bold mb-0 text-danger">
                    <i class="fa-solid fa-ban me-2"></i>Hủy Lịch Hẹn Theo Yêu Cầu
                </h4>
                <p class="text-muted mb-0 small mt-1">US-17 | Hủy lịch tại quầy lễ tân</p>
            </div>
            <div class="card-body p-4">

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded">
                            <div class="small text-muted fw-semibold mb-1">Mã lịch hẹn</div>
                            <span class="badge bg-secondary fs-6">@Model.AppointmentCode</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded">
                            <div class="small text-muted fw-semibold mb-1">Trạng thái hiện tại</div>
                            @if (Model.Status == "Confirmed")
                            {
                                <span class="badge bg-success-subtle text-success fs-6 px-3 py-2">Đã xác nhận</span>
                            }
                            else if (Model.Status == "Pending")
                            {
                                <span class="badge bg-warning-subtle text-dark fs-6 px-3 py-2">Chờ xác nhận</span>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded">
                            <div class="small text-muted fw-semibold mb-1">
                                <i class="fa-solid fa-user me-1"></i>Bệnh nhân
                            </div>
                            <div class="fw-bold">@Model.Patient?.FullName</div>
                            <div class="text-muted small">@Model.Patient?.PhoneNumber</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded">
                            <div class="small text-muted fw-semibold mb-1">
                                <i class="fa-solid fa-user-doctor me-1"></i>Bác sĩ
                            </div>
                            <div class="fw-bold">@Model.Doctor?.Title @Model.Doctor?.User?.FullName</div>
                            <div class="text-muted small">@Model.Specialty?.Name</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded">
                            <div class="small text-muted fw-semibold mb-1">
                                <i class="fa-solid fa-calendar me-1"></i>Ngày khám
                            </div>
                            <div class="fw-bold">@Model.AppointmentDate.ToString("dd/MM/yyyy")</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded">
                            <div class="small text-muted fw-semibold mb-1">
                                <i class="fa-solid fa-clock me-1"></i>Giờ khám
                            </div>
                            <div class="fw-bold text-success">@Model.TimeSlot</div>
                        </div>
                    </div>
                </div>

                <div class="alert alert-warning d-flex gap-2">
                    <i class="fa-solid fa-triangle-exclamation mt-1"></i>
                    <div>
                        Thao tác này sẽ <strong>hủy vĩnh viễn</strong> lịch hẹn và thông báo đến bệnh nhân.
                        Bệnh nhân cần đặt lịch mới nếu muốn tiếp tục khám.
                    </div>
                </div>

                <form asp-action="CancelAppointment" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="mb-4">
                        <label class="form-label fw-bold">
                            Lý do hủy lịch <span class="text-muted fw-normal">(không bắt buộc)</span>
                        </label>
                        <textarea name="cancellationReason" rows="3" class="form-control"
                                  placeholder="Ví dụ: Bệnh nhân yêu cầu hủy, bác sĩ không có lịch, trùng lịch..."></textarea>
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="Appointments" class="btn btn-outline-secondary rounded-pill px-4">
                            <i class="fa-solid fa-arrow-left me-1"></i>Quay lại
                        </a>
                        <button type="submit" class="btn btn-danger rounded-pill px-5 fw-bold"
                                onclick="return confirm('Bạn có chắc muốn HỦY lịch hẹn @Model.AppointmentCode?')">
                            <i class="fa-solid fa-ban me-1"></i>Xác Nhận Hủy Lịch
                        </button>
                    </div>
                </form>

            </div>
        </div>

    </div>
</div>
