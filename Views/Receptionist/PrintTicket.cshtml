@using Healthy_System.Models
@model Appointment

@{
    Layout = null; // Không dùng sidebar - trang độc lập để in
    var bookingType = Model.AppointmentCode.StartsWith("HS-TEL") ? "Qua điện thoại" : "Trực tiếp tại quầy";
    var queueNumber  = (Model.Id % 100).ToString("D2");
    var printTime    = DateTime.Now.ToString("HH:mm dd/MM/yyyy");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Phiếu Khám - @Model.AppointmentCode</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <style>
        /* ── Screen styles ── */
        body {
            background: #f1f5f9;
            font-family: 'Segoe UI', sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 2rem 1rem;
        }
        .action-bar {
            width: 100%;
            max-width: 520px;
            display: flex;
            gap: .75rem;
            margin-bottom: 1.25rem;
        }
        .ticket-wrap {
            width: 100%;
            max-width: 520px;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 24px rgba(0,0,0,.10);
            overflow: hidden;
        }

        /* ── Ticket header ── */
        .ticket-header {
            background: linear-gradient(135deg, #0f766e 0%, #134e4a 100%);
            color: #fff;
            padding: 1.5rem 1.75rem 1.25rem;
        }
        .clinic-name  { font-size: 1.05rem; font-weight: 700; letter-spacing: .02em; }
        .ticket-title { font-size: 1.4rem; font-weight: 800; margin: .25rem 0 0; letter-spacing: -.01em; }
        .appt-code    { font-family: monospace; font-size: .85rem; opacity: .85; }

        /* ── Queue number badge ── */
        .queue-block {
            display: flex;
            justify-content: center;
            padding: 1.25rem 0 .5rem;
        }
        .queue-badge {
            width: 96px; height: 96px;
            border-radius: 50%;
            background: #f0fdfa;
            border: 3px solid #0f766e;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            box-shadow: 0 2px 12px rgba(15,118,110,.15);
        }
        .queue-num   { font-size: 2.4rem; font-weight: 900; color: #0f766e; line-height: 1; }
        .queue-label { font-size: .6rem; text-transform: uppercase; letter-spacing: .1em; color: #64748b; }

        /* ── Info rows ── */
        .ticket-body  { padding: 1rem 1.75rem 1.5rem; }
        .info-row     { display: flex; gap: 1rem; padding: .55rem 0; border-bottom: 1px solid #f1f5f9; align-items: flex-start; }
        .info-row:last-child { border-bottom: none; }
        .info-icon    { width: 28px; height: 28px; border-radius: 7px; background: #f0fdfa;
                        display: flex; align-items: center; justify-content: center;
                        color: #0f766e; font-size: .8rem; flex-shrink: 0; margin-top: .1rem; }
        .info-label   { font-size: .72rem; color: #94a3b8; text-transform: uppercase; letter-spacing: .07em; }
        .info-value   { font-size: .95rem; font-weight: 600; color: #0f172a; }
        .info-sub     { font-size: .8rem; color: #64748b; }

        /* ── Time slot pill ── */
        .time-pill {
            display: inline-block;
            background: #0f766e; color: #fff;
            border-radius: 999px; padding: .2rem .85rem;
            font-size: 1rem; font-weight: 700; letter-spacing: .02em;
        }

        /* ── Divider dashed ── */
        .dashed-cut {
            border: none; border-top: 2px dashed #e2e8f0;
            margin: 0 1.75rem;
        }

        /* ── Barcode-style code strip ── */
        .code-strip {
            background: #f8fafc;
            padding: .75rem 1.75rem;
            display: flex; justify-content: space-between; align-items: center;
        }
        .code-mono   { font-family: monospace; font-size: 1.1rem; font-weight: 700; color: #0f172a; letter-spacing: .1em; }
        .print-time  { font-size: .72rem; color: #94a3b8; }

        /* ── Footer note ── */
        .ticket-footer {
            background: #f0fdfa; border-top: 1px solid #d1fae5;
            padding: .85rem 1.75rem;
            font-size: .78rem; color: #065f46;
            display: flex; align-items: flex-start; gap: .5rem;
        }

        /* ── Print styles: ẩn nút, in trực tiếp ── */
        @@media print {
            body          { background: #fff; padding: 0; display: block; }
            .action-bar   { display: none !important; }
            .ticket-wrap  { box-shadow: none; border-radius: 0; max-width: 100%; }
        }
    </style>
</head>
<body>

    <!-- Action bar (chỉ hiện trên màn hình) -->
    <div class="action-bar">
        <button onclick="window.print()" class="btn btn-success fw-bold flex-fill">
            <i class="fa-solid fa-print me-2"></i>In Phiếu Khám
        </button>
        <a href="/Receptionist/Appointments" class="btn btn-outline-secondary">
            <i class="fa-solid fa-list me-1"></i>Danh sách
        </a>
        <a href="/Receptionist/CreateAppointment" class="btn btn-outline-primary">
            <i class="fa-solid fa-plus me-1"></i>Đặt tiếp
        </a>
    </div>

    <!-- Phiếu khám -->
    <div class="ticket-wrap">

        <!-- Header -->
        <div class="ticket-header">
            <div class="clinic-name"><i class="fa-solid fa-heart-pulse me-2"></i>MedEase – Phòng Khám Đa Khoa</div>
            <div class="ticket-title">PHIẾU KHÁM BỆNH</div>
            <div class="appt-code mt-1">Mã hẹn: @Model.AppointmentCode &nbsp;·&nbsp; @bookingType</div>
        </div>

        <!-- Số thứ tự -->
        <div class="queue-block">
            <div class="queue-badge">
                <span class="queue-num">@queueNumber</span>
                <span class="queue-label">STT</span>
            </div>
        </div>
        <div class="text-center text-muted mb-2" style="font-size:.75rem;">Số thứ tự trong ngày</div>

        <hr class="dashed-cut" />

        <!-- Thông tin chi tiết -->
        <div class="ticket-body">

            <!-- Bệnh nhân -->
            <div class="info-row">
                <div class="info-icon"><i class="fa-solid fa-user"></i></div>
                <div>
                    <div class="info-label">Họ tên bệnh nhân</div>
                    <div class="info-value">@(Model.Patient?.FullName ?? "—")</div>
                    <div class="info-sub"><i class="fa-solid fa-phone fa-xs me-1"></i>@(Model.Patient?.PhoneNumber ?? "—")</div>
                </div>
            </div>

            <!-- Ngày & Giờ -->
            <div class="info-row">
                <div class="info-icon"><i class="fa-solid fa-calendar-day"></i></div>
                <div>
                    <div class="info-label">Ngày khám</div>
                    <div class="info-value">@Model.AppointmentDate.ToString("dddd, dd/MM/yyyy")</div>
                    <div class="info-sub">
                        <span class="time-pill mt-1">@Model.TimeSlot</span>
                    </div>
                </div>
            </div>

            <!-- Chuyên khoa -->
            <div class="info-row">
                <div class="info-icon"><i class="fa-solid fa-stethoscope"></i></div>
                <div>
                    <div class="info-label">Chuyên khoa</div>
                    <div class="info-value">@(Model.Specialty?.Name ?? "—")</div>
                </div>
            </div>

            <!-- Bác sĩ & Phòng -->
            <div class="info-row">
                <div class="info-icon"><i class="fa-solid fa-user-doctor"></i></div>
                <div>
                    <div class="info-label">Bác sĩ phụ trách</div>
                    <div class="info-value">@(Model.Doctor?.Title ?? "BS.") @(Model.Doctor?.User?.FullName ?? "—")</div>
                    @if (!string.IsNullOrEmpty(Model.Doctor?.RoomNumber))
                    {
                        <div class="info-sub">
                            <i class="fa-solid fa-door-open fa-xs me-1"></i>@Model.Doctor.RoomNumber
                        </div>
                    }
                </div>
            </div>

            <!-- Lý do khám -->
            @if (!string.IsNullOrWhiteSpace(Model.ReasonForVisit))
            {
                <div class="info-row">
                    <div class="info-icon"><i class="fa-solid fa-notes-medical"></i></div>
                    <div>
                        <div class="info-label">Lý do / Triệu chứng</div>
                        <div class="info-value" style="font-weight:500;">@Model.ReasonForVisit</div>
                    </div>
                </div>
            }

        </div>

        <!-- Code strip -->
        <hr class="dashed-cut" />
        <div class="code-strip">
            <span class="code-mono">@Model.AppointmentCode</span>
            <span class="print-time">In lúc: @printTime</span>
        </div>

        <!-- Footer note -->
        <div class="ticket-footer">
            <i class="fa-solid fa-circle-info mt-1 flex-shrink-0"></i>
            <span>
                Vui lòng <strong>mang phiếu này</strong> đến đúng phòng khám và có mặt trước <strong>15 phút</strong>.
                Liên hệ quầy lễ tân nếu cần hỗ trợ.
            </span>
        </div>

    </div>

    <script>
        // Tự động mở hộp thoại in khi tải trang (có thể bỏ comment nếu muốn)
        // window.onload = function() { window.print(); };
    </script>
</body>
</html>
