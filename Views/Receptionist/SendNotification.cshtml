@model Appointment
@{
    Layout = "_ReceptionistLayout";
    ViewData["Title"] = "Gửi Thông Báo Bệnh Nhân";
}

<div class="mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
    <div>
        <h1 class="h4 fw-bold mb-1" style="color:#0f172a; letter-spacing:-0.02em;">
            <i class="fa-solid fa-bell text-warning me-2"></i>Gửi Thông Báo Đến Bệnh Nhân
        </h1>
        <p class="text-muted small mb-0">
            Lịch hẹn: <strong>@Model.AppointmentCode</strong> &nbsp;|&nbsp; Bệnh nhân: <strong>@Model.Patient?.FullName</strong>
        </p>
    </div>
    <a asp-action="Appointments" class="btn btn-sm btn-outline-secondary px-4 rounded-pill fw-semibold">
        <i class="fa-solid fa-arrow-left me-1"></i>Quay lại
    </a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 mb-4" role="alert">
        <i class="fa-solid fa-circle-xmark me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4 justify-content-center">
    <div class="col-lg-8">

        @* Thông tin bệnh nhân nhận *@
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
            <h6 class="fw-bold text-muted mb-3 text-uppercase" style="font-size:0.75rem;letter-spacing:0.08em;">
                <i class="fa-solid fa-user me-1"></i>Thông Tin Người Nhận
            </h6>
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-teal-100 text-teal d-flex align-items-center justify-content-center fw-bold fs-4"
                     style="width:56px;height:56px;flex-shrink:0;background:#ccfbf1;color:#0f766e;">
                    @(Model.Patient?.FullName?.Length > 0 ? Model.Patient.FullName[0].ToString().ToUpper() : "?")
                </div>
                <div class="flex-grow-1">
                    <h5 class="fw-bold mb-1">@Model.Patient?.FullName</h5>
                    <div class="small text-muted">
                        <i class="fa-solid fa-phone me-1"></i>@Model.Patient?.PhoneNumber &nbsp;&nbsp;
                        <i class="fa-solid fa-envelope me-1"></i>@Model.Patient?.Email
                    </div>
                </div>
                <div class="text-end">
                    <span class="badge rounded-pill" style="background:#0f766e;">@Model.AppointmentDate.ToString("dd/MM/yyyy")</span>
                    <div class="small text-muted mt-1">@Model.TimeSlot</div>
                </div>
            </div>
        </div>

        @* Form gửi thông báo *@
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
            <h4 class="fw-bold mb-4">
                <i class="fa-solid fa-paper-plane me-2" style="color:#0f766e;"></i>Soạn Thông Báo
            </h4>

            <form asp-action="SendNotification" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="appointmentId" value="@Model.Id" />

                @* Loại thông báo *@
                <div class="mb-4">
                    <label class="form-label fw-bold">1. Loại Thông Báo <span class="text-danger">*</span></label>
                    <div class="row g-2">
                        <div class="col-md-4">
                            <input type="radio" class="btn-check" name="notificationType" id="type_reminder" value="Reminder" checked />
                            <label class="btn btn-outline-primary w-100 rounded-3 py-3" for="type_reminder">
                                <i class="fa-solid fa-clock d-block fs-4 mb-1"></i>
                                <div class="fw-bold">Nhắc lịch hẹn</div>
                                <small class="text-muted">Nhắc nhở ngày giờ khám</small>
                            </label>
                        </div>
                        <div class="col-md-4">
                            <input type="radio" class="btn-check" name="notificationType" id="type_general" value="General" />
                            <label class="btn btn-outline-secondary w-100 rounded-3 py-3" for="type_general">
                                <i class="fa-solid fa-bullhorn d-block fs-4 mb-1"></i>
                                <div class="fw-bold">Thông báo chung</div>
                                <small class="text-muted">Thông tin phòng khám</small>
                            </label>
                        </div>
                        <div class="col-md-4">
                            <input type="radio" class="btn-check" name="notificationType" id="type_alert" value="EmergencyAlert" />
                            <label class="btn btn-outline-danger w-100 rounded-3 py-3" for="type_alert">
                                <i class="fa-solid fa-triangle-exclamation d-block fs-4 mb-1"></i>
                                <div class="fw-bold">Khẩn cấp</div>
                                <small class="text-muted">Thay đổi quan trọng</small>
                            </label>
                        </div>
                    </div>
                </div>

                @* Tiêu đề *@
                <div class="mb-4">
                    <label class="form-label fw-bold">2. Tiêu Đề Thông Báo</label>
                    <input type="text" name="notificationTitle" class="form-control rounded-3"
                           placeholder="Để trống sẽ dùng tiêu đề mặc định: 'Thông báo từ Lễ tân'" maxlength="150" />
                    <div class="form-text">Tối đa 150 ký tự.</div>
                </div>

                @* Nội dung *@
                <div class="mb-4">
                    <label class="form-label fw-bold">3. Nội Dung Thông Báo <span class="text-danger">*</span></label>

                    @* Mẫu nhanh *@
                    <div class="mb-2">
                        <div class="small text-muted mb-1">Mẫu thông báo nhanh:</div>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill quick-msg"
                                    data-msg="Bệnh nhân vui lòng đến đúng giờ hẹn @Model.TimeSlot ngày @Model.AppointmentDate.ToString("dd/MM/yyyy"). Vui lòng mang theo CCCD và sổ khám bệnh.">
                                <i class="fa-solid fa-clock me-1"></i>Nhắc đến đúng giờ
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill quick-msg"
                                    data-msg="Lịch hẹn của bạn đã được xác nhận vào lúc @Model.TimeSlot ngày @Model.AppointmentDate.ToString("dd/MM/yyyy"). Phòng khám Healthy System kính chào!">
                                <i class="fa-solid fa-circle-check me-1"></i>Xác nhận lịch
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill quick-msg"
                                    data-msg="Phòng khám thông báo: lịch hẹn của bạn đã có thay đổi về giờ hoặc bác sĩ phụ trách. Vui lòng kiểm tra lại thông tin lịch hẹn trên hệ thống.">
                                <i class="fa-solid fa-arrows-rotate me-1"></i>Thay đổi lịch
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill quick-msg"
                                    data-msg="Bệnh nhân vui lòng mang theo kết quả xét nghiệm, đơn thuốc cũ và CCCD khi đến khám. Xin cảm ơn!">
                                <i class="fa-solid fa-folder-open me-1"></i>Mang hồ sơ
                            </button>
                        </div>
                    </div>

                    <textarea name="notificationMessage" id="notificationMessage" rows="5"
                              class="form-control rounded-3" required
                              placeholder="Nhập nội dung thông báo..."></textarea>
                    <div class="d-flex justify-content-between mt-1">
                        <div class="form-text">Tối đa 500 ký tự.</div>
                        <div class="form-text"><span id="charCount">0</span>/500</div>
                    </div>
                </div>

                <div class="alert rounded-4 small mb-4" style="background:#f0fdf4; border:1px solid #bbf7d0; color:#166534;">
                    <i class="fa-solid fa-circle-info me-2"></i>
                    Thông báo sẽ được gửi ngay đến tài khoản bệnh nhân <strong>@Model.Patient?.FullName</strong>
                    và hiển thị trong mục <strong>Thông Báo</strong> của họ.
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a asp-action="Appointments" class="btn btn-outline-secondary rounded-pill px-4">Hủy bỏ</a>
                    <button type="submit" class="btn btn-lg rounded-pill px-5 fw-bold shadow-sm"
                            style="background:#0f766e; color:#fff;">
                        <i class="fa-solid fa-paper-plane me-2"></i>GỬI THÔNG BÁO
                    </button>
                </div>
            </form>
        </div>

    </div>
</div>

@section Scripts {
<script>
    document.querySelectorAll('.quick-msg').forEach(function(btn) {
        btn.addEventListener('click', function() {
            document.getElementById('notificationMessage').value = this.getAttribute('data-msg');
            updateCharCount();
        });
    });
    var msgArea = document.getElementById('notificationMessage');
    function updateCharCount() {
        document.getElementById('charCount').textContent = msgArea.value.length;
    }
    msgArea.addEventListener('input', updateCharCount);
</script>
}
