@{
    Layout = "_ReceptionistLayout";
    ViewData["Title"] = "Đặt Lịch Khám Tại Quầy / Qua Điện Thoại";
    var specialties = ViewBag.Specialties as List<Specialty> ?? new List<Specialty>();
    var doctors = ViewBag.Doctors as List<Doctor> ?? new List<Doctor>();
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-reception p-4 p-md-5">
            <h3 class="fw-bold mb-4 pb-3 border-bottom text-success">
                <i class="fa-solid fa-user-plus me-2"></i>Tiếp Nhận Bệnh Nhân &amp; Đặt Lịch
            </h3>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form asp-action="CreateAppointment" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3">

                    @* US-15: Booking type selection *@
                    <div class="col-12">
                        <label class="form-label fw-bold">Hình thức tiếp nhận <span class="text-danger">*</span></label>
                        <div class="d-flex gap-3">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="bookingType" id="walkIn" value="WalkIn" checked />
                                <label class="form-check-label fw-semibold" for="walkIn">
                                    <i class="fa-solid fa-person-walking me-1 text-success"></i>Trực tiếp tại quầy
                                </label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="bookingType" id="phone" value="Phone" />
                                <label class="form-check-label fw-semibold" for="phone">
                                    <i class="fa-solid fa-phone me-1 text-primary"></i>Qua điện thoại
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Họ và tên bệnh nhân <span class="text-danger">*</span></label>
                        <input type="text" name="patientName" class="form-control" required placeholder="Nguyễn Văn A" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Số điện thoại liên hệ <span class="text-danger">*</span></label>
                        <input type="text" name="phone" class="form-control" required placeholder="0901234567"
                               pattern="[0-9]{9,11}" title="Số điện thoại gồm 9–11 chữ số" />
                        <div class="form-text text-muted">Nếu đã có tài khoản, thông tin sẽ được tìm theo SĐT.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Chuyên khoa khám <span class="text-danger">*</span></label>
                        <select name="specialtyId" class="form-select" required>
                            <option value="">-- Chọn chuyên khoa --</option>
                            @foreach (var s in specialties)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Bác sĩ khám <span class="text-danger">*</span></label>
                        <select name="doctorId" class="form-select" required>
                            <option value="">-- Chọn bác sĩ --</option>
                            @foreach (var d in doctors)
                            {
                                <option value="@d.Id">@d.Title @d.User?.FullName (@d.RoomNumber)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Ngày khám <span class="text-danger">*</span></label>
                        <input type="date" name="appointmentDate" class="form-control"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Khung giờ khám <span class="text-danger">*</span></label>
                        <select name="timeSlot" class="form-select" required>
                            <option value="08:00 - 08:30">08:00 - 08:30</option>
                            <option value="08:30 - 09:00">08:30 - 09:00</option>
                            <option value="09:00 - 09:30">09:00 - 09:30</option>
                            <option value="09:30 - 10:00">09:30 - 10:00</option>
                            <option value="10:00 - 10:30">10:00 - 10:30</option>
                            <option value="13:30 - 14:00">13:30 - 14:00</option>
                            <option value="14:00 - 14:30">14:00 - 14:30</option>
                            <option value="14:30 - 15:00">14:30 - 15:00</option>
                            <option value="15:00 - 15:30">15:00 - 15:30</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold">Lý do khám / Triệu chứng</label>
                        <textarea name="reason" rows="2" class="form-control"
                                  placeholder="Mô tả triệu chứng bệnh nhân khai báo..."></textarea>
                    </div>
                    <div class="col-12 mt-4 text-end">
                        <a asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill px-4 me-2">Hủy</a>
                        <button type="submit" class="btn btn-success rounded-pill px-5 fw-bold">
                            <i class="fa-solid fa-calendar-check me-1"></i>Xác Nhận Đặt Lịch
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
