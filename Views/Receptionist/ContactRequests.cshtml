@using Healthy_System.Models
@model List<ContactMessage>
@{
    Layout = "_ReceptionistLayout";
    ViewData["Title"] = "Yêu Cầu Liên Hệ & Tư Vấn";
    var selectedStatus = (ViewBag.SelectedStatus as string) ?? "all";
    var searchTerm = ViewBag.SearchTerm as string ?? "";
    int totalCount = ViewBag.TotalCount ?? 0;
    int pendingCount = ViewBag.PendingCount ?? 0;
    int resolvedCount = ViewBag.ResolvedCount ?? 0;
}

<div class="mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
    <div>
        <h1 class="h4 fw-bold text-slate-900 mb-1" style="color:#0f172a; letter-spacing:-0.02em;">
            <i class="fa-solid fa-headset me-2" style="color:#0f766e;"></i>Yêu Cầu Liên Hệ &amp; Tư Vấn Trực Tuyến
        </h1>
        <p class="text-muted small mb-0">Tiếp nhận thông tin thắc mắc, yêu cầu tư vấn y tế hoặc hỗ trợ đặt hẹn từ cổng liên hệ người dùng</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="ContactRequests" class="btn btn-sm btn-outline-secondary px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2 bg-white">
            <i class="fa-solid fa-rotate"></i>
            <span>Làm Mới</span>
        </a>
        <a asp-action="CreateAppointment" class="btn btn-sm btn-primary px-3 py-2 fw-semibold d-inline-flex align-items-center gap-2" style="background:#0f766e; border-color:#0f766e;">
            <i class="fa-solid fa-user-plus"></i>
            <span>Đặt Lịch Tại Quầy</span>
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-2 border-0 shadow-sm mb-4" role="alert" style="background-color:#ecfdf5; color:#065f46; border-left:4px solid #10b981 !important;">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Authentic Metrics Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <a asp-action="ContactRequests" asp-route-status="all" asp-route-search="@searchTerm" class="text-decoration-none d-block">
            <div class="bg-white p-3 rounded-2 transition-all @(selectedStatus == "all" ? "border-primary" : "")" style="border:1px solid @(selectedStatus == "all" ? "#0f766e" : "#e2e8f0"); box-shadow: @(selectedStatus == "all" ? "0 0 0 1px #0f766e" : "none");">
                <div class="text-muted small mb-1" style="font-size:0.75rem; text-transform:uppercase; letter-spacing:0.04em;">Toàn bộ tin nhắn</div>
                <div class="d-flex align-items-baseline gap-2">
                    <span class="fs-3 fw-bold" style="color:#0f172a; font-variant-numeric:tabular-nums;">@totalCount</span>
                    <span class="small text-muted">yêu cầu</span>
                </div>
                <div class="small text-muted mt-1" style="font-size:0.75rem;">Tổng lượt khách gửi liên hệ</div>
            </div>
        </a>
    </div>

    <div class="col-12 col-md-4">
        <a asp-action="ContactRequests" asp-route-status="pending" asp-route-search="@searchTerm" class="text-decoration-none d-block">
            <div class="bg-white p-3 rounded-2 transition-all @(selectedStatus == "pending" ? "border-warning" : "")" style="border:1px solid @(selectedStatus == "pending" ? "#d97706" : "#e2e8f0"); box-shadow: @(selectedStatus == "pending" ? "0 0 0 1px #d97706" : "none");">
                <div class="text-muted small mb-1" style="font-size:0.75rem; text-transform:uppercase; letter-spacing:0.04em;">Chờ liên hệ &amp; tư vấn</div>
                <div class="d-flex align-items-baseline gap-2">
                    <span class="fs-3 fw-bold" style="color:#d97706; font-variant-numeric:tabular-nums;">@pendingCount</span>
                    <span class="small text-muted">yêu cầu</span>
                </div>
                <div class="small text-warning mt-1" style="font-size:0.75rem;">Cần gọi lại hoặc phản hồi email</div>
            </div>
        </a>
    </div>

    <div class="col-12 col-md-4">
        <a asp-action="ContactRequests" asp-route-status="resolved" asp-route-search="@searchTerm" class="text-decoration-none d-block">
            <div class="bg-white p-3 rounded-2 transition-all @(selectedStatus == "resolved" ? "border-success" : "")" style="border:1px solid @(selectedStatus == "resolved" ? "#0f766e" : "#e2e8f0"); box-shadow: @(selectedStatus == "resolved" ? "0 0 0 1px #0f766e" : "none");">
                <div class="text-muted small mb-1" style="font-size:0.75rem; text-transform:uppercase; letter-spacing:0.04em;">Đã hỗ trợ xong</div>
                <div class="d-flex align-items-baseline gap-2">
                    <span class="fs-3 fw-bold" style="color:#0f766e; font-variant-numeric:tabular-nums;">@resolvedCount</span>
                    <span class="small text-muted">yêu cầu</span>
                </div>
                <div class="small text-muted mt-1" style="font-size:0.75rem;">Đã liên hệ tư vấn hoàn tất</div>
            </div>
        </a>
    </div>
</div>

<!-- Main Table Card -->
<div class="bg-white rounded-2" style="border:1px solid #e2e8f0;">
    <!-- Filter and Search Header -->
    <div class="p-3 border-bottom d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3" style="border-color:#e2e8f0 !important;">
        <!-- Status Tabs -->
        <div class="d-flex align-items-center gap-2">
            <a asp-action="ContactRequests" asp-route-status="all" asp-route-search="@searchTerm" 
               class="btn btn-sm @(selectedStatus == "all" ? "btn-dark" : "btn-outline-secondary") rounded-pill px-3 fw-semibold">
                Tất Cả (@totalCount)
            </a>
            <a asp-action="ContactRequests" asp-route-status="pending" asp-route-search="@searchTerm" 
               class="btn btn-sm @(selectedStatus == "pending" ? "btn-warning text-dark fw-bold" : "btn-outline-secondary") rounded-pill px-3">
                <i class="fa-solid fa-clock-rotate-left me-1"></i>Chờ Phản Hồi (@pendingCount)
            </a>
            <a asp-action="ContactRequests" asp-route-status="resolved" asp-route-search="@searchTerm" 
               class="btn btn-sm @(selectedStatus == "resolved" ? "btn-success" : "btn-outline-secondary") rounded-pill px-3 fw-semibold">
                <i class="fa-solid fa-circle-check me-1"></i>Đã Xử Lý (@resolvedCount)
            </a>
        </div>

        <!-- Search Form -->
        <form asp-action="ContactRequests" method="get" class="d-flex align-items-center gap-2 w-100 w-md-auto" style="max-width:380px;">
            <input type="hidden" name="status" value="@selectedStatus" />
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white border-end-0 text-muted" style="border-color:#e2e8f0;">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </span>
                <input type="text" name="search" value="@searchTerm" class="form-control border-start-0 ps-0" 
                       placeholder="Tìm theo tên, SĐT, email..." style="border-color:#e2e8f0; font-size:0.8125rem;">
                @if (!string.IsNullOrWhiteSpace(searchTerm))
                {
                    <a asp-action="ContactRequests" asp-route-status="@selectedStatus" class="btn btn-outline-secondary border-start-0 bg-white" title="Xóa tìm kiếm">
                        <i class="fa-solid fa-xmark"></i>
                    </a>
                }
                <button type="submit" class="btn btn-secondary btn-sm px-3">Tìm</button>
            </div>
        </form>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size:0.875rem;">
                <thead>
                    <tr style="background:#f8fafc; border-bottom:1px solid #e2e8f0; color:#64748b; font-size:0.75rem; text-transform:uppercase; letter-spacing:0.04em;">
                        <th style="width: 140px; padding: 12px 16px;">Thời Gian</th>
                        <th style="width: 220px; padding: 12px 16px;">Người Gửi</th>
                        <th style="padding: 12px 16px;">Chủ Đề &amp; Nội Dung Yêu Cầu</th>
                        <th style="width: 130px; padding: 12px 16px; text-align:center;">Trạng Thái</th>
                        <th style="width: 200px; padding: 12px 16px; text-align:right;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var isToday = item.CreatedAt.Date == DateTime.UtcNow.Date;
                        <tr style="border-bottom:1px solid #f1f5f9; @(!item.IsResolved ? "background-color: #fffdf8;" : "")">
                            <!-- Time -->
                            <td class="p-3">
                                <div class="fw-semibold text-slate-800" style="font-size:0.8125rem; color:#1e293b;">
                                    @item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                                </div>
                                <div class="small text-muted" style="font-size:0.75rem;">
                                    <i class="fa-regular fa-clock me-1"></i>@item.CreatedAt.ToLocalTime().ToString("HH:mm")
                                    @if (isToday)
                                    {
                                        <span class="badge text-bg-warning text-dark ms-1" style="font-size:0.65rem;">Hôm nay</span>
                                    }
                                </div>
                            </td>

                            <!-- Patient Info -->
                            <td class="p-3">
                                <div class="fw-bold text-slate-900 mb-1" style="color:#0f172a;">@item.FullName</div>
                                @if (!string.IsNullOrWhiteSpace(item.Phone))
                                {
                                    <div class="small mb-1">
                                        <a href="tel:@item.Phone" class="text-decoration-none fw-semibold text-primary d-inline-flex align-items-center gap-1">
                                            <i class="fa-solid fa-phone text-muted"></i>
                                            <span>@item.Phone</span>
                                        </a>
                                    </div>
                                }
                                <div class="small text-muted text-truncate" style="max-width:200px;" title="@item.Email">
                                    <a href="mailto:@item.Email" class="text-muted text-decoration-none d-inline-flex align-items-center gap-1">
                                        <i class="fa-regular fa-envelope"></i>
                                        <span>@item.Email</span>
                                    </a>
                                </div>
                            </td>

                            <!-- Subject & Message -->
                            <td class="p-3">
                                <div class="fw-semibold text-slate-800 mb-1" style="color:#0f172a;">
                                    @item.Subject
                                </div>
                                <div class="text-muted small text-break" style="display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; font-size:0.8125rem;">
                                    @item.Message
                                </div>
                                <button type="button" class="btn btn-link p-0 text-decoration-none small mt-1" style="font-size:0.75rem; color:#0f766e;" data-bs-toggle="modal" data-bs-target="#detailModal-@item.Id">
                                    <i class="fa-solid fa-eye me-1"></i>Xem toàn bộ nội dung
                                </button>
                            </td>

                            <!-- Status -->
                            <td class="p-3 text-center">
                                @if (item.IsResolved)
                                {
                                    <span class="badge rounded-pill px-3 py-2 fw-semibold" style="background:#ecfdf5; color:#065f46; border:1px solid #a7f3d0; font-size:0.75rem;">
                                        <i class="fa-solid fa-circle-check me-1"></i>Đã xử lý
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill px-3 py-2 fw-semibold" style="background:#fffbeb; color:#92400e; border:1px solid #fde68a; font-size:0.75rem;">
                                        <i class="fa-solid fa-clock me-1"></i>Chờ liên hệ
                                    </span>
                                }
                            </td>

                            <!-- Actions -->
                            <td class="p-3 text-end">
                                <div class="d-inline-flex align-items-center gap-1">
                                    @if (!item.IsResolved)
                                    {
                                        <!-- Quick Call / Contact Form Toggle -->
                                        <form asp-action="ResolveContact" method="post" class="d-inline m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="returnStatus" value="@selectedStatus" />
                                            <input type="hidden" name="returnSearch" value="@searchTerm" />
                                            <button type="submit" class="btn btn-sm btn-outline-success px-2 py-1" title="Đánh dấu đã liên hệ xong" data-bs-toggle="tooltip">
                                                <i class="fa-solid fa-check"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="UnresolveContact" method="post" class="d-inline m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="returnStatus" value="@selectedStatus" />
                                            <input type="hidden" name="returnSearch" value="@searchTerm" />
                                            <button type="submit" class="btn btn-sm btn-outline-warning text-dark px-2 py-1" title="Đánh dấu chưa xử lý" data-bs-toggle="tooltip">
                                                <i class="fa-solid fa-rotate-left"></i>
                                            </button>
                                        </form>
                                    }

                                    <!-- Quick Book Appointment for this patient -->
                                    <a asp-action="CreateAppointment" asp-route-patientName="@item.FullName" asp-route-phone="@item.Phone" 
                                       class="btn btn-sm btn-outline-primary px-2 py-1" title="Đặt lịch hẹn cho khách này" data-bs-toggle="tooltip">
                                        <i class="fa-solid fa-calendar-plus"></i>
                                    </a>

                                    <!-- Delete Button -->
                                    <button type="button" class="btn btn-sm btn-outline-danger px-2 py-1" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Id" title="Xóa yêu cầu">
                                        <i class="fa-regular fa-trash-can"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>

                        <!-- Modal Detail -->
                        <div class="modal fade" id="detailModal-@item.Id" tabindex="-1" aria-labelledby="modalLabel-@item.Id" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered modal-lg">
                                <div class="modal-content rounded-3 border-0 shadow">
                                    <div class="modal-header border-bottom py-3" style="background:#f8fafc;">
                                        <h5 class="modal-title fw-bold text-slate-900" id="modalLabel-@item.Id" style="font-size:1rem;">
                                            <i class="fa-solid fa-headset me-2 text-primary"></i>Chi Tiết Yêu Cầu Liên Hệ &amp; Tư Vấn #@item.Id
                                        </h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body p-4">
                                        <div class="row g-3 mb-3">
                                            <div class="col-md-6">
                                                <div class="text-muted small">Người gửi:</div>
                                                <div class="fw-bold fs-6 text-slate-900">@item.FullName</div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="text-muted small">Thời gian gửi:</div>
                                                <div class="fw-semibold text-slate-800">@item.CreatedAt.ToLocalTime().ToString("HH:mm - dd/MM/yyyy")</div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="text-muted small">Số điện thoại liên hệ:</div>
                                                <div class="fw-semibold">
                                                    @if (!string.IsNullOrWhiteSpace(item.Phone))
                                                    {
                                                        <a href="tel:@item.Phone" class="btn btn-sm btn-outline-primary mt-1">
                                                            <i class="fa-solid fa-phone me-1"></i>Gọi ngay: @item.Phone
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">Chưa cung cấp</span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="text-muted small">Hòm thư điện tử:</div>
                                                <div class="fw-semibold">
                                                    <a href="mailto:@item.Email?subject=Phản hồi thắc mắc: @item.Subject" class="btn btn-sm btn-outline-secondary mt-1">
                                                        <i class="fa-regular fa-envelope me-1"></i>Gửi email: @item.Email
                                                    </a>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="border-top pt-3 mt-3">
                                            <div class="text-muted small mb-1">Chủ đề tư vấn:</div>
                                            <div class="p-2 rounded bg-light fw-bold text-slate-900 mb-3">@item.Subject</div>

                                            <div class="text-muted small mb-1">Nội dung câu hỏi / triệu chứng:</div>
                                            <div class="p-3 rounded bg-white border text-slate-800" style="white-space:pre-wrap; line-height:1.6; font-size:0.9rem;">@item.Message</div>
                                        </div>
                                    </div>
                                    <div class="modal-footer border-top py-3 d-flex justify-content-between" style="background:#f8fafc;">
                                        <div>
                                            <span class="small text-muted me-2">Trạng thái:</span>
                                            @if (item.IsResolved)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">Đã xử lý</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2 rounded-pill">Chờ liên hệ</span>
                                            }
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <a asp-action="CreateAppointment" asp-route-patientName="@item.FullName" asp-route-phone="@item.Phone" 
                                               class="btn btn-sm btn-primary" style="background:#0f766e; border-color:#0f766e;">
                                                <i class="fa-solid fa-calendar-plus me-1"></i>Tạo Lịch Khám Cho Bệnh Nhân
                                            </a>
                                            @if (!item.IsResolved)
                                            {
                                                <form asp-action="ResolveContact" method="post" class="d-inline m-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="returnStatus" value="@selectedStatus" />
                                                    <input type="hidden" name="returnSearch" value="@searchTerm" />
                                                    <button type="submit" class="btn btn-sm btn-success">
                                                        <i class="fa-solid fa-check me-1"></i>Đánh Dấu Đã Xử Lý
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="UnresolveContact" method="post" class="d-inline m-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="returnStatus" value="@selectedStatus" />
                                                    <input type="hidden" name="returnSearch" value="@searchTerm" />
                                                    <button type="submit" class="btn btn-sm btn-warning text-dark">
                                                        <i class="fa-solid fa-rotate-left me-1"></i>Chuyển Về Chưa Xử Lý
                                                    </button>
                                                </form>
                                            }
                                            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Đóng</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Modal Delete Confirm -->
                        <div class="modal fade" id="deleteModal-@item.Id" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered modal-sm">
                                <div class="modal-content rounded-3 border-0 shadow">
                                    <div class="modal-header border-bottom py-2">
                                        <h6 class="modal-title fw-bold text-danger">
                                            <i class="fa-solid fa-triangle-exclamation me-1"></i>Xác Nhận Xóa
                                        </h6>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body p-3">
                                        <p class="small text-muted mb-0">Bạn có chắc chắn muốn xóa yêu cầu liên hệ từ <strong>@item.FullName</strong> không? Thao tác này không thể hoàn tác.</p>
                                    </div>
                                    <div class="modal-footer border-top py-2">
                                        <form asp-action="DeleteContact" method="post" class="d-inline m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="returnStatus" value="@selectedStatus" />
                                            <input type="hidden" name="returnSearch" value="@searchTerm" />
                                            <button type="submit" class="btn btn-sm btn-danger px-3">Xóa</button>
                                        </form>
                                        <button type="button" class="btn btn-sm btn-light border" data-bs-dismiss="modal">Hủy</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light mb-3" style="width:64px; height:64px;">
                <i class="fa-solid fa-inbox text-muted fs-3"></i>
            </div>
            <h6 class="fw-bold text-slate-800 mb-1">Không có yêu cầu liên hệ nào</h6>
            <p class="text-muted small mb-3">
                @if (!string.IsNullOrWhiteSpace(searchTerm))
                {
                    <span>Không tìm thấy yêu cầu phù hợp với từ khóa "<strong>@searchTerm</strong>".</span>
                }
                else if (selectedStatus == "pending")
                {
                    <span>Hiện tại không có yêu cầu liên hệ nào đang chờ xử lý. Tuyệt vời!</span>
                }
                else
                {
                    <span>Hiện chưa có khách hàng nào gửi thông tin yêu cầu tư vấn.</span>
                }
            </p>
            @if (!string.IsNullOrWhiteSpace(searchTerm) || selectedStatus != "all")
            {
                <a asp-action="ContactRequests" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Xem tất cả</a>
            }
        </div>
    }
</div>
