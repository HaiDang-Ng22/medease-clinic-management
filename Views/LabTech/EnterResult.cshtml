@model Appointment
@{
    ViewData["Title"] = "Nhập Kết Quả Xét Nghiệm";
    Layout = "_LabTechLayout";
    var existing = ViewBag.ExistingResult as LabResult;
    var existingExt = existing?.ImageFileType?.ToLower();
    bool existingIsImage = existingExt == "jpg" || existingExt == "jpeg" || existingExt == "png";
}

<div class="row g-4">
    <!-- Thông tin bệnh nhân & phiếu yêu cầu -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-primary text-white fw-bold">
                <i class="fa-solid fa-user me-2"></i>Thông tin bệnh nhân
            </div>
            <div class="card-body">
                <div class="mb-2">
                    <small class="text-muted">Họ tên</small>
                    <div class="fw-bold">@Model.Patient?.FullName</div>
                </div>
                <div class="mb-2">
                    <small class="text-muted">SĐT</small>
                    <div>@Model.Patient?.PhoneNumber</div>
                </div>
                <div class="mb-2">
                    <small class="text-muted">Mã lịch hẹn</small>
                    <div><span class="badge bg-primary">@Model.AppointmentCode</span></div>
                </div>
                <div class="mb-2">
                    <small class="text-muted">Ngày khám</small>
                    <div>@Model.AppointmentDate.ToString("dd/MM/yyyy") – @Model.TimeSlot</div>
                </div>
                <div class="mb-2">
                    <small class="text-muted">Bác sĩ yêu cầu</small>
                    <div>@Model.Doctor?.Title @Model.Doctor?.User?.FullName</div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-warning text-dark fw-bold">
                <i class="fa-solid fa-clipboard-list me-2"></i>Yêu cầu xét nghiệm
            </div>
            <div class="card-body">
                <p class="small mb-0" style="white-space:pre-line">@Model.LabRequest</p>
            </div>
        </div>

        @if (existing?.ImageFilePath != null)
        {
            <div class="card border-0 shadow-sm mt-3">
                <div class="card-header bg-info text-white fw-bold">
                    <i class="fa-solid fa-image me-2"></i>File đính kèm hiện tại
                </div>
                <div class="card-body text-center">
                    @if (existingIsImage)
                    {
                        <a href="@existing.ImageFilePath" target="_blank">
                            <img src="@existing.ImageFilePath" class="img-fluid rounded shadow-sm" style="max-height:220px; object-fit:contain;" />
                        </a>
                        <div class="small text-muted mt-1">@existing.ImageFileName</div>
                    }
                    else
                    {
                        <i class="fa-solid fa-file-pdf text-danger fa-3x mb-2"></i>
                        <div class="small">@existing.ImageFileName</div>
                    }
                    <div class="mt-2">
                        <a href="@existing.ImageFilePath" target="_blank" class="btn btn-sm btn-outline-primary">
                            <i class="fa-solid fa-external-link me-1"></i>Mở file
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Form nhập kết quả (US29) + upload file (US30) -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-success text-white fw-bold">
                <i class="fa-solid fa-flask-vial me-2"></i>
                @(existing != null ? "Cập nhật kết quả xét nghiệm" : "Nhập kết quả xét nghiệm")
            </div>
            <div class="card-body">
                <form asp-action="SaveResult" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="appointmentId" value="@Model.Id" />

                    <!-- US29: Kết quả tóm tắt -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            Kết quả tóm tắt <span class="text-danger">*</span>
                        </label>
                        <textarea name="resultSummary" rows="3" class="form-control"
                                  placeholder="VD: Tất cả chỉ số trong giới hạn bình thường. Không phát hiện bất thường."
                                  required>@(existing?.ResultSummary)</textarea>
                    </div>

                    <!-- US29: Kết quả chi tiết từng chỉ số -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Kết quả chi tiết từng chỉ số</label>
                        <textarea name="detailedResult" rows="6" class="form-control font-monospace"
                                  placeholder="VD:&#10;Hồng cầu (RBC): 4.8 T/L [BT: 4.2-5.4]&#10;Bạch cầu (WBC): 7.2 G/L [BT: 4.0-10.0]&#10;Hemoglobin: 138 g/L [BT: 120-160]&#10;Tiểu cầu: 285 G/L [BT: 150-400]">@(existing?.DetailedResult)</textarea>
                    </div>

                    <!-- US30: Upload file hình ảnh - Modern UI với preview -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            <i class="fa-solid fa-camera me-1 text-info"></i>
                            Đính kèm hình ảnh / file kết quả
                        </label>

                        <!-- Drop zone -->
                        <div id="uploadZone" class="border border-2 border-dashed rounded-3 p-4 text-center position-relative"
                             style="border-color: #dee2e6 !important; cursor: pointer; transition: all .2s; min-height: 140px; background: #f8f9fa;">
                            <input type="file" name="imageFile" id="imageFileInput"
                                   accept=".jpg,.jpeg,.png,.pdf,.dcm"
                                   class="position-absolute w-100 h-100 top-0 start-0 opacity-0"
                                   style="cursor: pointer; z-index: 2;" />

                            <!-- Placeholder (trước khi chọn) -->
                            <div id="uploadPlaceholder">
                                <i class="fa-solid fa-cloud-arrow-up fa-2x text-muted mb-2"></i>
                                <div class="fw-semibold text-muted">Kéo thả file vào đây hoặc <span class="text-primary">click để chọn</span></div>
                                <div class="small text-muted mt-1">JPG, PNG, PDF, DICOM — tối đa 10MB</div>
                            </div>

                            <!-- Preview ảnh (ẩn ban đầu) -->
                            <div id="imagePreviewWrap" class="d-none flex-column align-items-center gap-2">
                                <img id="imagePreview" src="#" alt="Preview" class="rounded shadow-sm"
                                     style="max-height: 180px; max-width: 100%; object-fit: contain;" />
                                <div id="previewFileName" class="small text-muted"></div>
                                <button type="button" id="clearFileBtn" class="btn btn-sm btn-outline-danger">
                                    <i class="fa-solid fa-xmark me-1"></i>Xóa file
                                </button>
                            </div>

                            <!-- Preview file không phải ảnh (ẩn ban đầu) -->
                            <div id="filePreviewWrap" class="d-none flex-column align-items-center gap-2">
                                <i class="fa-solid fa-file-pdf text-danger fa-3x"></i>
                                <div id="filePreviewName" class="small fw-semibold text-dark"></div>
                                <div id="filePreviewSize" class="small text-muted"></div>
                                <button type="button" id="clearFileBtn2" class="btn btn-sm btn-outline-danger">
                                    <i class="fa-solid fa-xmark me-1"></i>Xóa file
                                </button>
                            </div>
                        </div>
                        <div class="form-text">Chấp nhận: JPG, PNG (ảnh X-quang, siêu âm), PDF (báo cáo), DICOM (.dcm). Tối đa 10MB.</div>
                    </div>

                    <!-- Ghi chú KTV -->
                    <div class="mb-4">
                        <label class="form-label fw-bold">Ghi chú của kỹ thuật viên</label>
                        <textarea name="labTechNotes" rows="2" class="form-control"
                                  placeholder="Ghi chú thêm nếu cần (VD: Mẫu XN đạt tiêu chuẩn, thực hiện bởi KTV...)">@(existing?.LabTechNotes)</textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success px-4">
                            <i class="fa-solid fa-floppy-disk me-2"></i>
                            @(existing != null ? "Cập nhật kết quả" : "Lưu kết quả")
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="fa-solid fa-arrow-left me-1"></i>Quay lại
                        </a>
                    </div>
                </form>
            </div>
        </div>

        @if (existing != null)
        {
            <div class="card border-0 shadow-sm mt-3 border-success">
                <div class="card-body">
                    <div class="small text-muted">
                        <i class="fa-solid fa-circle-check text-success me-1"></i>
                        Đã nhập bởi KTV: <strong>@existing.LabTech?.FullName</strong>
                        lúc @existing.ResultDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        @if (existing.UpdatedAt.HasValue)
                        {
                            <span> – Cập nhật lần cuối: @existing.UpdatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
(function () {
    const input = document.getElementById('imageFileInput');
    const zone  = document.getElementById('uploadZone');
    const placeholder   = document.getElementById('uploadPlaceholder');
    const imgWrap       = document.getElementById('imagePreviewWrap');
    const imgEl         = document.getElementById('imagePreview');
    const imgName       = document.getElementById('previewFileName');
    const fileWrap      = document.getElementById('filePreviewWrap');
    const fileName      = document.getElementById('filePreviewName');
    const fileSize      = document.getElementById('filePreviewSize');
    const clearBtn      = document.getElementById('clearFileBtn');
    const clearBtn2     = document.getElementById('clearFileBtn2');

    function formatBytes(b) {
        if (b < 1024) return b + ' B';
        if (b < 1024*1024) return (b/1024).toFixed(1) + ' KB';
        return (b/1024/1024).toFixed(2) + ' MB';
    }

    function resetUI() {
        placeholder.classList.remove('d-none');
        imgWrap.classList.add('d-none');
        imgWrap.classList.remove('d-flex');
        fileWrap.classList.add('d-none');
        fileWrap.classList.remove('d-flex');
        zone.style.borderColor = '#dee2e6';
        input.value = '';
    }

    function handleFile(file) {
        if (!file) return;
        const ext = file.name.split('.').pop().toLowerCase();
        const isImage = ['jpg','jpeg','png'].includes(ext);

        placeholder.classList.add('d-none');
        zone.style.borderColor = '#0d6efd';

        if (isImage) {
            const reader = new FileReader();
            reader.onload = e => {
                imgEl.src = e.target.result;
                imgName.textContent = file.name + ' (' + formatBytes(file.size) + ')';
                imgWrap.classList.remove('d-none');
                imgWrap.classList.add('d-flex');
                fileWrap.classList.add('d-none');
                fileWrap.classList.remove('d-flex');
            };
            reader.readAsDataURL(file);
        } else {
            fileName.textContent = file.name;
            fileSize.textContent = formatBytes(file.size);
            fileWrap.classList.remove('d-none');
            fileWrap.classList.add('d-flex');
            imgWrap.classList.add('d-none');
            imgWrap.classList.remove('d-flex');
        }
    }

    input.addEventListener('change', () => handleFile(input.files[0]));
    clearBtn.addEventListener('click', resetUI);
    clearBtn2.addEventListener('click', resetUI);

    // Drag & drop
    zone.addEventListener('dragover', e => {
        e.preventDefault();
        zone.style.borderColor = '#0d6efd';
        zone.style.background  = '#e9f0ff';
    });
    zone.addEventListener('dragleave', () => {
        zone.style.background = '#f8f9fa';
        if (!input.files?.length) zone.style.borderColor = '#dee2e6';
    });
    zone.addEventListener('drop', e => {
        e.preventDefault();
        zone.style.background = '#f8f9fa';
        const file = e.dataTransfer.files[0];
        if (file) {
            // Gán file vào input (DataTransfer)
            const dt = new DataTransfer();
            dt.items.add(file);
            input.files = dt.files;
            handleFile(file);
        }
    });
})();
</script>
}
