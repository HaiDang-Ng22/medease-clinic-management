@model List<Appointment>
@{
    ViewData["Title"] = "Danh Sách Phiếu Yêu Cầu XN";
    Layout = "_LabTechLayout";
    var enteredIds = ViewBag.EnteredIds as List<int> ?? new List<int>();
    string? search = ViewBag.Search;
    string? filter = ViewBag.Filter;
    int totalPending = ViewBag.TotalPending ?? 0;
    int totalDone    = ViewBag.TotalDone ?? 0;
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="fw-bold mb-1 text-dark">Phiếu Yêu Cầu Xét Nghiệm</h5>
        <p class="text-muted small mb-0">Tổng @Model.Count phiếu — @totalPending chờ xử lý, @totalDone đã hoàn thành</p>
    </div>
</div>

<!-- Stat mini -->
<div class="row g-3 mb-4">
    <div class="col-4">
        <div class="card border-0 shadow-sm text-center p-3" style="border-radius:.85rem;">
            <div class="fw-bold fs-4 text-primary">@Model.Count</div>
            <div class="text-muted small">Tổng phiếu</div>
        </div>
    </div>
    <div class="col-4">
        <div class="card border-0 shadow-sm text-center p-3" style="border-radius:.85rem;border-left:4px solid #f59e0b!important;">
            <div class="fw-bold fs-4 text-warning">@totalPending</div>
            <div class="text-muted small">Chưa có KQ</div>
        </div>
    </div>
    <div class="col-4">
        <div class="card border-0 shadow-sm text-center p-3" style="border-radius:.85rem;border-left:4px solid #22c55e!important;">
            <div class="fw-bold fs-4 text-success">@totalDone</div>
            <div class="text-muted small">Đã nhập KQ</div>
        </div>
    </div>
</div>

<!-- Filter + Search -->
<div class="card border-0 shadow-sm mb-4" style="border-radius:.85rem;">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label small fw-semibold text-muted mb-1">Tìm bệnh nhân / mã lịch hẹn</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="fa-solid fa-magnifying-glass text-muted" style="font-size:.8rem;"></i>
                    </span>
                    <input type="text" name="search" value="@search"
                           class="form-control border-start-0 bg-light"
                           placeholder="Nhập tên BN hoặc mã lịch..." />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Trạng thái</label>
                <select name="filter" class="form-select bg-light">
                    <option value="" selected="@(string.IsNullOrEmpty(filter))">Tất cả</option>
                    <option value="pending" selected="@(filter == "pending")">Chưa có kết quả</option>
                    <option value="done" selected="@(filter == "done")">Đã nhập kết quả</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100" style="border-radius:.5rem;">
                    <i class="fa-solid fa-filter me-1"></i>Lọc
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Danh sách phiếu -->
@if (Model.Any())
{
    <div class="d-flex flex-column gap-3">
        @foreach (var appt in Model)
        {
            bool isDone = enteredIds.Contains(appt.Id);
            <div class="card border-0 shadow-sm" style="border-radius:.85rem;border-left:4px solid @(isDone ? "#22c55e" : "#f59e0b")!important;">
                <div class="card-body p-4">
                    <div class="row align-items-center g-3">
                        <!-- Icon trạng thái -->
                        <div class="col-auto">
                            <div class="rounded-3 d-flex align-items-center justify-content-center"
                                 style="width:48px;height:48px;background:@(isDone ? "#f0fdf4" : "#fffbeb");">
                                <i class="fa-solid @(isDone ? "fa-circle-check text-success" : "fa-clock text-warning") fa-lg"></i>
                            </div>
                        </div>

                        <!-- Thông tin BN -->
                        <div class="col-md-3">
                            <div class="fw-bold text-dark">@appt.Patient?.FullName</div>
                            <div class="text-muted small">
                                <span class="badge px-2 py-1 me-1"
                                      style="background:#eff6ff;color:#2563eb;font-size:.72rem;border-radius:.4rem;">
                                    @appt.AppointmentCode
                                </span>
                                @appt.Patient?.PhoneNumber
                            </div>
                            <div class="text-muted small mt-1">
                                <i class="fa-solid fa-user-doctor me-1" style="font-size:.75rem;"></i>
                                @appt.Doctor?.Title @appt.Doctor?.User?.FullName
                            </div>
                        </div>

                        <!-- Nội dung YC -->
                        <div class="col-md-4">
                            <div class="small fw-semibold text-muted mb-1">
                                <i class="fa-solid fa-clipboard-list me-1"></i>Yêu cầu xét nghiệm:
                            </div>
                            <div class="p-2 rounded-2 text-dark small"
                                 style="background:#f8fafc;border:1px solid #e2e8f0;max-height:56px;overflow:hidden;">
                                @appt.LabRequest
                            </div>
                        </div>

                        <!-- Ngày + Trạng thái -->
                        <div class="col-md-2">
                            <div class="small text-muted mb-1">
                                <i class="fa-regular fa-calendar me-1"></i>@appt.AppointmentDate.ToString("dd/MM/yyyy")
                            </div>
                            <div class="small text-muted">
                                <i class="fa-regular fa-clock me-1"></i>@appt.TimeSlot
                            </div>
                            <div class="mt-2">
                                @if (isDone)
                                {
                                    <span class="badge px-2 py-1"
                                          style="background:#f0fdf4;color:#16a34a;border:1px solid #bbf7d0;border-radius:2rem;font-size:.72rem;">
                                        <i class="fa-solid fa-check me-1"></i>Đã nhập
                                    </span>
                                }
                                else
                                {
                                    <span class="badge px-2 py-1"
                                          style="background:#fffbeb;color:#d97706;border:1px solid #fde68a;border-radius:2rem;font-size:.72rem;">
                                        <i class="fa-solid fa-hourglass me-1"></i>Chờ xử lý
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Thao tác -->
                        <div class="col-md-2 d-flex flex-column gap-2">
                            <a asp-action="LabRequestDetail" asp-route-id="@appt.Id"
                               class="btn btn-sm w-100"
                               style="background:#eff6ff;color:#2563eb;border:1px solid #bfdbfe;border-radius:.5rem;font-size:.8rem;">
                                <i class="fa-solid fa-eye me-1"></i>Chi tiết
                            </a>
                            @if (isDone)
                            {
                                <a asp-action="EnterResult" asp-route-id="@appt.Id"
                                   class="btn btn-sm w-100"
                                   style="background:#f8fafc;color:#475569;border:1px solid #e2e8f0;border-radius:.5rem;font-size:.8rem;">
                                    <i class="fa-solid fa-pen me-1"></i>Sửa kết quả
                                </a>
                            }
                            else
                            {
                                <a asp-action="EnterResult" asp-route-id="@appt.Id"
                                   class="btn btn-sm w-100 btn-primary"
                                   style="border-radius:.5rem;font-size:.8rem;">
                                    <i class="fa-solid fa-flask-vial me-1"></i>Nhập kết quả
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 shadow-sm text-center py-5" style="border-radius:1rem;">
        <i class="fa-solid fa-flask fa-3x text-muted mb-3 opacity-25"></i>
        <h6 class="text-muted">Không có phiếu yêu cầu xét nghiệm nào</h6>
        <p class="text-muted small">Khi bác sĩ lập phiếu yêu cầu, chúng sẽ hiển thị tại đây.</p>
    </div>
}
