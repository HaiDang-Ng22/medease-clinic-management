@model List<Healthy_System.Models.ViewModels.PayrollConfigViewModel>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Cấu Hình Mức Lương Nhân Sự";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold"><i class="fa-solid fa-sliders text-primary me-2"></i>Cấu Hình Mức Lương & Hoa Hồng</h3>
            <p class="text-muted mb-0">Thiết lập lương cơ bản, phụ cấp ca trực và % hoa hồng khám cho từng vị trí.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="fa-solid fa-arrow-left me-1"></i>Quay lại bảng lương
        </a>
    </div>

    <form asp-action="SaveConfig" method="post">
        @Html.AntiForgeryToken()
        <div class="card card-custom p-4 shadow-sm mb-4">
            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Nhân sự</th>
                            <th>Vai trò</th>
                            <th style="width:220px;">Lương cơ bản (VNĐ)</th>
                            <th style="width:200px;">Phụ cấp ca trực (VNĐ)</th>
                            <th style="width:180px;">% Hoa hồng/ca khám</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            <tr>
                                <td>
                                    <input type="hidden" name="models[@i].UserId" value="@Model[i].UserId" />
                                    <strong class="text-dark">@Model[i].FullName</strong>
                                </td>
                                <td><span class="badge bg-light text-dark border">@Model[i].Role</span></td>
                                <td>
                                    <input type="number" name="models[@i].BaseSalary" value="@Model[i].BaseSalary" class="form-control font-monospace" step="100000" />
                                </td>
                                <td>
                                    <input type="number" name="models[@i].ShiftAllowance" value="@Model[i].ShiftAllowance" class="form-control font-monospace" step="10000" />
                                </td>
                                <td>
                                    <input type="number" name="models[@i].CommissionRate" value="@Model[i].CommissionRate" class="form-control font-monospace" step="0.5" min="0" max="100" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="text-end mt-3">
                <button type="submit" class="btn btn-success rounded-pill px-5 fw-bold shadow">
                    <i class="fa-solid fa-floppy-disk me-1"></i>LƯU CẤU HÌNH
                </button>
            </div>
        </div>
    </form>
</div>