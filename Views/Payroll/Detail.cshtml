@model Healthy_System.Models.ViewModels.PayrollDetailViewModel
@{
    ViewData["Title"] = $"Phiếu Lương Tháng {Model.Month}/{Model.Year} - {Model.FullName}";
}

<style>
    @@media print {
        .no-print {
            display: none !important;
        }

        body {
            background: #fff !important;
        }
    }
</style>

<div class="container py-3 no-print text-end">
    <button onclick="window.print()" class="btn btn-success rounded-pill px-4 fw-bold">
        <i class="fa-solid fa-print me-2"></i>In Phiếu Lương
    </button>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 ms-2">Quay lại</a>
</div>

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card p-5 border shadow-sm">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                    <div>
                        <h4 class="fw-bold text-primary mb-1">PHÒNG KHÁM ĐA KHOA MEDEASE</h4>
                        <small class="text-muted">280 An Dương Vương, P.4, Q.5, TP.HCM</small>
                    </div>
                    <div class="text-end">
                        <h5 class="fw-bold text-dark mb-0">PHIẾU LƯƠNG NHÂN SỰ</h5>
                        <small class="text-muted">Tháng @Model.Month / @Model.Year</small>
                    </div>
                </div>

                <div class="row mb-4 p-3 bg-light rounded border small">
                    <div class="col-6"><strong>Họ và tên:</strong> @Model.FullName</div>
                    <div class="col-6"><strong>Chức vụ / Vai trò:</strong> @Model.Role</div>
                    <div class="col-6 mt-1"><strong>Email:</strong> @Model.Email</div>
                    <div class="col-6 mt-1"><strong>Số ca khám trong tháng:</strong> @Model.TotalExams ca</div>
                </div>

                <table class="table table-bordered mb-4">
                    <thead class="table-light">
                        <tr>
                            <th>Các khoản mục tính lương</th>
                            <th class="text-end">Số tiền (VNĐ)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1. Lương cứng (Lương cơ bản)</td>
                            <td class="text-end">@Model.BaseSalary.ToString("N0")</td>
                        </tr>
                        <tr>
                            <td>2. Lương hiệu suất (% Hoa hồng ca khám)</td>
                            <td class="text-end text-primary">+@Model.PerformanceSalary.ToString("N0")</td>
                        </tr>
                        <tr>
                            <td>3. Phụ cấp ca trực (@Model.TotalShifts ca trực)</td>
                            <td class="text-end text-info">+@Model.Allowance.ToString("N0")</td>
                        </tr>
                        <tr>
                            <td>4. Các khoản khấu trừ (BHYT/Thuế)</td>
                            <td class="text-end text-danger">-@Model.Deductions.ToString("N0")</td>
                        </tr>
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th class="fs-6">TỔNG LƯƠNG THỰC NHẬN:</th>
                            <th class="text-end fs-5 text-success">@Model.NetSalary.ToString("N0") VNĐ</th>
                        </tr>
                    </tfoot>
                </table>

                <div class="row pt-4 text-center">
                    <div class="col-6">
                        <small class="text-muted">NGƯỜI LẬP BẢNG LƯƠNG</small>
                        <div style="height:50px;"></div>
                        <div class="fw-semibold">Bộ phận Kế toán</div>
                    </div>
                    <div class="col-6">
                        <small class="text-muted">NHÂN VIÊN XÁC NHẬN</small>
                        <div style="height:50px;"></div>
                        <div class="fw-semibold">@Model.FullName</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>